				Name = "Chunk",
				Size = Vector3.new(
					size * (0.6 + math.random() * 0.5),
					size * (0.5 + math.random() * 0.5),
					size * (0.6 + math.random() * 0.5)
				),
				CFrame = CFrame.new(
					x + math.random(-10, 10) / 10,
					CONFIG.Origin.Y + size / 2,
					z + math.random(-10, 10) / 10
				) * CFrame.Angles(math.random(), math.random(), math.random()),
				Color = rockColors[math.random(1, #rockColors)],
				Material = Enum.Material.Rock,
				Parent = rockCluster,
			})

			-- rounds the boxy chunk into a boulder-ish blob instead of a
			-- sharp-edged crate
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Sphere
			mesh.Parent = chunk
		end
	end
end

-- ============================================================
-- LIGHTING FIX
-- ============================================================
-- If your place's Lighting.Ambient/Brightness are too low, every non-Neon
-- part renders almost pure black. This brings it up to a normal daylight
-- forest look. If you already have your own lighting/atmosphere set up,
-- set CONFIG.SetupLighting = false to skip this entirely.

local function setupLighting()
	local Lighting = game:GetService("Lighting")

	-- Each property is set individually inside its own pcall: some Lighting
	-- properties (like Technology) are restricted to Studio/plugin context
	-- and will error out of a normal Script. If one is blocked, we just skip
	-- it instead of letting it crash the whole build.
	pcall(function() Lighting.Ambient = Color3.fromRGB(100, 100, 98) end)
	pcall(function() Lighting.OutdoorAmbient = Color3.fromRGB(140, 140, 132) end)
	pcall(function() Lighting.Brightness = 2 end)
	pcall(function() Lighting.ClockTime = 14.5 end)
	pcall(function() Lighting.GlobalShadows = true end)

	pcall(function()
		local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
		if not atmosphere then
			atmosphere = Instance.new("Atmosphere")
			atmosphere.Parent = Lighting
		end
		-- Kept light and close to neutral on purpose. A dense, saturated
		-- Haze/Color combo recolors everything in the scene that color, not
		-- just distant objects.
		atmosphere.Density = 0.15
		atmosphere.Haze = 0.3
		atmosphere.Color = Color3.fromRGB(200, 205, 195)
		atmosphere.Decay = Color3.fromRGB(150, 155, 145)
	end)
end

-- ============================================================
-- SPAWN LOCATION
-- ============================================================

local function buildSpawnLocation(topY)
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "ForestSpawn"
	spawn.Shape = Enum.PartType.Cylinder
