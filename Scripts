	if newState == Enum.HumanoidStateType.Landed then
		-- Reset completely when feet touch the ground
		hasDoubleJumped = false
		canDoubleJump = false
	elseif newState == Enum.HumanoidStateType.Jumping then
		-- Player jumped off the ground
		timeAtFirstJump = os.clock()
		canDoubleJump = true
	elseif newState == Enum.HumanoidStateType.Freefall then
		-- Player walked off a cliff without jumping first
		if not canDoubleJump and not hasDoubleJumped then
			timeAtFirstJump = os.clock()
			canDoubleJump = true
		end
	end
end)
