-- ============================================================
-- ENTRANCE STEPS
-- ============================================================

local function buildSteps(tierTopHeight)
	local stepsFolder = Instance.new("Folder")
	stepsFolder.Name = "Steps"
	stepsFolder.Parent = root

	local stepCount = CONFIG.StepCount
	local stepHeight = tierTopHeight / stepCount
	local stepDepth = 2
	local dir = CONFIG.StepDirection.Unit
	local up = Vector3.new(0, 1, 0)

	local right = up:Cross(dir)
	if right.Magnitude < 1e-4 then
		right = Vector3.new(1, 0, 0)
	else
		right = right.Unit
	end

	for i = 1, stepCount do
		local stepY = CONFIG.Origin.Y + (i - 0.5) * stepHeight
		local distance = CONFIG.PlatformRadius + (stepCount - i) * stepDepth
		local width = 8 + (stepCount - i) * 1.2

		local pos = CONFIG.Origin + dir * distance
		local cf = CFrame.fromMatrix(Vector3.new(pos.X, stepY, pos.Z), right, up)

		newPart({
			Name = "Step_" .. i,
			Size = Vector3.new(width, stepHeight, stepDepth),
			CFrame = cf,
			Color = (i % 2 == 0) and CONFIG.StoneColorLight or CONFIG.StoneColorDark,
			Parent = stepsFolder,
		})
	end
end

-- ============================================================
-- ENVIRONMENT DRESSING (ground, path, simple pine trees)
-- ============================================================
-- Optional (CONFIG.BuildEnvironment). The concept art shows the platform
-- sitting in an actual forest clearing — a blank grey baseplate can't get
-- you that on its own. This adds a simple, fully-removable stand-in: a
-- grass patch under/around the platform, a winding dirt path leading out
-- from the entrance, and a scatter of low-poly pine props. Everything is
-- parented under the same root Folder as the rest of the build, so
-- deleting ForestSpawnPlatform and re-running still cleans up in one go.

local function buildEnvironment()
	if not CONFIG.BuildEnvironment then
		return
	end

	local envFolder = Instance.new("Folder")
	envFolder.Name = "Environment"
	envFolder.Parent = root

	local groundThickness = 0.4
	local groundCenterY = CONFIG.Origin.Y + 0.05
	local groundTopY = groundCenterY + groundThickness / 2

	-- grass clearing, sitting just above ground level so it overlays
	-- whatever's already in the workspace (e.g. Studio's default grey
	-- Baseplate) instead of getting buried underneath it
	local groundRadius = CONFIG.PlatformRadius + CONFIG.GroundPadding
	newPart({
		Name = "GrassGround",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(groundThickness, groundRadius * 2, groundRadius * 2),
		CFrame = CFrame.new(CONFIG.Origin.X, groundCenterY, CONFIG.Origin.Z) * CFrame.Angles(0, 0, math.rad(90)),
		Material = Enum.Material.Grass,
		Color = CONFIG.GroundColor,
		Parent = envFolder,
	})

	-- dirt path leading away from the entrance steps, built from a few
	-- slightly-wobbled segments so it reads as a trail, not a sidewalk
	local dir = CONFIG.StepDirection.Unit
	local pathY = groundTopY + 0.05
	local segments = 4
	local segLength = CONFIG.PathLength / segments
	local heading = dir
	local cursor = Vector3.new(CONFIG.Origin.X, pathY, CONFIG.Origin.Z) + dir * (CONFIG.PlatformRadius + 1.5)

	for s = 1, segments do
		heading = rotateY(heading, math.rad(math.random(-10, 10)))
		local center = cursor + heading * (segLength / 2)
		local width = CONFIG.PathWidth * (1 - (s / segments) * 0.3)

		newPart({
			Name = "PathSegment_" .. s,
			Size = Vector3.new(width, 0.2, segLength * 1.15),
			CFrame = CFrame.lookAt(center, center + heading),
			Material = Enum.Material.Ground,
			Color = CONFIG.PathColor,
			CanCollide = false,
			Parent = envFolder,
		})

		cursor = cursor + heading * segLength
	end

	-- simple low-poly pine props scattered around the clearing, kept out
	-- of the entrance sightline so the path in stays open
	local pathAngle = math.atan2(dir.Z, dir.X)
	local treesFolder = Instance.new("Folder")
	treesFolder.Name = "Trees"
	treesFolder.Parent = envFolder

	local attempts = 0
	local placed = 0
	while placed < CONFIG.TreeCount and attempts < CONFIG.TreeCount * 6 do
		attempts = attempts + 1
		local treeAngle = math.random() * math.pi * 2
		local rawDelta = math.atan2(math.sin(treeAngle - pathAngle), math.cos(treeAngle - pathAngle))

		if math.abs(rawDelta) > math.rad(20) then
			local distance = CONFIG.TreeMinDistance + math.random() * (CONFIG.TreeMaxDistance - CONFIG.TreeMinDistance)
			local tx = CONFIG.Origin.X + math.cos(treeAngle) * distance
			local tz = CONFIG.Origin.Z + math.sin(treeAngle) * distance
			local trunkHeight = 3.5 + math.random() * 2
			local scale = 0.8 + math.random() * 0.6

			newPart({
				Name = "Trunk",
				Size = Vector3.new(0.8 * scale, trunkHeight, 0.8 * scale),
				CFrame = CFrame.new(tx, groundTopY + trunkHeight / 2, tz),
				Material = Enum.Material.Wood,
				Color = CONFIG.TrunkColor,
				Parent = treesFolder,
			})

			local canopySizes = { 6, 4.4, 3 }
			local layerY = groundTopY + trunkHeight * 0.55
			for layer, baseSize in ipairs(canopySizes) do
				local size = baseSize * scale
				local blob = newPart({
					Name = "Canopy_" .. layer,
					Size = Vector3.new(size, size, size),
					CFrame = CFrame.new(tx, layerY, tz),
					Material = Enum.Material.Grass,
					Color = CONFIG.CanopyColor,
					CanCollide = false,
					Parent = treesFolder,
				})
				local mesh = Instance.new("SpecialMesh")
				mesh.MeshType = Enum.MeshType.Sphere
				mesh.Scale = Vector3.new(1, 1.15, 1)
				mesh.Parent = blob

				layerY = layerY + size * 0.45
			end

			placed = placed + 1
		end
	end
end

-- ============================================================
-- PILLARS (tapered, weathered stone + inlaid glowing runes)
-- ============================================================

local function buildPillars(tiersData)
	local pillarsFolder = Instance.new("Folder")
	pillarsFolder.Name = "Pillars"
	pillarsFolder.Parent = root

	-- pillars stand on whichever tier step their ring actually lands on,
	-- not on the ground at Y=0 (which used to bury part of every pillar,
	-- runes included, inside the tier below it)
	local baseY = tierHeightAtRadius(tiersData, CONFIG.PillarRadius)

	local count = CONFIG.PillarCount
	for i = 0, count - 1 do
		local angle = (i / count) * math.pi * 2
		local x = CONFIG.Origin.X + math.cos(angle) * CONFIG.PillarRadius
		local z = CONFIG.Origin.Z + math.sin(angle) * CONFIG.PillarRadius

		-- per-pillar variance so the ring doesn't read as six copy-pasted
		-- blocks — the reference pillars are clearly hand-placed/irregular.
		-- Kept subtle on purpose: too much jitter reads as broken glass
		-- shards instead of standing stones.
		local heightJitter = 0.85 + math.random() * 0.3   -- 0.85 - 1.15x
		local widthJitter  = 0.85 + math.random() * 0.25  -- 0.85 - 1.10x
		local leanAngle    = math.rad(math.random(-2, 2)) -- tiny natural lean

		local totalHeight = CONFIG.PillarHeight * heightJitter

		-- orient once per pillar: sit at (x, baseY, z), yaw to face the
		-- center (so runes always point inward), plus a hair of roll for
		-- the lean. Every segment below stacks off of this.
		local orient = CFrame.lookAt(
			Vector3.new(x, baseY, z),
			Vector3.new(CONFIG.Origin.X, baseY, CONFIG.Origin.Z)
		) * CFrame.Angles(0, 0, leanAngle)

		-- three stacked, gently tapering segments = a chunky standing
		-- stone instead of one extruded box. Widths are close together on
		-- purpose (a hard taper is what made these read as spikes before).
		local segWidths = { 3.4, 3.0, 2.5 } -- base -> cap
		local segCount = #segWidths
		local segHeight = totalHeight / segCount
		local cursorY = 0

		for seg = 1, segCount do
			local w = segWidths[seg] * widthJitter
			local jitterYaw = math.rad(math.random(-2, 2))
			local segCFrame = orient
				* CFrame.new(0, cursorY + segHeight / 2, 0)
				* CFrame.Angles(0, jitterYaw, 0)

			newPart({
				Name = "Pillar_" .. i .. "_Seg" .. seg,
				Size = Vector3.new(w, segHeight, w),
				CFrame = segCFrame,
				Material = Enum.Material.Rock,
				Color = (seg == 1) and CONFIG.StoneColorDark or CONFIG.StoneColorLight,
				Parent = pillarsFolder,
			})

			cursorY = cursorY + segHeight
		end

		-- small chipped/broken cap so the silhouette isn't a flat rectangle
		local capW = segWidths[segCount] * widthJitter * 0.9
		newPart({
			Name = "Pillar_" .. i .. "_Cap",
			Size = Vector3.new(capW, 0.7, capW),
			CFrame = orient * CFrame.new(0, totalHeight + 0.25, 0)
				* CFrame.Angles(math.rad(math.random(-5, 5)), math.rad(math.random(0, 360)), math.rad(math.random(-5, 5))),
			Material = Enum.Material.Rock,
			Color = CONFIG.StoneColorLight,
			Parent = pillarsFolder,
		})

		if i % CONFIG.GlowPillarEvery == 0 then
			-- rune sits in the lower-middle of the base segment, flush
			-- against its front face (the face pointing at the center)
			local halfWidth = (segWidths[1] * widthJitter) / 2
			local runeHeight = segHeight * 0.55
			local faceCFrame = orient * CFrame.new(0, runeHeight, -halfWidth - 0.02)

			-- shallow carved recess behind the rune (smoother/darker than
			-- the rough stone around it, like a polished, cut panel)
			newPart({
				Name = "Pillar_" .. i .. "_Panel",
				Size = Vector3.new(0.9, 1.9, 0.1),
				CFrame = faceCFrame * CFrame.new(0, 0, 0.02),
				Material = Enum.Material.Slate,
				Color = CONFIG.StoneColorDark,
				CanCollide = false,
				Parent = pillarsFolder,
			})

			-- the rune itself: a flattened, elongated "leaf/eye" shape
			-- sitting almost flush against the panel (not a floating gem)
			local gem = newPart({
				Name = "Pillar_" .. i .. "_Rune",
				Size = Vector3.new(1, 1, 1),
				CFrame = faceCFrame * CFrame.new(0, 0, -0.02),
				Material = Enum.Material.Neon,
				Color = CONFIG.BeamColor,
				CanCollide = false,
				Parent = pillarsFolder,
			})
			local gemMesh = Instance.new("SpecialMesh")
			gemMesh.MeshType = Enum.MeshType.Sphere
			gemMesh.Scale = Vector3.new(0.34, 0.7, 0.12)
			gemMesh.Parent = gem

			-- thin vertical "vein" poking past the top/bottom of the eye
			-- shape — reads as a leaf spine/stem, matching the reference art
			newPart({
				Name = "Pillar_" .. i .. "_RuneVein",
				Size = Vector3.new(0.05, 1.5, 0.05),
				CFrame = faceCFrame * CFrame.new(0, 0, -0.02),
				Material = Enum.Material.Neon,
				Color = CONFIG.BeamColor,
				CanCollide = false,
				Parent = pillarsFolder,
			})

			-- much dimmer/tighter than before — this was the other big
			-- source of the green wash, since it used to be Range 6 /
			-- Brightness 1.4 sitting right against the pillar's own stone
			local runeLight = Instance.new("PointLight")
			runeLight.Color = CONFIG.BeamColor
			runeLight.Range = 4
			runeLight.Brightness = 0.8
			runeLight.Parent = gem
		end
	end
end

-- ============================================================
-- MOSS ACCENTS
-- ============================================================
-- Small green patches at the pillar bases and around the outer tier rim,
-- echoing the moss climbing the stone in the reference art.

local function buildMoss(tiersData)
	local mossFolder = Instance.new("Folder")
	mossFolder.Name = "Moss"
	mossFolder.Parent = root

	local function mossBlob(pos, size)
		local blob = newPart({
			Name = "Moss",
			Size = Vector3.new(size, size * 0.35, size),
			CFrame = CFrame.new(pos),
			Material = Enum.Material.Grass,
			Color = CONFIG.MossColor,
			CanCollide = false,
			Parent = mossFolder,
		})
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = blob
	end

	-- rim of the outer tier
	local outer = tiersData[1]
	for _ = 1, 12 do
		local theta = math.random() * math.pi * 2
		local dist = outer.bandInner + math.random() * (outer.bandOuter - outer.bandInner)
		local pos = CONFIG.Origin + Vector3.new(math.cos(theta) * dist, outer.topY + 0.05, math.sin(theta) * dist)
		mossBlob(pos, 0.8 + math.random() * 1.2)
	end

	-- pillar bases
	local pillarBaseY = tierHeightAtRadius(tiersData, CONFIG.PillarRadius)
	local count = CONFIG.PillarCount
	for i = 0, count - 1 do
		local angle = (i / count) * math.pi * 2
		local x = CONFIG.Origin.X + math.cos(angle) * CONFIG.PillarRadius
		local z = CONFIG.Origin.Z + math.sin(angle) * CONFIG.PillarRadius
		for _ = 1, 2 do
			local jitterAngle = math.random() * math.pi * 2
			local jitterDist = 1.4 + math.random()
			local pos = Vector3.new(
				x + math.cos(jitterAngle) * jitterDist,
				pillarBaseY + 0.05,
				z + math.sin(jitterAngle) * jitterDist
			)
			mossBlob(pos, 1 + math.random())
		end
	end
end

