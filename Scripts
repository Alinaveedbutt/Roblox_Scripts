--[[
	FOREST SPAWN PLATFORM — procedural builder
	--------------------------------------------
	Recreates the concept art: a tiered stone plaza, six pillars (alternating
	glowing rune markers), a stepped entrance, a glowing center disc + beam,
	scattered rocks, and (optionally) a small forest clearing around it.

	HOW TO USE
	1) Paste this whole script into a Script inside ServerScriptService,
	   OR paste it into the Studio Command Bar for an instant one-off build.
	2) Run it once. Everything is built under workspace inside a folder
	   named "ForestSpawnPlatform".
	3) Edit CONFIG below to change size, stone colors, pillar count, beam
	   color, or whether the ground/path/trees get built at all.
	4) To rebuild, delete the "ForestSpawnPlatform" folder in workspace and
	   run the script again — everything this script makes (including the
	   ground/trees) lives under that one folder, so this always fully
	   resets it.

	NOTE: the reference is AI concept art, not a 3D model, so there's no
	exact mesh to copy — this reconstructs it from scratch as real,
	game-ready Roblox parts, matching the composition as closely as a
	script reasonably can.

	REVISION 2 NOTES
	- Root cause of the green-tinted, glassy-looking pillars in the last
	  screenshot: the center disc's PointLight (Range 24) and each rune's
	  PointLight were bright/wide enough to flood the whole plaza, since
	  the pillars sit well within that range. Both are turned way down
	  below, so stone reads as stone again instead of glowing green glass.
	- Pillars were also standing at ground level (Y=0) even though their
	  ring (PillarRadius) sits on a raised tier — meaning a chunk of every
	  pillar's height was buried in the tier below it, including the rune
	  in some configs. buildPillars now looks up the actual tier height at
	  PillarRadius and stands on top of it.
	- Pillar taper was too aggressive combined with per-segment rotation
	  jitter, which read as jagged crystal shards rather than chunky
	  standing stones. Segments are wider now and jitter is more subtle.
	- Added: moss accents at pillar bases and the outer tier rim, rounder
	  boulders (rocks now use a sphere mesh instead of plain boxes), and an
	  optional forest clearing — grass patch, a winding dirt path off the
	  entrance, and a scatter of simple low-poly pine props — since a big
	  part of the reference's look is the forest it sits in, not just the
	  stonework. Set CONFIG.BuildEnvironment = false to skip that part.
]]

local CONFIG = {
	Origin          = Vector3.new(0, 0, 0),              -- world position of the platform's ground center
	PlatformRadius  = 22,                                 -- outer radius of the paved circle
	RingCount       = 4,                                  -- number of concentric stepped tiers
	RingHeight      = 0.6,                                -- height of each tier
	CenterHeight    = 2.4,                                -- how much higher the center disc sits above the tiers
	PillarCount     = 6,
	PillarRadius    = 17,                                 -- distance of pillars from center
	PillarHeight    = 9,
	GlowPillarEvery = 2,                                  -- every Nth pillar (0-indexed) gets a glowing rune
	BeamColor       = Color3.fromRGB(80, 255, 120),       -- green beam. Try Color3.fromRGB(80, 200, 255) for blue.
	StoneColorLight = Color3.fromRGB(165, 165, 158),
	StoneColorDark  = Color3.fromRGB(108, 110, 104),
	GroutColor      = Color3.fromRGB(35, 38, 34),         -- dark radial dividing lines cut into the paving
	SpokeCount      = 20,                                 -- how many radial grout lines run across the plaza
	StepCount       = 5,
	StepDirection   = Vector3.new(0, 0, 1),               -- which side the staircase (and path) face (default: south, +Z)
	RockCount       = 14,
	MossColor       = Color3.fromRGB(74, 98, 58),

	SetupLighting   = true,                               -- if true, the script fixes your place's Lighting so stone isn't black

	-- forest clearing around the platform (grass patch, dirt path, trees)
	BuildEnvironment = true,
	GroundPadding    = 26,                                -- how far past PlatformRadius the grass patch extends
	GroundColor      = Color3.fromRGB(58, 84, 46),
	PathColor        = Color3.fromRGB(107, 84, 55),
	PathLength       = 34,
	PathWidth        = 7,
	TreeCount        = 14,
	TreeMinDistance  = 28,
	TreeMaxDistance  = 44,
	TrunkColor       = Color3.fromRGB(59, 42, 30),
	CanopyColor      = Color3.fromRGB(42, 68, 38),
}

-- ============================================================
-- HELPERS
-- ============================================================

local function newPart(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.Material = Enum.Material.Slate
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in pairs(props) do
		p[key] = value
	end
	return p
end

-- rotate a (Y-up) direction vector around the vertical axis by `angle` radians
local function rotateY(vec, angle)
	local c, s = math.cos(angle), math.sin(angle)
	return Vector3.new(vec.X * c - vec.Z * s, vec.Y, vec.X * s + vec.Z * c)
end

-- given the ring data from buildTiers(), find the top height of whichever
-- tier a given radius physically sits on (so things placed at that radius
-- stand ON the step instead of floating above it or burying into it)
local function tierHeightAtRadius(tiersData, radius)
	for _, band in ipairs(tiersData) do
		if radius <= band.bandOuter + 0.001 and radius >= band.bandInner - 0.001 then
			return band.topY
		end
	end
	if radius > tiersData[1].bandOuter then
		return tiersData[1].topY
	end
	return tiersData[#tiersData].topY
end

local root = Instance.new("Folder")
root.Name = "ForestSpawnPlatform"
root.Parent = workspace

-- ============================================================
-- CONCENTRIC STONE TIERS ("wedding cake" rings)
-- ============================================================

local function buildTiers()
	local tiersFolder = Instance.new("Folder")
	tiersFolder.Name = "PlatformTiers"
	tiersFolder.Parent = root

	local innerRadius = CONFIG.PlatformRadius * 0.22
	local ringCount = CONFIG.RingCount
	local radiusStep = (CONFIG.PlatformRadius - innerRadius) / ringCount
	local tiersData = {}

	for i = 0, ringCount - 1 do
		local ringRadius = CONFIG.PlatformRadius - (i * radiusStep)
		local ringHeight = (i + 1) * CONFIG.RingHeight -- stacks from ground up to this tier's top
		local color = (i % 2 == 0) and CONFIG.StoneColorLight or CONFIG.StoneColorDark

		newPart({
			Name = "Tier_" .. i,
			Shape = Enum.PartType.Cylinder,
			Material = Enum.Material.Concrete,
			Size = Vector3.new(ringHeight, ringRadius * 2, ringRadius * 2),
			CFrame = CFrame.new(CONFIG.Origin.X, CONFIG.Origin.Y + ringHeight / 2, CONFIG.Origin.Z)
				* CFrame.Angles(0, 0, math.rad(90)),
			Color = color,
			Parent = tiersFolder,
		})

		tiersData[#tiersData + 1] = {
			bandOuter = ringRadius,
			bandInner = ringRadius - radiusStep,
			topY = CONFIG.Origin.Y + ringHeight,
		}
	end

	return tiersData, innerRadius, ringCount * CONFIG.RingHeight
end

-- Radial "cut stone" dividing lines running across every tier, aligned so
-- they read as continuous spokes from the center out to the edge.
local function buildGrout(tiersData)
	local groutFolder = Instance.new("Folder")
	groutFolder.Name = "Grout"
	groutFolder.Parent = root

	local spokeCount = CONFIG.SpokeCount
	for k = 0, spokeCount - 1 do
		local theta = (k / spokeCount) * math.pi * 2
		local dir = Vector3.new(math.cos(theta), 0, math.sin(theta))

		for _, band in ipairs(tiersData) do
			local bandWidth = band.bandOuter - band.bandInner
			local bandMid = (band.bandOuter + band.bandInner) / 2
			local pos = CONFIG.Origin + dir * bandMid + Vector3.new(0, band.topY + 0.03, 0)
			local cf = CFrame.lookAt(pos, pos + dir)

			newPart({
				Name = "Spoke",
				Size = Vector3.new(0.15, 0.05, bandWidth * 0.94),
				CFrame = cf,
				Color = CONFIG.GroutColor,
				Material = Enum.Material.Concrete,
				CanCollide = false,
				Parent = groutFolder,
			})
		end
	end
end

-- ============================================================
-- RAISED CENTER DISC + GLOWING RING PATTERN
-- ============================================================

local function buildCenterDisc(innerRadius, tierTopHeight)
	local centerFolder = Instance.new("Folder")
	centerFolder.Name = "CenterDisc"
	centerFolder.Parent = root

	local baseHeight = tierTopHeight + CONFIG.CenterHeight

	newPart({
		Name = "CenterBase",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(baseHeight, innerRadius * 2, innerRadius * 2),
		CFrame = CFrame.new(CONFIG.Origin.X, CONFIG.Origin.Y + baseHeight / 2, CONFIG.Origin.Z)
			* CFrame.Angles(0, 0, math.rad(90)),
		Color = CONFIG.StoneColorDark,
		Parent = centerFolder,
	})

	local topY = CONFIG.Origin.Y + baseHeight + 0.05

	newPart({
		Name = "GlowRingOuter",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.1, innerRadius * 1.6, innerRadius * 1.6),
		CFrame = CFrame.new(CONFIG.Origin.X, topY, CONFIG.Origin.Z) * CFrame.Angles(0, 0, math.rad(90)),
		Material = Enum.Material.Neon,
		Color = CONFIG.BeamColor,
		CanCollide = false,
		Parent = centerFolder,
	})

	local innerGlow = newPart({
		Name = "GlowRingInner",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.12, innerRadius * 0.8, innerRadius * 0.8),
		CFrame = CFrame.new(CONFIG.Origin.X, topY + 0.02, CONFIG.Origin.Z) * CFrame.Angles(0, 0, math.rad(90)),
		Material = Enum.Material.Neon,
		Color = CONFIG.BeamColor,
		CanCollide = false,
		Parent = centerFolder,
	})

	-- Kept deliberately modest: this used to be Range 24 / Brightness 3,
	-- which reached all the way out to the pillars (PillarRadius 17) and
	-- washed the whole plaza green. This still gives the center a nice
	-- glow without floodlighting everything around it.
	local light = Instance.new("PointLight")
	light.Color = CONFIG.BeamColor
	light.Range = 12
	light.Brightness = 1.2
	light.Parent = innerGlow

	-- compass-style tick marks radiating just past the inner glow ring
	for k = 0, 7 do
		local angle = k * (math.pi / 4)
		local dir = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local pos = CONFIG.Origin + dir * (innerRadius * 0.9) + Vector3.new(0, topY + 0.03, 0)
		local cf = CFrame.lookAt(pos, pos + dir)

		newPart({
			Name = "ReticleTick",
			Size = Vector3.new(0.12, 0.05, innerRadius * 0.4),
			CFrame = cf,
			Material = Enum.Material.Neon,
			Color = CONFIG.BeamColor,
			CanCollide = false,
			Parent = centerFolder,
		})
	end

	return topY
end

