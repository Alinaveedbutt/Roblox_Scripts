local function buildRoomB(root, entrancePosition, forward)
	local settings = {
		radius = CONFIG.roomB.radius,
		wallHeight = CONFIG.roomB.wallHeight,
		wallSegments = CONFIG.roomB.wallSegments,
		domeHeight = CONFIG.roomB.domeHeight,
		domeRings = 5,
		wallMaterial = CONFIG.materials.wall,
		wallColor = CONFIG.colors.wall,
		domeMaterial = CONFIG.materials.dome,
		domeColor = CONFIG.colors.domeB,
		doorwayHalfWidth = CONFIG.corridor.width / 2 + 1.1,
	}

	local room, center = buildArena(
		root,
		"RoomB_Blades",
		entrancePosition,
		forward,
		settings
	)

	-- Heavy stone approach tying the corridor into the arena -- this is
	-- the "same structure as the hub" integration pass; every existing
	-- arena feature below is untouched.
	buildArenaApproach(
		room,
		entrancePosition,
		forward,
		CONFIG.corridor.width,
		settings.wallHeight - 2,
