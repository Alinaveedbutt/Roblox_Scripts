-- ARENA AND DOME HELPERS
----------------------------------------------------------------------

local function buildDome(parent, centerPosition, radius, wallHeight, domeHeight, segments, rings, material, color)
	local dome = newFolder(parent, "Dome")

	for ring = 0, rings - 1 do
		local t0 = (ring / rings) * math.pi / 2
		local t1 = ((ring + 1) / rings) * math.pi / 2

		local radius0 = radius * math.cos(t0)
		local radius1 = radius * math.cos(t1)

		local height0 = wallHeight + domeHeight * math.sin(t0)
		local height1 = wallHeight + domeHeight * math.sin(t1)

		for segment = 0, segments - 1 do
			local angle0 = (segment / segments) * math.pi * 2
			local angle1 = ((segment + 1) / segments) * math.pi * 2

			local pointA0 = centerPosition + Vector3.new(
				math.cos(angle0) * radius0,
				height0,
				math.sin(angle0) * radius0
			)

			local pointB0 = centerPosition + Vector3.new(
				math.cos(angle1) * radius0,
				height0,
				math.sin(angle1) * radius0
			)

			local pointA1 = centerPosition + Vector3.new(
				math.cos(angle0) * radius1,
				height1,
				math.sin(angle0) * radius1
			)

			local pointB1 = centerPosition + Vector3.new(
				math.cos(angle1) * radius1,
				height1,
				math.sin(angle1) * radius1
			)

			local mid0 = (pointA0 + pointB0) / 2
			local mid1 = (pointA1 + pointB1) / 2
			local panelCenter = (mid0 + mid1) / 2

			local tangent = (pointB0 - pointA0).Unit
			local slope = (mid1 - mid0).Unit
			local normal = tangent:Cross(slope)

			if normal.Magnitude < 0.001 then
				normal = Vector3.new(0, 1, 0)
			else
				normal = normal.Unit
			end

			local panelWidth = (pointB0 - pointA0).Magnitude
			local panelHeight = (mid1 - mid0).Magnitude

			newPart({
				Name = "DomePanel_" .. ring .. "_" .. segment,
				Size = Vector3.new(panelWidth + 0.35, panelHeight + 0.35, 0.8),
				CFrame = CFrame.fromMatrix(panelCenter, tangent, slope, normal),
				Material = material,
				Color = color,
				Parent = dome,
			})
		end
	end

	return dome
end

local function buildArena(root, name, entrancePosition, forward, settings)
	local arena = newFolder(root, name)

	local radius = settings.radius
	local wallHeight = settings.wallHeight
	local segments = settings.wallSegments
	local centerPosition = entrancePosition + forward * radius
	local entryNormal = -forward

	newPart({
		Name = "Floor",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1, radius * 2, radius * 2),
		CFrame = CFrame.new(centerPosition + Vector3.new(0, -0.5, 0))
			* CFrame.Angles(0, 0, math.rad(90)),
		Material = CONFIG.materials.floor,
		Color = CONFIG.colors.floor,
		Parent = arena,
	})

	-- The doorway only needs to be as wide as the corridor plus a small
	-- margin for the approach pilasters (see buildArenaApproach) -- not
	-- a fixed fraction of the whole ring. Computing the angular
	-- half-width from the real corridor width keeps the wall continuous
	-- everywhere else, so the arena reads as one complete enclosed
	-- cylinder with a doorway cut into it rather than a wide gap.
	local doorwayHalfWidth = settings.doorwayHalfWidth or (CONFIG.corridor.width / 2 + 1)
	local doorwayCosThreshold = math.cos(math.asin(math.min(doorwayHalfWidth / (radius - 1.5), 1)))

	for segment = 0, segments - 1 do
		local angle0 = (segment / segments) * math.pi * 2
		local angle1 = ((segment + 1) / segments) * math.pi * 2
		local midAngle = (angle0 + angle1) / 2

		local normal = Vector3.new(
			math.cos(midAngle),
			0,
			math.sin(midAngle)
		)

		-- Leave a doorway facing the hub.
		if normal:Dot(entryNormal) < doorwayCosThreshold then
			local pointA = centerPosition + Vector3.new(
				math.cos(angle0) * (radius - 1.5),
				0,
				math.sin(angle0) * (radius - 1.5)
			)

			local pointB = centerPosition + Vector3.new(
				math.cos(angle1) * (radius - 1.5),
				0,
				math.sin(angle1) * (radius - 1.5)
			)

			local segmentLength = (pointB - pointA).Magnitude

			local segmentFloorPosition = (pointA + pointB) / 2

			addOrientedPart(
				arena,
				"WallSegment_" .. (segment + 1),
				Vector3.new(segmentLength + 0.45, wallHeight, 3),
				segmentFloorPosition + Vector3.new(0, wallHeight / 2, 0),
				normal,
				settings.wallMaterial,
				settings.wallColor
			)

			addCorniceBand(
				arena,
				"WallSegment_" .. (segment + 1),
				segmentFloorPosition,
				normal,
				segmentLength,
				wallHeight,
				CONFIG.materials.trim,
				CONFIG.colors.trim
			)

			addBaseboardBand(
				arena,
				"WallSegment_" .. (segment + 1),
				segmentFloorPosition,
				normal,
				segmentLength,
				CONFIG.materials.trim,
				CONFIG.colors.trim
			)

			-- Buttress pilaster + torch every 4th segment, not every
			-- segment, so the ring reads as evenly spaced supports
			-- rather than a solid drum of columns.
			if segment % 4 == 0 then
				addPilaster(
					arena,
					"Buttress_" .. (segment + 1),
					segmentFloorPosition,
					normal,
					wallHeight,
					settings.wallMaterial,
					settings.wallColor
				)

				addWallTorch(
					arena,
					"Torch_" .. (segment + 1),
					segmentFloorPosition - normal * 1.6,
					-normal,
					CONFIG.detail.torchHeight
				)
			end
		end
	end

	buildDoorFrame(
		arena,
		"EntranceFrame",
		entrancePosition,
		forward,
		CONFIG.corridor.width,
		wallHeight - 2,
		settings.wallMaterial,
		settings.wallColor
	)

	buildDome(
		arena,
		centerPosition,
		radius - 1.5,
		wallHeight,
		settings.domeHeight,
		segments,
		settings.domeRings,
		settings.domeMaterial,
		settings.domeColor
	)

	addDomeCap(
		arena,
		centerPosition,
		wallHeight,
		settings.domeHeight,
		settings.domeMaterial,
		settings.domeColor
	)

	return arena, centerPosition
end

-- Dresses a corridor-to-arena threshold with hub-style heavy masonry --
-- flanking pilasters, an impost band marking the springing line, and a
-- shallow segmental voussoir arch -- so the arena reads as carved from
-- the same structure as the hub rather than stuck on a hallway's end.
-- Radius is derived from doorWidth/doorHeight so the crown clears the
-- dome springline automatically; nothing here touches buildArena.
local function buildArenaApproach(parent, entrancePosition, forward, doorWidth, doorHeight, material, color)
	local right = getRight(forward)
	local pilasterOffset = doorWidth / 2 + 1.1

	addPilaster(parent, "ApproachPilasterLeft", entrancePosition - right * pilasterOffset, forward, doorHeight + 1, material, color)
	addPilaster(parent, "ApproachPilasterRight", entrancePosition + right * pilasterOffset, forward, doorHeight + 1, material, color)

	addOrientedPart(parent, "ApproachImpost", Vector3.new(doorWidth + 2.6, 0.6, 2.6),
		entrancePosition + Vector3.new(0, doorHeight, 0), forward, material, color)

	addOrientedPart(parent, "ApproachSill", Vector3.new(doorWidth + 1.4, 0.3, 1.8),
		entrancePosition + Vector3.new(0, 0.05, 0), forward, material, color)

	-- Shallow segmental arch: radius solved from the desired rise so the
	-- crown clears comfortably under the dome springline (a full
	-- semicircle would be far too tall for the available headroom).
	local halfWidth = doorWidth / 2 + 1.4
	local rise = 1.8
	local archRadius = (halfWidth ^ 2 + rise ^ 2) / (2 * rise)
	local halfSweep = math.asin(math.min(halfWidth / archRadius, 1))
	local archCenter = entrancePosition + Vector3.new(0, doorHeight + rise - archRadius, 0)

	local voussoirCount = 9
	local angleStep = (halfSweep * 2) / voussoirCount
	local blockWidth = 2 * archRadius * math.sin(angleStep / 2) * 1.3
	local keystoneIndex = math.floor(voussoirCount / 2)

	for index = 0, voussoirCount - 1 do
		local angle = (math.pi / 2 - halfSweep) + angleStep * (index + 0.5)

		local position = archCenter
			+ right * (archRadius * math.cos(angle))
			+ Vector3.new(0, archRadius * math.sin(angle), 0)

		local tangent = right * -math.sin(angle) + Vector3.new(0, math.cos(angle), 0)
		local radial = right * math.cos(angle) + Vector3.new(0, math.sin(angle), 0)
		local isKeystone = index == keystoneIndex

		newPart({
			Name = isKeystone and "ApproachKeystone" or ("ApproachVoussoir_" .. (index + 1)),
			Size = isKeystone
				and Vector3.new(blockWidth * 1.2, 1.9, 2.9)
				or Vector3.new(blockWidth, 1.5, 2.6),
			CFrame = CFrame.fromMatrix(position, tangent, radial),
			Material = material,
			Color = color,
			Parent = parent,
		})
	end
end

