		Color = CONFIG.colors.floor,
		Parent = room,
	})

	local golem = newFolder(room, "GolemPlaceholder")

	local parts = {
		{
			name = "Legs",
			size = Vector3.new(4, 3, 3),
			offset = Vector3.new(0, 3.5, 0),
		},
		{
			name = "Torso",
			size = Vector3.new(5, 4, 3.5),
			offset = Vector3.new(0, 7, 0),
		},
		{
			name = "Head",
			size = Vector3.new(2, 2, 2),
			offset = Vector3.new(0, 10, 0),
		},
	}

	for _, partInfo in ipairs(parts) do
		newPart({
			Name = partInfo.name,
			Size = partInfo.size,
			CFrame = CFrame.new(center + partInfo.offset),
			Material = CONFIG.materials.rubble,
			Color = CONFIG.colors.statue,
			Parent = golem,
		})
	end

	local coreOffsets = {
		Vector3.new(0, 7, -2),
		Vector3.new(-2.7, 7, 0),
		Vector3.new(2.7, 7, 0),
	}

	for index, offset in ipairs(coreOffsets) do
		local core = newPart({
			Name = "Core" .. index,
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(1.2, 1.2, 1.2),
			CFrame = CFrame.new(center + offset),
			Material = CONFIG.materials.neon,
			Color = CONFIG.colors.crystal,
			CanCollide = false,
			CanQuery = false,
			Parent = golem,
		})

		addGlow(core, CONFIG.colors.crystal, 10, 2)
	end

	for index = 0, 7 do
		local angle = math.rad(index * 45)
		local position = center + Vector3.new(
			math.cos(angle) * 27,
			0,
			math.sin(angle) * 27
		)

		newPart({
			Name = "Statue_" .. (index + 1),
			Size = Vector3.new(2.5, 7, 2.5),
			CFrame = CFrame.new(position + Vector3.new(0, 3.5, 0)),
			Material = Enum.Material.Concrete,
			Color = CONFIG.colors.statue,
			Parent = room,
		})
	end

	return room
end

----------------------------------------------------------------------
-- ROOM C: ORRERY
----------------------------------------------------------------------

local function buildRoomC(root, entrancePosition, forward)
	local settings = {
		radius = CONFIG.roomC.radius,
		wallHeight = CONFIG.roomC.wallHeight,
		wallSegments = CONFIG.roomC.wallSegments,
		domeHeight = CONFIG.roomC.domeHeight,
		domeRings = 7,
		wallMaterial = Enum.Material.Basalt,
		wallColor = CONFIG.colors.wallC,
		domeMaterial = Enum.Material.Basalt,
		domeColor = CONFIG.colors.domeC,
		doorwayHalfWidth = CONFIG.corridor.width / 2 + 1.1,
	}

	local room, center = buildArena(
		root,
		"RoomC_Orrery",
		entrancePosition,
		forward,
		settings
	)

	-- Same stone approach Room B got: pilasters, an impost band, and a
	-- voussoir arch tying the corridor into the sanctuary, so this room
	-- doesn't read as a circular wall dropped at the end of a hallway.
	buildArenaApproach(
		room,
		entrancePosition,
		forward,
		CONFIG.corridor.width,
		settings.wallHeight - 2,
		settings.wallMaterial,
		CONFIG.colors.ancientStone
	)

	newPart({
		Name = "HeartDais",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2, 20, 20),
		CFrame = CFrame.new(center + Vector3.new(0, 1, 0))
			* CFrame.Angles(0, 0, math.rad(90)),
		Material = CONFIG.materials.floor,
		Color = CONFIG.colors.floor,
		Parent = room,
	})

	-- Elevated tiered platform: a wide ancient-stone base step and a
	-- narrower crown step above the existing dais, turning the flat
	-- disc into a proper stepped altar the Heart rises out of.
	local daisTiers = {
		{ radius = 15, height = 0.6, y = 0.3, material = CONFIG.materials.wall, color = CONFIG.colors.ancientStone },
		{ radius = 12.5, height = 0.5, y = 0.85, material = CONFIG.materials.trim, color = CONFIG.colors.trim },
		{ radius = 5, height = 0.7, y = 2.35, material = CONFIG.materials.trim, color = CONFIG.colors.trim },
	}

	for index, tier in ipairs(daisTiers) do
		newPart({
			Name = "DaisTier_" .. index,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(tier.height, tier.radius * 2, tier.radius * 2),
			CFrame = CFrame.new(center + Vector3.new(0, tier.y, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			Material = tier.material,
			Color = tier.color,
			Parent = room,
		})
	end

	local heart = newPart({
		Name = "CrystalHeart",
		Size = Vector3.new(3, 5, 3),
		CFrame = CFrame.new(center + Vector3.new(0, 5, 0))
			* CFrame.Angles(math.rad(45), math.rad(45), 0),
		Material = CONFIG.materials.neon,
		Color = CONFIG.colors.crystal,
		CanCollide = false,
		CanQuery = false,
		Parent = room,
	})

	addGlow(heart, CONFIG.colors.crystal, 30, 3)

	for index = 1, 6 do
		local angle = math.rad((index / 6) * 360)
		local mote = newPart({
			Name = "MotePlaceholder_" .. index,
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(1.2, 1.2, 1.2),
			CFrame = CFrame.new(
				center + Vector3.new(
					math.cos(angle) * 12,
					5,
					math.sin(angle) * 12
				)
			),
			Material = CONFIG.materials.neon,
			Color = CONFIG.colors.portal,
			Transparency = 0.15,
			CanCollide = false,
			CanQuery = false,
			Parent = room,
		})

		addGlow(mote, CONFIG.colors.portal, 8, 1.5)
	end

	for index = 1, 40 do
		local theta = math.rad(5 + random:NextNumber() * 80)
		local phi = math.rad(random:NextNumber() * 360)

		local radius = math.max(
			0,
			(CONFIG.roomC.radius - 2) * math.cos(theta)
		)

		local height =
			CONFIG.roomC.wallHeight
			+ CONFIG.roomC.domeHeight * math.sin(theta)
		- 0.3

		newPart({
			Name = "Star_" .. index,
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.35, 0.35, 0.35),
			CFrame = CFrame.new(
				center + Vector3.new(
					math.cos(phi) * radius,
					height,
					math.sin(phi) * radius
				)
			),
			Material = CONFIG.materials.neon,
			Color = CONFIG.colors.star,
			CanCollide = false,
			CanQuery = false,
			CastShadow = false,
			Parent = room,
		})
	end

	-- Armillary rings framing the Heart -- two intersecting metal rings
	-- (reusing the room's existing metal/portal palette), sized inside
	-- the motes' orbit so the composition reads as an inner mechanism
	-- with the motes orbiting further out around it. Each ring is an
	-- upper semicircle centered exactly on the Heart: every point sits
	-- the same radius from its center (clear of the crystal by design)
	-- and never dips below the Heart's own height, so it can't clip the
	-- tiered dais below.
	local function addCelestialArc(ringName, axisA, ringRadius, segments)
		local ringCenter = center + Vector3.new(0, 5, 0)
		local up = Vector3.new(0, 1, 0)

		for index = 0, segments - 1 do
			local angle0 = (index / segments) * math.pi
			local angle1 = ((index + 1) / segments) * math.pi
			local mid = (angle0 + angle1) / 2

			local point0 = ringCenter + axisA * math.cos(angle0) * ringRadius + up * math.sin(angle0) * ringRadius
			local point1 = ringCenter + axisA * math.cos(angle1) * ringRadius + up * math.sin(angle1) * ringRadius
			local direction = point1 - point0
			local midpoint = (point0 + point1) / 2
			local radialOut = axisA * math.cos(mid) + up * math.sin(mid)

			newPart({
				Name = ringName .. "_" .. (index + 1),
				Size = Vector3.new(0.4, 0.55, direction.Magnitude + 0.25),
				CFrame = CFrame.lookAt(midpoint, midpoint + direction, radialOut),
				Material = CONFIG.materials.metal,
				Color = CONFIG.colors.metal,
				CanCollide = false,
				CanQuery = false,
				Parent = room,
			})
		end
	end

	addCelestialArc("ArmillaryArcA", Vector3.new(1, 0, 0), 7, 14)
	addCelestialArc("ArmillaryArcB", Vector3.new(0, 0, 1), 7, 14)

	for _, offset in ipairs({
		Vector3.new(7, 5, 0), Vector3.new(-7, 5, 0),
		Vector3.new(0, 5, 7), Vector3.new(0, 5, -7),
		}) do
		local node = newPart({
			Name = "RingNode",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.7, 0.7, 0.7),
			CFrame = CFrame.new(center + offset),
			Material = CONFIG.materials.neon,
			Color = CONFIG.colors.portal,
			CanCollide = false,
			CanQuery = false,
			Parent = room,
		})

		addGlow(node, CONFIG.colors.portal, 8, 1.5)
	end

	-- Dome ribs continuing every buttress buildArena already placed (at
	-- the same segment%4==0 positions) up the dome's curve to the apex
	-- -- "additional supports" that tie directly into what's already
	-- there instead of introducing a different building language.
	for segment = 0, CONFIG.roomC.wallSegments - 1, 4 do
		local midAngle = ((segment + 0.5) / CONFIG.roomC.wallSegments) * math.pi * 2
		local radialXZ = Vector3.new(math.cos(midAngle), 0, math.sin(midAngle))
		local previousPoint = nil

		for ring = 0, settings.domeRings do
			local t = (ring / settings.domeRings) * (math.pi / 2)
			local ringRadius = (settings.radius - 1.5) * math.cos(t)
			local ringHeight = settings.wallHeight + settings.domeHeight * math.sin(t)
			local point = center + radialXZ * ringRadius + Vector3.new(0, ringHeight, 0)

			if previousPoint then
				local direction = point - previousPoint
				local midpoint = (point + previousPoint) / 2

				newPart({
					Name = string.format("DomeRib_%d_Seg%d", segment + 1, ring),
					Size = Vector3.new(1.0, 0.8, direction.Magnitude + 0.3),
					CFrame = CFrame.lookAt(midpoint, midpoint + direction, radialXZ),
					Material = settings.domeMaterial,
					Color = settings.wallColor,
					Parent = room,
				})
			end

			previousPoint = point
		end
	end

	-- Wall-level architecture to match: an engraved celestial medallion
	-- above every buttress (the same segment%4==0 positions as the
	-- buttresses and the dome ribs above), and a few shallow sanctuary
	-- niches interleaved between them. Both skip the entrance opening
	-- the same way buildArena's own wall loop does, so nothing ends up
	-- floating in the doorway gap.
	local entryNormal = -forward

	for segment = 0, CONFIG.roomC.wallSegments - 1, 4 do
		local midAngle = ((segment + 0.5) / CONFIG.roomC.wallSegments) * math.pi * 2
		local normal = Vector3.new(math.cos(midAngle), 0, math.sin(midAngle))

		if normal:Dot(entryNormal) < 0.86 then
			local wallFloorPosition = center + normal * (settings.radius - 1.5)

			addCelestialMedallion(room, "CelestialMedallion_" .. (segment + 1), wallFloorPosition, normal, 13)
		end
	end

	for segment = 2, CONFIG.roomC.wallSegments - 1, 8 do
		local midAngle = ((segment + 0.5) / CONFIG.roomC.wallSegments) * math.pi * 2
		local normal = Vector3.new(math.cos(midAngle), 0, math.sin(midAngle))

		if normal:Dot(entryNormal) < 0.86 then
			local wallFloorPosition = center + normal * (settings.radius - 1.5)

			addWallAlcove(room, "SanctuaryNiche_" .. (segment + 1), wallFloorPosition, normal, 2.6, 3.4, settings.wallMaterial, settings.wallColor)
		end
	end

	return room
end

----------------------------------------------------------------------
-- RUNTIME: SWINGING BLADE ANIMATION
----------------------------------------------------------------------
-- Swings every SwingingBlade-tagged model using the attributes already
-- stamped on it in buildSwingingBlade (SwingAxis, SwingDegrees,
-- PeriodSeconds): a plain sine-wave pendulum, slowest and heaviest at
-- the ends of the swing exactly like a real suspended blade. Contact
-- damage and hit detection stay out of scope here -- this only makes
-- the blades move, which is the one piece the "future SpikeTrapModule"
-- comments elsewhere in this file hadn't covered yet.
--
-- The pivot's PrimaryPart (PivotHub) sits exactly at the swing center,
-- so its Position never drifts as the model rotates -- it's read fresh
-- each frame instead of being cached, but it's the same value every
-- time.

local function animateSwingingBlades()
	local startTime = os.clock()

	RunService.Heartbeat:Connect(function()
		local elapsed = os.clock() - startTime

		for _, blade in ipairs(CollectionService:GetTagged("SwingingBlade")) do
			local pivotModel = blade:FindFirstChild("Pivot")

			if pivotModel and pivotModel.PrimaryPart then
				local axis = blade:GetAttribute("SwingAxis")
				local degrees = blade:GetAttribute("SwingDegrees")
				local period = blade:GetAttribute("PeriodSeconds")

				if axis and degrees and period and period > 0 then
					local amplitude = math.rad(degrees)
					local phaseOffset = blade:GetAttribute("PhaseOffset") or 0
					local angle = amplitude * math.sin((elapsed / period + phaseOffset) * (math.pi * 2))
					local pivotPosition = pivotModel.PrimaryPart.Position

					pivotModel:PivotTo(CFrame.new(pivotPosition) * CFrame.fromAxisAngle(axis, angle))
				end
			end
		end
	end)
end

----------------------------------------------------------------------
-- MAIN BUILD
----------------------------------------------------------------------

local function main()
	local oldDraft = Workspace:FindFirstChild("TrialChamberV2")

	if oldDraft then
		oldDraft:Destroy()
	end

	local originalFloorPosition = getExistingChamberFloorPosition()
	local basePosition = originalFloorPosition + CONFIG.draftOffset

	local root = Instance.new("Model")
	root.Name = "TrialChamberV2"
	root.Parent = Workspace

	-- Matches the screenshot's three-branch arrangement:
	-- Room A: lower-left, Room B: upper-left, Room C: upper-right.
	local branches = {
		{
			name = "A",
			forward = Vector3.new(-1, 0, 1).Unit,
			roomName = "RoomA",
		},
		{
			name = "B",
			forward = Vector3.new(-1, 0, -1).Unit,
			roomName = "RoomB",
		},
		{
			name = "C",
			forward = Vector3.new(1, 0, -1).Unit,
			roomName = "RoomC",
		},
	}

	buildCentralHub(root, basePosition, branches)

	for _, branch in ipairs(branches) do
		local corridorStart =
			basePosition
			+ branch.forward * (CONFIG.hub.radius - 1)

		local corridor = buildCorridor(
			root,
			"Hallway_" .. branch.roomName,
			corridorStart,
			branch.forward,
			CONFIG.corridor.length
		)

		local roomEntrance =
			corridorStart
			+ branch.forward * CONFIG.corridor.length

		if branch.name == "A" then
			generateRoomAConnectorHazards(corridor, corridorStart, branch.forward, CONFIG.corridor.length)
			buildRoomA(root, roomEntrance, branch.forward)
		elseif branch.name == "B" then
			buildBarredGate(
				root,
				"RoomB_LockGate",
				corridorStart + branch.forward * 5,
				branch.forward,
				CONFIG.corridor.width - 2,
				CONFIG.corridor.height - 2
			)

			buildRoomB(root, roomEntrance, branch.forward)
		elseif branch.name == "C" then
			buildBarredGate(
				root,
				"RoomC_LockGate",
				corridorStart + branch.forward * 5,
				branch.forward,
				CONFIG.corridor.width - 2,
				CONFIG.corridor.height - 2
			)

			buildRoomC(root, roomEntrance, branch.forward)
		end
	end

	print("[TrialChamberV2] Hub-and-spoke draft created safely.")
	print("[TrialChamberV2] Original Workspace.TrialChamber was not changed.")
end

main()
animateSwingingBlades()
