-- Pure set-dressing: nothing here is tagged or scripted. It exists so
-- the hall reads as a real, ancient, deadly place rather than a clean
-- test corridor -- cave-ins, broken supports, cracked floors, warning
-- carvings, and the remains of a trial-taker who didn't make it.

local function addCollapsedMasonry(parent, name, centerPosition, chunkCount, spreadRadius)
	local pile = newFolder(parent, name)

	for index = 1, chunkCount do
		local angle = random:NextNumber() * math.pi * 2
		local distance = random:NextNumber() * spreadRadius
		local size = 1.4 + random:NextNumber() * 2.2

		local offset = Vector3.new(math.cos(angle) * distance, size * 0.3, math.sin(angle) * distance)

		newPart({
			Name = "Block_" .. index,
			Size = Vector3.new(size, size * 0.65, size * 0.85),
			CFrame = CFrame.new(centerPosition + offset) * CFrame.Angles(
				random:NextNumber() * 0.5, random:NextNumber() * math.pi, random:NextNumber() * 0.5),
			Material = CONFIG.materials.wall,
			Color = CONFIG.colors.ancientStone,
			Parent = pile,
