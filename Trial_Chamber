local random = Random.new(20260802)

local function unitXZ(vector)
	local flat = Vector3.new(vector.X, 0, vector.Z)

	if flat.Magnitude == 0 then
		return Vector3.new(0, 0, -1)
	end

	return flat.Unit
end

local function getRight(forward)
	return Vector3.new(-forward.Z, 0, forward.X)
end

local function orientedCFrame(position, forward)
	forward = unitXZ(forward)

	local right = getRight(forward)

	return CFrame.fromMatrix(
		position,
		right,
		Vector3.new(0, 1, 0),
		-forward
	)
end

local function newFolder(parent, name)
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent

	return folder
end

local function newPart(properties)
	local part = Instance.new("Part")

	part.Name = properties.Name or "Part"
	part.Anchored = true
	part.CanCollide = properties.CanCollide ~= false
	part.CanQuery = properties.CanQuery ~= false
	part.CastShadow = properties.CastShadow ~= false

	part.Size = properties.Size
	part.CFrame = properties.CFrame

	part.Material = properties.Material or Enum.Material.SmoothPlastic
	part.Color = properties.Color or Color3.fromRGB(150, 150, 150)

	if properties.Shape then
		part.Shape = properties.Shape
	end

	if properties.Transparency then
		part.Transparency = properties.Transparency
	end

	part.Parent = properties.Parent

	return part
end

local function addGlow(part, color, range, brightness)
	local light = Instance.new("PointLight")

	light.Color = color
	light.Range = range or 16
	light.Brightness = brightness or 2
	light.Shadows = true
	light.Parent = part
end

local function addOrientedPart(parent, name, size, position, forward, material, color, options)
	options = options or {}

	return newPart({
		Name = name,
		Size = size,
		CFrame = orientedCFrame(position, forward),
		Material = material,
		Color = color,
		Transparency = options.Transparency,
		CanCollide = options.CanCollide,
		CanQuery = options.CanQuery,
		CastShadow = options.CastShadow,
		Parent = parent,
	})
end

local function getExistingChamberFloorPosition()
	local existing = Workspace:FindFirstChild("TrialChamber")

	if not existing then
		return Vector3.new(0, 0, 0)
	end

	local centralHub = existing:FindFirstChild("CentralHub")

	if centralHub then
		local floor = centralHub:FindFirstChild("Floor", true)

		if floor and floor:IsA("BasePart") then
			return Vector3.new(
				floor.Position.X,
				floor.Position.Y + floor.Size.Y / 2,
				floor.Position.Z
			)
		end

		local part = centralHub:FindFirstChildWhichIsA("BasePart", true)

		if part then
			return Vector3.new(
				part.Position.X,
				part.Position.Y + part.Size.Y / 2,
				part.Position.Z
			)
		end
	end

	local part = existing:FindFirstChildWhichIsA("BasePart", true)

	if part then
		return Vector3.new(
			part.Position.X,
			part.Position.Y + part.Size.Y / 2,
			part.Position.Z
		)
	end

	return Vector3.new(0, 0, 0)
end

----------------------------------------------------------------------
-- STRUCTURAL DETAIL HELPERS
----------------------------------------------------------------------
-- Cosmetic/geometric only: pilasters, trim bands, ceiling beams, wall
-- torches, rubble scatter, and a dome apex cap. These close seams,
-- dress corners, and add depth to the existing rooms without moving
-- any floor, wall, or doorway that gameplay already depends on.

local function addPilaster(parent, name, floorPosition, forward, height, material, color)
	local d = CONFIG.detail
	local mount = floorPosition + forward * d.pillarInset

	addOrientedPart(
		parent,
		name .. "_Base",
		Vector3.new(d.pillarSize + 0.6, 1, d.pillarSize + 0.6),
		mount + Vector3.new(0, 0.5, 0),
		forward,
		material,
		color
	)

	addOrientedPart(
		parent,
		name .. "_Shaft",
		Vector3.new(d.pillarSize, height - 2, d.pillarSize),
		mount + Vector3.new(0, height / 2, 0),
		forward,
		material,
		color
	)

	addOrientedPart(
		parent,
		name .. "_Capital",
		Vector3.new(d.pillarSize + 0.6, 1, d.pillarSize + 0.6),
		mount + Vector3.new(0, height - 0.5, 0),
		forward,
		material,
		color
	)
end

local function addCorniceBand(parent, name, floorPosition, forward, length, wallHeight, material, color)
	local d = CONFIG.detail

	return addOrientedPart(
		parent,
		name .. "_Cornice",
		Vector3.new(length, d.corniceHeight, 1),
		floorPosition
			+ forward * d.corniceProud
			+ Vector3.new(0, wallHeight - d.corniceDrop, 0),
		forward,
		material,
		color
	)
end

local function addBaseboardBand(parent, name, floorPosition, forward, length, material, color)
	local d = CONFIG.detail

	return addOrientedPart(
		parent,
		name .. "_Baseboard",
		Vector3.new(length, d.baseboardHeight, 1),
		floorPosition
			+ forward * d.baseboardProud
			+ Vector3.new(0, d.baseboardHeight / 2, 0),
		forward,
		material,
		color
	)
end

local function addCeilingBeam(parent, name, centerPosition, forward, span, ceilingHeight, material, color)
	local d = CONFIG.detail

	return addOrientedPart(
		parent,
		name .. "_Beam",
		Vector3.new(span, d.beamThickness, d.beamDepth),
		centerPosition + Vector3.new(0, ceilingHeight - d.beamDrop, 0),
		forward,
		material,
		color
	)
end

-- Lays ceiling beams every `detail.beamSpacing` studs along a straight run
-- (corridor or Room A hall) between startDistance and endDistance.
local function layCeilingBeams(parent, namePrefix, originPosition, forward, span, ceilingHeight, startDistance, endDistance, material, color)
	local spacing = CONFIG.detail.beamSpacing
	local index = 0
	local distance = startDistance + spacing / 2

	while distance < endDistance do
		index = index + 1

		addCeilingBeam(
			parent,
			namePrefix .. "_" .. index,
			originPosition + forward * distance,
			forward,
			span,
			ceilingHeight,
			material,
			color
		)

		distance = distance + spacing
	end
end

local function addWallTorch(parent, name, floorPosition, forward, mountHeight)
	local torch = newFolder(parent, name)

	addOrientedPart(
		torch,
		"Bracket",
		Vector3.new(0.6, 0.6, 1.4),
		floorPosition + forward * 0.3 + Vector3.new(0, mountHeight, 0),
		forward,
		CONFIG.materials.metal,
		CONFIG.colors.metal
	)

	addOrientedPart(
		torch,
		"Stick",
		Vector3.new(0.35, 2.2, 0.35),
		floorPosition + forward * 0.9 + Vector3.new(0, mountHeight + 0.9, 0),
		forward,
		CONFIG.materials.torchWood,
		CONFIG.colors.torchWood
	)

	local flame = newPart({
		Name = "Flame",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(0.9, 1.1, 0.9),
		CFrame = CFrame.new(floorPosition + forward * 0.9 + Vector3.new(0, mountHeight + 2.15, 0)),
		Material = CONFIG.materials.neon,
		Color = CONFIG.colors.torch,
		Transparency = 0.1,
		CanCollide = false,
		CanQuery = false,
		CastShadow = false,
		Parent = torch,
	})

	addGlow(flame, CONFIG.colors.torch, 14, 2.5)

	return torch
end

-- Lays wall torches every `detail.torchSpacing` studs along a straight run.
-- `wallOriginPosition` is a floor point on the wall's own line (already
-- offset to the side wall); `travelForward` spaces torches along that
-- line; `faceDirection` is the direction the torch faces into the room.
local function layWallTorches(parent, namePrefix, wallOriginPosition, travelForward, faceDirection, startDistance, endDistance)
	local spacing = CONFIG.detail.torchSpacing
	local index = 0
	local distance = startDistance + spacing / 2

	while distance < endDistance do
		index = index + 1

		addWallTorch(
			parent,
			namePrefix .. "_" .. index,
			wallOriginPosition + travelForward * distance,
			faceDirection,
			CONFIG.detail.torchHeight
		)

		distance = distance + spacing
	end
end

local function addRubblePile(parent, name, centerPosition, chunkCount, spreadRadius)
	local pile = newFolder(parent, name)

	for index = 1, chunkCount do
		local angle = random:NextNumber() * math.pi * 2
		local distance = random:NextNumber() * spreadRadius
		local size = 0.8 + random:NextNumber() * 1.6

		local offset = Vector3.new(
			math.cos(angle) * distance,
			size * 0.35,
			math.sin(angle) * distance
		)

		newPart({
			Name = "Chunk_" .. index,
			Size = Vector3.new(size, size * 0.7, size * 0.9),
			CFrame = CFrame.new(centerPosition + offset) * CFrame.Angles(
				random:NextNumber() * math.pi,
				random:NextNumber() * math.pi,
				random:NextNumber() * math.pi
			),
			Material = CONFIG.materials.rubble,
			Color = CONFIG.colors.rubble,
			Parent = pile,
		})
	end

	return pile
end

-- Closes the apex of a ring-built dome (buildDome) where the top ring's
-- panels converge toward a single point and would otherwise clip/overlap
-- instead of meeting cleanly.
local function addDomeCap(parent, centerPosition, wallHeight, domeHeight, material, color)
	local apexPosition = centerPosition + Vector3.new(0, wallHeight + domeHeight, 0)

	return newPart({
		Name = "DomeCap",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(2.8, 2.2, 2.8),
		CFrame = CFrame.new(apexPosition + Vector3.new(0, -0.35, 0)),
		Material = material,
		Color = color,
		Parent = parent,
	})
end

