local function buildDoorFrame(parent, name, floorPosition, forward, width, height, material, color)
	local folder = newFolder(parent, name)

	local right = getRight(forward)
	local postThickness = 1.5
	local postHeight = height
	local lintelHeight = 1.5

	local leftPosition =
		floorPosition
	- right * (width / 2 + postThickness / 2)
		+ Vector3.new(0, postHeight / 2, 0)

	local rightPosition =
		floorPosition
		+ right * (width / 2 + postThickness / 2)
		+ Vector3.new(0, postHeight / 2, 0)

	addOrientedPart(
		folder,
		"LeftPillar",
		Vector3.new(postThickness, postHeight, 2),
		leftPosition,
		forward,
		material,
		color
	)

	addOrientedPart(
		folder,
		"RightPillar",
		Vector3.new(postThickness, postHeight, 2),
		rightPosition,
		forward,
		material,
		color
	)

	addOrientedPart(
		folder,
		"Lintel",
		Vector3.new(width + postThickness * 2, lintelHeight, 2),
		floorPosition + Vector3.new(0, height - lintelHeight / 2, 0),
		forward,
		material,
		color
	)

	return folder
end

local function buildBarredGate(parent, name, floorPosition, forward, width, height)
	local folder = newFolder(parent, name)

	buildDoorFrame(
		folder,
		"StoneFrame",
		floorPosition,
		forward,
		width,
		height,
		CONFIG.materials.wall,
		CONFIG.colors.wall
	)

	local right = getRight(forward)
	local barCount = 9
	local usableWidth = width - 1
	local spacing = usableWidth / (barCount - 1)

	for index = 0, barCount - 1 do
		local sideOffset = -usableWidth / 2 + spacing * index

		addOrientedPart(
			folder,
			"Bar_" .. (index + 1),
			Vector3.new(0.55, height - 2, 0.55),
			floorPosition
				+ right * sideOffset
				+ Vector3.new(0, (height - 2) / 2 + 0.5, 0),
			forward,
			CONFIG.materials.metal,
			CONFIG.colors.metal
		)
	end

	addOrientedPart(
		folder,
		"Crossbar",
		Vector3.new(width, 0.65, 0.7),
		floorPosition + Vector3.new(0, height * 0.55, 0),
		forward,
		CONFIG.materials.metal,
		CONFIG.colors.metal
	)

	return folder
end

----------------------------------------------------------------------
-- CENTRAL HUB
----------------------------------------------------------------------

local function buildCentralHub(root, basePosition, branches)
	local hub = newFolder(root, "CentralHub")

	local radius = CONFIG.hub.radius
	local height = CONFIG.hub.height
	local thickness = CONFIG.hub.wallThickness
	local sideLength = 2 * radius * math.tan(math.pi / 8)
	local circumradius = radius / math.cos(math.pi / 8)

	newPart({
		Name = "HubFloor",
		Size = Vector3.new(
			CONFIG.hub.floorSize,
			1,
			CONFIG.hub.floorSize
		),
		CFrame = CFrame.new(basePosition + Vector3.new(0, -0.5, 0)),
		Material = CONFIG.materials.floor,
		Color = CONFIG.colors.floor,
		Parent = hub,
	})

	newPart({
		Name = "HubCeiling",
		Size = Vector3.new(
			CONFIG.hub.floorSize,
			1,
			CONFIG.hub.floorSize
		),
		CFrame = CFrame.new(basePosition + Vector3.new(0, height + 0.5, 0)),
		Material = CONFIG.materials.wall,
		Color = CONFIG.colors.wall,
		Parent = hub,
	})

	for index = 0, 7 do
		local angle = math.rad(index * 45)
		local normal = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local isOpening = false

		for _, branch in ipairs(branches) do
			if normal:Dot(branch.forward) > 0.97 then
				isOpening = true
				break
			end
		end

		if not isOpening then
			local wallFloorPosition = basePosition + normal * radius

			addOrientedPart(
				hub,
				"HubWall_" .. (index + 1),
				Vector3.new(sideLength + 1, height, thickness),
				wallFloorPosition + Vector3.new(0, height / 2, 0),
				normal,
				CONFIG.materials.wall,
				CONFIG.colors.wall
			)

			addCorniceBand(
				hub,
				"HubWall_" .. (index + 1),
				wallFloorPosition,
				normal,
				sideLength,
				height,
				CONFIG.materials.trim,
				CONFIG.colors.trim
			)

			addBaseboardBand(
				hub,
				"HubWall_" .. (index + 1),
				wallFloorPosition,
				normal,
				sideLength,
				CONFIG.materials.trim,
				CONFIG.colors.trim
			)

			addWallTorch(
				hub,
				"HubTorch_" .. (index + 1),
				basePosition + normal * (radius - 1.6),
				-normal,
				CONFIG.detail.torchHeight
			)
		end
	end

	-- Pilasters at every hub corner, including the corners flanking each
	-- branch opening, where they double as a jamb cap for the exposed
	-- wall-stub end instead of leaving it as a bare cross-section.
	for index = 0, 7 do
		local cornerAngle = math.rad((index + 0.5) * 45)
		local cornerNormal = Vector3.new(math.cos(cornerAngle), 0, math.sin(cornerAngle))
		local cornerPosition = basePosition + cornerNormal * circumradius

		addPilaster(
			hub,
			"HubPilaster_" .. (index + 1),
			cornerPosition,
			cornerNormal,
			height,
			CONFIG.materials.wall,
			CONFIG.colors.wall
		)
	end

	-- Door surrounds at each branch opening: the hub's opening span
	-- (~sideLength) is wider than a corridor mouth (corridor.width + 2
	-- walls), which otherwise leaves an undressed gap at the junction.
	-- Framing it here, at the same point corridors start from, resolves
	-- that transition without changing the corridor or hub footprint.
	for _, branch in ipairs(branches) do
		buildDoorFrame(
			hub,
			"HubOpening_" .. branch.name,
			basePosition + branch.forward * (radius - 1),
			branch.forward,
			CONFIG.corridor.width,
			height - 1,
			CONFIG.materials.wall,
			CONFIG.colors.wall
		)
	end

	local startMarker = newPart({
		Name = "DraftStartPoint",
		Size = Vector3.new(5, 0.25, 5),
		CFrame = CFrame.new(basePosition + Vector3.new(0, 0.15, 0)),
		Material = CONFIG.materials.neon,
		Color = CONFIG.colors.portal,
		Transparency = 0.45,
		CanCollide = false,
		CanQuery = false,
		Parent = hub,
	})

	addGlow(startMarker, CONFIG.colors.portal, 10, 1)

	return hub
end

