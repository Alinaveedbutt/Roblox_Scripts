		CONFIG.colors.wall
	)

	-- Structural polish: trim, beams, torches, corner pilasters, rubble.
	local leftWallOrigin = entrancePosition - right * (width / 2)
	local rightWallOrigin = entrancePosition + right * (width / 2)

	addCorniceBand(room, "WallLeft", leftWallOrigin, forward, length, height, CONFIG.materials.trim, CONFIG.colors.trim)
	addCorniceBand(room, "WallRight", rightWallOrigin, forward, length, height, CONFIG.materials.trim, CONFIG.colors.trim)
	addBaseboardBand(room, "WallLeft", leftWallOrigin, forward, length, CONFIG.materials.trim, CONFIG.colors.trim)
	addBaseboardBand(room, "WallRight", rightWallOrigin, forward, length, CONFIG.materials.trim, CONFIG.colors.trim)

	layCeilingBeams(room, "Beam", entrancePosition, forward, width, height, 0, length, CONFIG.materials.wall, CONFIG.colors.wall)
	layWallTorches(room, "TorchLeft", leftWallOrigin, forward, right, 0, length)
	layWallTorches(room, "TorchRight", rightWallOrigin, forward, -right, 0, length)

	-- Corner pilasters at the four room corners (entrance and exit ends).
	addPilaster(room, "CornerEntranceLeft", leftWallOrigin, forward, height, CONFIG.materials.wall, CONFIG.colors.wall)
	addPilaster(room, "CornerEntranceRight", rightWallOrigin, forward, height, CONFIG.materials.wall, CONFIG.colors.wall)
	addPilaster(room, "CornerExitLeft", leftWallOrigin + forward * length, forward, height, CONFIG.materials.wall, CONFIG.colors.wall)
	addPilaster(room, "CornerExitRight", rightWallOrigin + forward * length, forward, height, CONFIG.materials.wall, CONFIG.colors.wall)

	generateRoomAObstacleCourse(room, entrancePosition, forward, length, width, height)

	return room
end

