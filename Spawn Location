--[[
	FOREST SPAWN PLATFORM — procedural builder
	--------------------------------------------
	Recreates the concept art: a tiered stone plaza, six pillars (alternating
	glowing rune markers), a stepped entrance, a glowing center disc + beam,
	scattered rocks, and (optionally) a small forest clearing around it.

	HOW TO USE
	1) Paste this whole script into a Script inside ServerScriptService,
	   OR paste it into the Studio Command Bar for an instant one-off build.
	2) Run it once. Everything is built under workspace inside a folder
	   named "ForestSpawnPlatform".
	3) Edit CONFIG below to change size, stone colors, pillar count, beam
	   color, or whether the ground/path/trees get built at all.
	4) To rebuild, delete the "ForestSpawnPlatform" folder in workspace and
	   run the script again — everything this script makes (including the
	   ground/trees) lives under that one folder, so this always fully
	   resets it.

	NOTE: the reference is AI concept art, not a 3D model, so there's no
	exact mesh to copy — this reconstructs it from scratch as real,
	game-ready Roblox parts, matching the composition as closely as a
	script reasonably can.

	REVISION 2 NOTES
	- Root cause of the green-tinted, glassy-looking pillars in the last
	  screenshot: the center disc's PointLight (Range 24) and each rune's
	  PointLight were bright/wide enough to flood the whole plaza, since
	  the pillars sit well within that range. Both are turned way down
	  below, so stone reads as stone again instead of glowing green glass.
	- Pillars were also standing at ground level (Y=0) even though their
	  ring (PillarRadius) sits on a raised tier — meaning a chunk of every
	  pillar's height was buried in the tier below it, including the rune
	  in some configs. buildPillars now looks up the actual tier height at
	  PillarRadius and stands on top of it.
	- Pillar taper was too aggressive combined with per-segment rotation
	  jitter, which read as jagged crystal shards rather than chunky
	  standing stones. Segments are wider now and jitter is more subtle.
	- Added: moss accents at pillar bases and the outer tier rim, rounder
	  boulders (rocks now use a sphere mesh instead of plain boxes), and an
	  optional forest clearing — grass patch, a winding dirt path off the
	  entrance, and a scatter of simple low-poly pine props — since a big
	  part of the reference's look is the forest it sits in, not just the
	  stonework. Set CONFIG.BuildEnvironment = false to skip that part.
]]

local CONFIG = {
	Origin          = Vector3.new(0, 0, 0),              -- world position of the platform's ground center
	PlatformRadius  = 22,                                 -- outer radius of the paved circle
	RingCount       = 4,                                  -- number of concentric stepped tiers
	RingHeight      = 0.6,                                -- height of each tier
	CenterHeight    = 2.4,                                -- how much higher the center disc sits above the tiers
	PillarCount     = 6,
	PillarRadius    = 17,                                 -- distance of pillars from center
	PillarHeight    = 9,
	GlowPillarEvery = 2,                                  -- every Nth pillar (0-indexed) gets a glowing rune
	BeamColor       = Color3.fromRGB(80, 255, 120),       -- green beam. Try Color3.fromRGB(80, 200, 255) for blue.
	StoneColorLight = Color3.fromRGB(165, 165, 158),
	StoneColorDark  = Color3.fromRGB(108, 110, 104),
	GroutColor      = Color3.fromRGB(35, 38, 34),         -- dark radial dividing lines cut into the paving
	SpokeCount      = 20,                                 -- how many radial grout lines run across the plaza
	StepCount       = 5,
	StepDirection   = Vector3.new(0, 0, 1),               -- which side the staircase (and path) face (default: south, +Z)
	RockCount       = 14,
	MossColor       = Color3.fromRGB(74, 98, 58),

	SetupLighting   = true,                               -- if true, the script fixes your place's Lighting so stone isn't black

	-- forest clearing around the platform (grass patch, dirt path, trees)
	BuildEnvironment = true,
	GroundPadding    = 26,                                -- how far past PlatformRadius the grass patch extends
	GroundColor      = Color3.fromRGB(58, 84, 46),
	PathColor        = Color3.fromRGB(107, 84, 55),
	PathLength       = 34,
	PathWidth        = 7,
	TreeCount        = 14,
	TreeMinDistance  = 28,
	TreeMaxDistance  = 44,
	TrunkColor       = Color3.fromRGB(59, 42, 30),
	CanopyColor      = Color3.fromRGB(42, 68, 38),
}

-- ============================================================
-- HELPERS
-- ============================================================

local function newPart(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.Material = Enum.Material.Slate
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in pairs(props) do
		p[key] = value
	end
	return p
end

-- rotate a (Y-up) direction vector around the vertical axis by `angle` radians
local function rotateY(vec, angle)
	local c, s = math.cos(angle), math.sin(angle)
	return Vector3.new(vec.X * c - vec.Z * s, vec.Y, vec.X * s + vec.Z * c)
end

-- given the ring data from buildTiers(), find the top height of whichever
-- tier a given radius physically sits on (so things placed at that radius
-- stand ON the step instead of floating above it or burying into it)
local function tierHeightAtRadius(tiersData, radius)
	for _, band in ipairs(tiersData) do
		if radius <= band.bandOuter + 0.001 and radius >= band.bandInner - 0.001 then
			return band.topY
		end
	end
	if radius > tiersData[1].bandOuter then
		return tiersData[1].topY
	end
	return tiersData[#tiersData].topY
end

local root = Instance.new("Folder")
root.Name = "ForestSpawnPlatform"
root.Parent = workspace

-- ============================================================
-- CONCENTRIC STONE TIERS ("wedding cake" rings)
-- ============================================================

local function buildTiers()
	local tiersFolder = Instance.new("Folder")
	tiersFolder.Name = "PlatformTiers"
	tiersFolder.Parent = root

	local innerRadius = CONFIG.PlatformRadius * 0.22
	local ringCount = CONFIG.RingCount
	local radiusStep = (CONFIG.PlatformRadius - innerRadius) / ringCount
	local tiersData = {}

	for i = 0, ringCount - 1 do
		local ringRadius = CONFIG.PlatformRadius - (i * radiusStep)
		local ringHeight = (i + 1) * CONFIG.RingHeight -- stacks from ground up to this tier's top
		local color = (i % 2 == 0) and CONFIG.StoneColorLight or CONFIG.StoneColorDark

		newPart({
			Name = "Tier_" .. i,
			Shape = Enum.PartType.Cylinder,
			Material = Enum.Material.Concrete,
			Size = Vector3.new(ringHeight, ringRadius * 2, ringRadius * 2),
			CFrame = CFrame.new(CONFIG.Origin.X, CONFIG.Origin.Y + ringHeight / 2, CONFIG.Origin.Z)
				* CFrame.Angles(0, 0, math.rad(90)),
			Color = color,
			Parent = tiersFolder,
		})

		tiersData[#tiersData + 1] = {
			bandOuter = ringRadius,
			bandInner = ringRadius - radiusStep,
			topY = CONFIG.Origin.Y + ringHeight,
		}
	end

	return tiersData, innerRadius, ringCount * CONFIG.RingHeight
end

-- Radial "cut stone" dividing lines running across every tier, aligned so
-- they read as continuous spokes from the center out to the edge.
local function buildGrout(tiersData)
	local groutFolder = Instance.new("Folder")
	groutFolder.Name = "Grout"
	groutFolder.Parent = root

	local spokeCount = CONFIG.SpokeCount
	for k = 0, spokeCount - 1 do
		local theta = (k / spokeCount) * math.pi * 2
		local dir = Vector3.new(math.cos(theta), 0, math.sin(theta))

		for _, band in ipairs(tiersData) do
			local bandWidth = band.bandOuter - band.bandInner
			local bandMid = (band.bandOuter + band.bandInner) / 2
			local pos = CONFIG.Origin + dir * bandMid + Vector3.new(0, band.topY + 0.03, 0)
			local cf = CFrame.lookAt(pos, pos + dir)

			newPart({
				Name = "Spoke",
				Size = Vector3.new(0.15, 0.05, bandWidth * 0.94),
				CFrame = cf,
				Color = CONFIG.GroutColor,
				Material = Enum.Material.Concrete,
				CanCollide = false,
				Parent = groutFolder,
			})
		end
	end
end

-- ============================================================
-- RAISED CENTER DISC + GLOWING RING PATTERN
-- ============================================================

local function buildCenterDisc(innerRadius, tierTopHeight)
	local centerFolder = Instance.new("Folder")
	centerFolder.Name = "CenterDisc"
	centerFolder.Parent = root

	local baseHeight = tierTopHeight + CONFIG.CenterHeight

	newPart({
		Name = "CenterBase",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(baseHeight, innerRadius * 2, innerRadius * 2),
		CFrame = CFrame.new(CONFIG.Origin.X, CONFIG.Origin.Y + baseHeight / 2, CONFIG.Origin.Z)
			* CFrame.Angles(0, 0, math.rad(90)),
		Color = CONFIG.StoneColorDark,
		Parent = centerFolder,
	})

	local topY = CONFIG.Origin.Y + baseHeight + 0.05

	newPart({
		Name = "GlowRingOuter",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.1, innerRadius * 1.6, innerRadius * 1.6),
		CFrame = CFrame.new(CONFIG.Origin.X, topY, CONFIG.Origin.Z) * CFrame.Angles(0, 0, math.rad(90)),
		Material = Enum.Material.Neon,
		Color = CONFIG.BeamColor,
		CanCollide = false,
		Parent = centerFolder,
	})

	local innerGlow = newPart({
		Name = "GlowRingInner",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.12, innerRadius * 0.8, innerRadius * 0.8),
		CFrame = CFrame.new(CONFIG.Origin.X, topY + 0.02, CONFIG.Origin.Z) * CFrame.Angles(0, 0, math.rad(90)),
		Material = Enum.Material.Neon,
		Color = CONFIG.BeamColor,
		CanCollide = false,
		Parent = centerFolder,
	})

	-- Kept deliberately modest: this used to be Range 24 / Brightness 3,
	-- which reached all the way out to the pillars (PillarRadius 17) and
	-- washed the whole plaza green. This still gives the center a nice
	-- glow without floodlighting everything around it.
	local light = Instance.new("PointLight")
	light.Color = CONFIG.BeamColor
	light.Range = 12
	light.Brightness = 1.2
	light.Parent = innerGlow

	-- compass-style tick marks radiating just past the inner glow ring
	for k = 0, 7 do
		local angle = k * (math.pi / 4)
		local dir = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local pos = CONFIG.Origin + dir * (innerRadius * 0.9) + Vector3.new(0, topY + 0.03, 0)
		local cf = CFrame.lookAt(pos, pos + dir)

		newPart({
			Name = "ReticleTick",
			Size = Vector3.new(0.12, 0.05, innerRadius * 0.4),
			CFrame = cf,
			Material = Enum.Material.Neon,
			Color = CONFIG.BeamColor,
			CanCollide = false,
			Parent = centerFolder,
		})
	end

	return topY
end

-- ============================================================
-- VERTICAL LIGHT BEAM
-- ============================================================

local function buildBeam(topY)
	local beamHeight = 40
	local centerY = topY + beamHeight / 2

	-- soft wide haze first (so the thin core reads as bright against it, not blown out)
	newPart({
		Name = "SpawnBeamGlow",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(beamHeight, 1.6, 1.6),
		CFrame = CFrame.new(CONFIG.Origin.X, centerY, CONFIG.Origin.Z) * CFrame.Angles(0, 0, math.rad(90)),
		Material = Enum.Material.Neon,
		Color = CONFIG.BeamColor,
		Transparency = 0.82,
		CanCollide = false,
		Parent = root,
	})

	-- thin bright core
	local core = newPart({
		Name = "SpawnBeamCore",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(beamHeight, 0.35, 0.35),
		CFrame = CFrame.new(CONFIG.Origin.X, centerY, CONFIG.Origin.Z) * CFrame.Angles(0, 0, math.rad(90)),
		Material = Enum.Material.Neon,
		Color = CONFIG.BeamColor,
		Transparency = 0.15,
		CanCollide = false,
		Parent = root,
	})

	local sparkles = Instance.new("ParticleEmitter")
	sparkles.Color = ColorSequence.new(CONFIG.BeamColor)
	sparkles.Size = NumberSequence.new(0.15)
	sparkles.Lifetime = NumberRange.new(1, 2)
	sparkles.Rate = 20
	sparkles.Speed = NumberRange.new(2, 4)
	sparkles.SpreadAngle = Vector2.new(5, 5)
	sparkles.Parent = core
end

-- ============================================================
-- ENTRANCE STEPS
-- ============================================================

local function buildSteps(tierTopHeight)
	local stepsFolder = Instance.new("Folder")
	stepsFolder.Name = "Steps"
	stepsFolder.Parent = root

	local stepCount = CONFIG.StepCount
	local stepHeight = tierTopHeight / stepCount
	local stepDepth = 2
	local dir = CONFIG.StepDirection.Unit
	local up = Vector3.new(0, 1, 0)

	local right = up:Cross(dir)
	if right.Magnitude < 1e-4 then
		right = Vector3.new(1, 0, 0)
	else
		right = right.Unit
	end

	for i = 1, stepCount do
		local stepY = CONFIG.Origin.Y + (i - 0.5) * stepHeight
		local distance = CONFIG.PlatformRadius + (stepCount - i) * stepDepth
		local width = 8 + (stepCount - i) * 1.2

		local pos = CONFIG.Origin + dir * distance
		local cf = CFrame.fromMatrix(Vector3.new(pos.X, stepY, pos.Z), right, up)

		newPart({
			Name = "Step_" .. i,
			Size = Vector3.new(width, stepHeight, stepDepth),
			CFrame = cf,
			Color = (i % 2 == 0) and CONFIG.StoneColorLight or CONFIG.StoneColorDark,
			Parent = stepsFolder,
		})
	end
end

-- ============================================================
-- ENVIRONMENT DRESSING (ground, path, simple pine trees)
-- ============================================================
-- Optional (CONFIG.BuildEnvironment). The concept art shows the platform
-- sitting in an actual forest clearing — a blank grey baseplate can't get
-- you that on its own. This adds a simple, fully-removable stand-in: a
-- grass patch under/around the platform, a winding dirt path leading out
-- from the entrance, and a scatter of low-poly pine props. Everything is
-- parented under the same root Folder as the rest of the build, so
-- deleting ForestSpawnPlatform and re-running still cleans up in one go.

local function buildEnvironment()
	if not CONFIG.BuildEnvironment then
		return
	end

	local envFolder = Instance.new("Folder")
	envFolder.Name = "Environment"
	envFolder.Parent = root

	local groundThickness = 0.4
	local groundCenterY = CONFIG.Origin.Y + 0.05
	local groundTopY = groundCenterY + groundThickness / 2

	-- grass clearing, sitting just above ground level so it overlays
	-- whatever's already in the workspace (e.g. Studio's default grey
	-- Baseplate) instead of getting buried underneath it
	local groundRadius = CONFIG.PlatformRadius + CONFIG.GroundPadding
	newPart({
		Name = "GrassGround",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(groundThickness, groundRadius * 2, groundRadius * 2),
		CFrame = CFrame.new(CONFIG.Origin.X, groundCenterY, CONFIG.Origin.Z) * CFrame.Angles(0, 0, math.rad(90)),
		Material = Enum.Material.Grass,
		Color = CONFIG.GroundColor,
		Parent = envFolder,
	})

	-- dirt path leading away from the entrance steps, built from a few
	-- slightly-wobbled segments so it reads as a trail, not a sidewalk
	local dir = CONFIG.StepDirection.Unit
	local pathY = groundTopY + 0.05
	local segments = 4
	local segLength = CONFIG.PathLength / segments
	local heading = dir
	local cursor = Vector3.new(CONFIG.Origin.X, pathY, CONFIG.Origin.Z) + dir * (CONFIG.PlatformRadius + 1.5)

	for s = 1, segments do
		heading = rotateY(heading, math.rad(math.random(-10, 10)))
		local center = cursor + heading * (segLength / 2)
		local width = CONFIG.PathWidth * (1 - (s / segments) * 0.3)

		newPart({
			Name = "PathSegment_" .. s,
			Size = Vector3.new(width, 0.2, segLength * 1.15),
			CFrame = CFrame.lookAt(center, center + heading),
			Material = Enum.Material.Ground,
			Color = CONFIG.PathColor,
			CanCollide = false,
			Parent = envFolder,
		})

		cursor = cursor + heading * segLength
	end

	-- simple low-poly pine props scattered around the clearing, kept out
	-- of the entrance sightline so the path in stays open
	local pathAngle = math.atan2(dir.Z, dir.X)
	local treesFolder = Instance.new("Folder")
	treesFolder.Name = "Trees"
	treesFolder.Parent = envFolder

	local attempts = 0
	local placed = 0
	while placed < CONFIG.TreeCount and attempts < CONFIG.TreeCount * 6 do
		attempts = attempts + 1
		local treeAngle = math.random() * math.pi * 2
		local rawDelta = math.atan2(math.sin(treeAngle - pathAngle), math.cos(treeAngle - pathAngle))

		if math.abs(rawDelta) > math.rad(20) then
			local distance = CONFIG.TreeMinDistance + math.random() * (CONFIG.TreeMaxDistance - CONFIG.TreeMinDistance)
			local tx = CONFIG.Origin.X + math.cos(treeAngle) * distance
			local tz = CONFIG.Origin.Z + math.sin(treeAngle) * distance
			local trunkHeight = 3.5 + math.random() * 2
			local scale = 0.8 + math.random() * 0.6

			newPart({
				Name = "Trunk",
				Size = Vector3.new(0.8 * scale, trunkHeight, 0.8 * scale),
				CFrame = CFrame.new(tx, groundTopY + trunkHeight / 2, tz),
				Material = Enum.Material.Wood,
				Color = CONFIG.TrunkColor,
				Parent = treesFolder,
			})

			local canopySizes = { 6, 4.4, 3 }
			local layerY = groundTopY + trunkHeight * 0.55
			for layer, baseSize in ipairs(canopySizes) do
				local size = baseSize * scale
				local blob = newPart({
					Name = "Canopy_" .. layer,
					Size = Vector3.new(size, size, size),
					CFrame = CFrame.new(tx, layerY, tz),
					Material = Enum.Material.Grass,
					Color = CONFIG.CanopyColor,
					CanCollide = false,
					Parent = treesFolder,
				})
				local mesh = Instance.new("SpecialMesh")
				mesh.MeshType = Enum.MeshType.Sphere
				mesh.Scale = Vector3.new(1, 1.15, 1)
				mesh.Parent = blob

				layerY = layerY + size * 0.45
			end

			placed = placed + 1
		end
	end
end

-- ============================================================
-- PILLARS (tapered, weathered stone + inlaid glowing runes)
-- ============================================================

local function buildPillars(tiersData)
	local pillarsFolder = Instance.new("Folder")
	pillarsFolder.Name = "Pillars"
	pillarsFolder.Parent = root

	-- pillars stand on whichever tier step their ring actually lands on,
	-- not on the ground at Y=0 (which used to bury part of every pillar,
	-- runes included, inside the tier below it)
	local baseY = tierHeightAtRadius(tiersData, CONFIG.PillarRadius)

	local count = CONFIG.PillarCount
	for i = 0, count - 1 do
		local angle = (i / count) * math.pi * 2
		local x = CONFIG.Origin.X + math.cos(angle) * CONFIG.PillarRadius
		local z = CONFIG.Origin.Z + math.sin(angle) * CONFIG.PillarRadius

		-- per-pillar variance so the ring doesn't read as six copy-pasted
		-- blocks — the reference pillars are clearly hand-placed/irregular.
		-- Kept subtle on purpose: too much jitter reads as broken glass
		-- shards instead of standing stones.
		local heightJitter = 0.85 + math.random() * 0.3   -- 0.85 - 1.15x
		local widthJitter  = 0.85 + math.random() * 0.25  -- 0.85 - 1.10x
		local leanAngle    = math.rad(math.random(-2, 2)) -- tiny natural lean

		local totalHeight = CONFIG.PillarHeight * heightJitter

		-- orient once per pillar: sit at (x, baseY, z), yaw to face the
		-- center (so runes always point inward), plus a hair of roll for
		-- the lean. Every segment below stacks off of this.
		local orient = CFrame.lookAt(
			Vector3.new(x, baseY, z),
			Vector3.new(CONFIG.Origin.X, baseY, CONFIG.Origin.Z)
		) * CFrame.Angles(0, 0, leanAngle)

		-- three stacked, gently tapering segments = a chunky standing
		-- stone instead of one extruded box. Widths are close together on
		-- purpose (a hard taper is what made these read as spikes before).
		local segWidths = { 3.4, 3.0, 2.5 } -- base -> cap
		local segCount = #segWidths
		local segHeight = totalHeight / segCount
		local cursorY = 0

		for seg = 1, segCount do
			local w = segWidths[seg] * widthJitter
			local jitterYaw = math.rad(math.random(-2, 2))
			local segCFrame = orient
				* CFrame.new(0, cursorY + segHeight / 2, 0)
				* CFrame.Angles(0, jitterYaw, 0)

			newPart({
				Name = "Pillar_" .. i .. "_Seg" .. seg,
				Size = Vector3.new(w, segHeight, w),
				CFrame = segCFrame,
				Material = Enum.Material.Rock,
				Color = (seg == 1) and CONFIG.StoneColorDark or CONFIG.StoneColorLight,
				Parent = pillarsFolder,
			})

			cursorY = cursorY + segHeight
		end

		-- small chipped/broken cap so the silhouette isn't a flat rectangle
		local capW = segWidths[segCount] * widthJitter * 0.9
		newPart({
			Name = "Pillar_" .. i .. "_Cap",
			Size = Vector3.new(capW, 0.7, capW),
			CFrame = orient * CFrame.new(0, totalHeight + 0.25, 0)
				* CFrame.Angles(math.rad(math.random(-5, 5)), math.rad(math.random(0, 360)), math.rad(math.random(-5, 5))),
			Material = Enum.Material.Rock,
			Color = CONFIG.StoneColorLight,
			Parent = pillarsFolder,
		})

		if i % CONFIG.GlowPillarEvery == 0 then
			-- rune sits in the lower-middle of the base segment, flush
			-- against its front face (the face pointing at the center)
			local halfWidth = (segWidths[1] * widthJitter) / 2
			local runeHeight = segHeight * 0.55
			local faceCFrame = orient * CFrame.new(0, runeHeight, -halfWidth - 0.02)

			-- shallow carved recess behind the rune (smoother/darker than
			-- the rough stone around it, like a polished, cut panel)
			newPart({
				Name = "Pillar_" .. i .. "_Panel",
				Size = Vector3.new(0.9, 1.9, 0.1),
				CFrame = faceCFrame * CFrame.new(0, 0, 0.02),
				Material = Enum.Material.Slate,
				Color = CONFIG.StoneColorDark,
				CanCollide = false,
				Parent = pillarsFolder,
			})

			-- the rune itself: a flattened, elongated "leaf/eye" shape
			-- sitting almost flush against the panel (not a floating gem)
			local gem = newPart({
				Name = "Pillar_" .. i .. "_Rune",
				Size = Vector3.new(1, 1, 1),
				CFrame = faceCFrame * CFrame.new(0, 0, -0.02),
				Material = Enum.Material.Neon,
				Color = CONFIG.BeamColor,
				CanCollide = false,
				Parent = pillarsFolder,
			})
			local gemMesh = Instance.new("SpecialMesh")
			gemMesh.MeshType = Enum.MeshType.Sphere
			gemMesh.Scale = Vector3.new(0.34, 0.7, 0.12)
			gemMesh.Parent = gem

			-- thin vertical "vein" poking past the top/bottom of the eye
			-- shape — reads as a leaf spine/stem, matching the reference art
			newPart({
				Name = "Pillar_" .. i .. "_RuneVein",
				Size = Vector3.new(0.05, 1.5, 0.05),
				CFrame = faceCFrame * CFrame.new(0, 0, -0.02),
				Material = Enum.Material.Neon,
				Color = CONFIG.BeamColor,
				CanCollide = false,
				Parent = pillarsFolder,
			})

			-- much dimmer/tighter than before — this was the other big
			-- source of the green wash, since it used to be Range 6 /
			-- Brightness 1.4 sitting right against the pillar's own stone
			local runeLight = Instance.new("PointLight")
			runeLight.Color = CONFIG.BeamColor
			runeLight.Range = 4
			runeLight.Brightness = 0.8
			runeLight.Parent = gem
		end
	end
end

-- ============================================================
-- MOSS ACCENTS
-- ============================================================
-- Small green patches at the pillar bases and around the outer tier rim,
-- echoing the moss climbing the stone in the reference art.

local function buildMoss(tiersData)
	local mossFolder = Instance.new("Folder")
	mossFolder.Name = "Moss"
	mossFolder.Parent = root

	local function mossBlob(pos, size)
		local blob = newPart({
			Name = "Moss",
			Size = Vector3.new(size, size * 0.35, size),
			CFrame = CFrame.new(pos),
			Material = Enum.Material.Grass,
			Color = CONFIG.MossColor,
			CanCollide = false,
			Parent = mossFolder,
		})
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = blob
	end

	-- rim of the outer tier
	local outer = tiersData[1]
	for _ = 1, 12 do
		local theta = math.random() * math.pi * 2
		local dist = outer.bandInner + math.random() * (outer.bandOuter - outer.bandInner)
		local pos = CONFIG.Origin + Vector3.new(math.cos(theta) * dist, outer.topY + 0.05, math.sin(theta) * dist)
		mossBlob(pos, 0.8 + math.random() * 1.2)
	end

	-- pillar bases
	local pillarBaseY = tierHeightAtRadius(tiersData, CONFIG.PillarRadius)
	local count = CONFIG.PillarCount
	for i = 0, count - 1 do
		local angle = (i / count) * math.pi * 2
		local x = CONFIG.Origin.X + math.cos(angle) * CONFIG.PillarRadius
		local z = CONFIG.Origin.Z + math.sin(angle) * CONFIG.PillarRadius
		for _ = 1, 2 do
			local jitterAngle = math.random() * math.pi * 2
			local jitterDist = 1.4 + math.random()
			local pos = Vector3.new(
				x + math.cos(jitterAngle) * jitterDist,
				pillarBaseY + 0.05,
				z + math.sin(jitterAngle) * jitterDist
			)
			mossBlob(pos, 1 + math.random())
		end
	end
end

-- ============================================================
-- SCATTERED ROCKS
-- ============================================================

local function buildRocks()
	local rocksFolder = Instance.new("Folder")
	rocksFolder.Name = "Rocks"
	rocksFolder.Parent = root

	local rockColors = { CONFIG.StoneColorLight, CONFIG.StoneColorDark, Color3.fromRGB(90, 100, 80) }

	for i = 1, CONFIG.RockCount do
		local angle = math.random() * math.pi * 2
		local distance = CONFIG.PlatformRadius + math.random(4, 14)
		local x = CONFIG.Origin.X + math.cos(angle) * distance
		local z = CONFIG.Origin.Z + math.sin(angle) * distance
		local size = math.random(15, 40) / 10

		local rockCluster = Instance.new("Model")
		rockCluster.Name = "Rock_" .. i
		rockCluster.Parent = rocksFolder

		for _ = 1, math.random(2, 4) do
			local chunk = newPart({
				Name = "Chunk",
				Size = Vector3.new(
					size * (0.6 + math.random() * 0.5),
					size * (0.5 + math.random() * 0.5),
					size * (0.6 + math.random() * 0.5)
				),
				CFrame = CFrame.new(
					x + math.random(-10, 10) / 10,
					CONFIG.Origin.Y + size / 2,
					z + math.random(-10, 10) / 10
				) * CFrame.Angles(math.random(), math.random(), math.random()),
				Color = rockColors[math.random(1, #rockColors)],
				Material = Enum.Material.Rock,
				Parent = rockCluster,
			})

			-- rounds the boxy chunk into a boulder-ish blob instead of a
			-- sharp-edged crate
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Sphere
			mesh.Parent = chunk
		end
	end
end

-- ============================================================
-- LIGHTING FIX
-- ============================================================
-- If your place's Lighting.Ambient/Brightness are too low, every non-Neon
-- part renders almost pure black. This brings it up to a normal daylight
-- forest look. If you already have your own lighting/atmosphere set up,
-- set CONFIG.SetupLighting = false to skip this entirely.

local function setupLighting()
	local Lighting = game:GetService("Lighting")

	-- Each property is set individually inside its own pcall: some Lighting
	-- properties (like Technology) are restricted to Studio/plugin context
	-- and will error out of a normal Script. If one is blocked, we just skip
	-- it instead of letting it crash the whole build.
	pcall(function() Lighting.Ambient = Color3.fromRGB(100, 100, 98) end)
	pcall(function() Lighting.OutdoorAmbient = Color3.fromRGB(140, 140, 132) end)
	pcall(function() Lighting.Brightness = 2 end)
	pcall(function() Lighting.ClockTime = 14.5 end)
	pcall(function() Lighting.GlobalShadows = true end)

	pcall(function()
		local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
		if not atmosphere then
			atmosphere = Instance.new("Atmosphere")
			atmosphere.Parent = Lighting
		end
		-- Kept light and close to neutral on purpose. A dense, saturated
		-- Haze/Color combo recolors everything in the scene that color, not
		-- just distant objects.
		atmosphere.Density = 0.15
		atmosphere.Haze = 0.3
		atmosphere.Color = Color3.fromRGB(200, 205, 195)
		atmosphere.Decay = Color3.fromRGB(150, 155, 145)
	end)
end

