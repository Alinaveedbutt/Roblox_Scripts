local function buildSpawnLocation(topY)
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "ForestSpawn"
	spawn.Shape = Enum.PartType.Cylinder
	spawn.Size = Vector3.new(0.2, 8, 8)
	spawn.CFrame = CFrame.new(CONFIG.Origin.X, topY + 0.1, CONFIG.Origin.Z) * CFrame.Angles(0, 0, math.rad(90))
	spawn.Anchored = true
	spawn.CanCollide = true
	spawn.Transparency = 1
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.BottomSurface = Enum.SurfaceType.Smooth
	spawn.Parent = root
end

