local ClearanceChamber = {}
function ClearanceChamber.build(parent)
	local folder = GeometryCore.newFolder(parent, "ClearanceChamber")
	local zStart = MapManager.rooms.ClearanceChamber.zStart
	local zEnd = MapManager.rooms.ClearanceChamber.zEnd
	local length = zEnd - zStart
	local width = MapManager.rooms.ClearanceChamber.width
	local height = MapManager.rooms.ClearanceChamber.height
	local roomAWidth = CONFIG.roomA.width
	local gateWidth = MapManager.rooms.GateAB.width

	local roomY = MapManager.rooms.ClearanceChamber.y or 0
	local pos = Vector3.new(0, roomY, zStart)
	local fwd = Vector3.new(0, 0, 1)
	local right = Vector3.new(1, 0, 0)

	local function p(n, s, c, m, col)
		local pt = Instance.new("Part"); pt.Name = n; pt.Size = s; pt.CFrame = c; pt.Anchored = true
		pt.Material = m; pt.Color = col; pt.Parent = folder; GeometryCore.incrementCount("structural"); return pt
	end

	-- Floor (Distinct patterned threshold)
	p("FloorBase", Vector3.new(width, 2, length), CFrame.new(0, roomY - 1, zStart + length/2), Enum.Material.Cobblestone, COLOR.floor)
	p("FloorTrim", Vector3.new(width - 2, 0.2, length - 2), CFrame.new(0, roomY + 0.1, zStart + length/2), Enum.Material.Slate, COLOR.trim)

	-- Left and Right Side Walls
	p("LeftWall", Vector3.new(4, height, length), CFrame.new(-width/2 - 2, roomY + height/2, zStart + length/2), Enum.Material.Cobblestone, COLOR.wall)
	p("RightWall", Vector3.new(4, height, length), CFrame.new(width/2 + 2, roomY + height/2, zStart + length/2), Enum.Material.Cobblestone, COLOR.wall)

	-- Architectural Framing (Thick stone pillars to define the space)
	local numPillars = 3
	for i = 0, numPillars - 1 do
		-- Space pillars evenly, but keep them slightly away from the exact edge so they don't clip awkwardly
		local pz = zStart + 2 + (length - 4) * (i / (numPillars - 1))
		p("PillarL_"..i, Vector3.new(3, height, 4), CFrame.new(-width/2 + 1.5, roomY + height/2, pz), Enum.Material.Rock, COLOR.foundation)
		p("PillarR_"..i, Vector3.new(3, height, 4), CFrame.new(width/2 - 1.5, roomY + height/2, pz), Enum.Material.Rock, COLOR.foundation)

		-- Overhead support beam to visually compress the ceiling
		p("CeilingBeam_"..i, Vector3.new(width, 3, 4), CFrame.new(0, roomY + height - 1.5, pz), Enum.Material.Rock, COLOR.foundation)
	end

	-- Ceiling
	p("Ceiling", Vector3.new(width + 8, 2, length), CFrame.new(0, roomY + height + 1, zStart + length/2), Enum.Material.Cobblestone, Color3.fromRGB(115, 118, 125))

	-- Front Wall (Connecting Room A to Clearance Chamber)
	local frontWallWidth = (width - roomAWidth) / 2
	if frontWallWidth > 0 then
		p("FrontWallL", Vector3.new(frontWallWidth, height, 4), CFrame.new(-roomAWidth/2 - frontWallWidth/2, height/2, zStart + 2), Enum.Material.Cobblestone, COLOR.wall)
		p("FrontWallR", Vector3.new(frontWallWidth, height, 4), CFrame.new(roomAWidth/2 + frontWallWidth/2, height/2, zStart + 2), Enum.Material.Cobblestone, COLOR.wall)
	elseif frontWallWidth < 0 then
		p("FrontWallL", Vector3.new(-frontWallWidth, height, 4), CFrame.new(-width/2 + frontWallWidth/2, height/2, zStart - 2), Enum.Material.Cobblestone, COLOR.wall)
		p("FrontWallR", Vector3.new(-frontWallWidth, height, 4), CFrame.new(width/2 - frontWallWidth/2, height/2, zStart - 2), Enum.Material.Cobblestone, COLOR.wall)
	end

	-- Room A sits at Y=0 with a 24-stud ceiling; this chamber is raised by roomY.
	-- Equal wall *heights* still leave a void above the Room A lintel unless we
	-- fill from Room A's roof up to this chamber's ceiling.
	local roomACeilingY = 24
	local ccCeilingY = roomY + height
	local ceilingGap = ccCeilingY - roomACeilingY
	if ceilingGap > 0.05 then
		local overlap = 1
		p("FrontWallTop", Vector3.new(roomAWidth, ceilingGap + overlap, 4), CFrame.new(0, roomACeilingY + ceilingGap / 2 - overlap / 2, zStart + 2), Enum.Material.Cobblestone, COLOR.wall)
	elseif ceilingGap < -0.05 then
		p("FrontWallTopRoomA", Vector3.new(roomAWidth, -ceilingGap, 4), CFrame.new(0, ccCeilingY + (-ceilingGap) / 2, zStart - 2), Enum.Material.Cobblestone, COLOR.wall)
	end

	-- Back wall at Gate AB: the chamber is 30 wide, the cobblestone door
	-- frame is only ~20. Without this wall, sky leaks around both jambs.
	local gateOpeningW = gateWidth
	local gateOpeningH = MapManager.rooms.GateAB.height
	local gatePillarW = 3
	local gateLintelH = 3
	local frameHalfW = gateOpeningW / 2 + gatePillarW
	local frameTopY = roomY + gateOpeningH + gateLintelH
	local backZ = zEnd - 4
	local sideFillW = width / 2 - frameHalfW + 1
	p("BackWallL", Vector3.new(sideFillW, height, 4), CFrame.new(-(width / 2 - sideFillW / 2), roomY + height / 2, backZ), Enum.Material.Cobblestone, COLOR.wall)
	p("BackWallR", Vector3.new(sideFillW, height, 4), CFrame.new(width / 2 - sideFillW / 2, roomY + height / 2, backZ), Enum.Material.Cobblestone, COLOR.wall)
	local headerH = (roomY + height) - frameTopY + 1
	if headerH > 0 then
		p("BackWallTop", Vector3.new(frameHalfW * 2 + 2, headerH, 4), CFrame.new(0, frameTopY + headerH / 2 - 0.5, backZ), Enum.Material.Cobblestone, COLOR.wall)
	end

	-- Chamber Torches (Attached to the middle pillars)
	for _, side in ipairs({-1, 1}) do
		local tx = side * (width/2 - 2.5)
		local tz = zStart + length/2
		local tf = GeometryCore.newFolder(folder, "Torch_" .. (side > 0 and "R" or "L"))
		p("Sconce", Vector3.new(1, 2, 1), CFrame.new(tx, 10, tz), Enum.Material.Wood, Color3.fromRGB(60, 40, 20)).Parent = tf
		p("SconceBase", Vector3.new(1.5, 0.5, 1.5), CFrame.new(tx, 9, tz), Enum.Material.Metal, Color3.fromRGB(30, 30, 30)).Parent = tf
		local flame = p("Flame", Vector3.new(0.5, 0.5, 0.5), CFrame.new(tx, 11.5, tz), Enum.Material.Neon, Color3.fromRGB(255, 150, 50))
		flame.Parent = tf
		local pl = Instance.new("PointLight")
		pl.Color = Color3.fromRGB(255, 160, 80); pl.Range = 20; pl.Brightness = 2.5; pl.Shadows = false; pl.Parent = flame
	end
end

local function buildBrazier(parent, name, pos)
	local model = GeometryCore.newFolder(parent, name)
	GeometryCore.newPart({Name="Base", Size=Vector3.new(3, 3, 3), CFrame=CFrame.new(pos + Vector3.new(0, 1.5, 0)), Material=Enum.Material.Cobblestone, Color=COLOR.wall, Parent=model})
	GeometryCore.newPart({Name="Bowl", Size=Vector3.new(3.6, 1, 3.6), CFrame=CFrame.new(pos + Vector3.new(0, 3.5, 0)), Material=Enum.Material.Slate, Color=COLOR.wallDark, Parent=model})
	local flame = GeometryCore.newPart({Name="Flame", Size=Vector3.new(1.8, 1.8, 1.8), CFrame=CFrame.new(pos + Vector3.new(0, 4.2, 0)), Material=Enum.Material.Neon, Color=Color3.fromRGB(255, 120, 40), Parent=model})
	local pl = Instance.new("PointLight")
	pl.Color = Color3.fromRGB(255, 140, 60); pl.Range = 16; pl.Brightness = 2; pl.Shadows = false; pl.Parent = flame
	return model
end

local function buildBanner(parent, name, pos, fwd, isStanding)
	local model = GeometryCore.newFolder(parent, name)
	local right = GeometryCore.getRight(fwd)
	if isStanding then
		GeometryCore.newPart({Name="PoleL", Size=Vector3.new(0.6, 14, 0.6), CFrame=CFrame.new(pos + right * 3 + Vector3.new(0, 7, 0)), Material=Enum.Material.Wood, Color=Color3.fromRGB(70, 50, 30), Parent=model})
		GeometryCore.newPart({Name="PoleR", Size=Vector3.new(0.6, 14, 0.6), CFrame=CFrame.new(pos - right * 3 + Vector3.new(0, 7, 0)), Material=Enum.Material.Wood, Color=Color3.fromRGB(70, 50, 30), Parent=model})
		GeometryCore.newPart({Name="Crossbar", Size=Vector3.new(6.6, 0.6, 0.6), CFrame=CFrame.new(pos + Vector3.new(0, 13, 0)), Material=Enum.Material.Wood, Color=Color3.fromRGB(70, 50, 30), Parent=model})
		GeometryCore.newPart({Name="Fabric", Size=Vector3.new(5.6, 10, 0.2), CFrame=CFrame.new(pos + Vector3.new(0, 7.5, 0)), Material=Enum.Material.Fabric, Color=Color3.fromRGB(20, 40, 100), Parent=model})
	else
		GeometryCore.newPart({Name="Crossbar", Size=Vector3.new(6, 0.6, 0.6), CFrame=CFrame.new(pos + fwd * 0.5), Material=Enum.Material.Wood, Color=Color3.fromRGB(70, 50, 30), Parent=model})
		GeometryCore.newPart({Name="Fabric", Size=Vector3.new(5.6, 14, 0.2), CFrame=CFrame.new(pos + fwd * 0.6 + Vector3.new(0, -7, 0)), Material=Enum.Material.Fabric, Color=Color3.fromRGB(20, 40, 100), Parent=model})
	end
	return model
end

local function buildStake(parent, name, pos)
	local model = GeometryCore.newFolder(parent, name)
	GeometryCore.newPart({Name="Post", Size=Vector3.new(1.2, 7, 1.2), CFrame=CFrame.new(pos + Vector3.new(0, 3.5, 0)), Material=Enum.Material.Wood, Color=Color3.fromRGB(80, 60, 40), Parent=model})
	GeometryCore.newPart({Name="Cross", Size=Vector3.new(4, 0.8, 0.8), CFrame=CFrame.new(pos + Vector3.new(0, 5.5, 0)), Material=Enum.Material.Wood, Color=Color3.fromRGB(80, 60, 40), Parent=model})
	return model
end

local function buildCobblestoneGate(parent, name, centerX, gateZ, yBase, openingWidth, openingHeight, gateDepth)
	local gateVisual = GeometryCore.newFolder(parent, name)

	-- Frame structure
	local pillarW = 3
	local lintelH = 3
	local thresholdH = 1

	local pillarMat = Enum.Material.Cobblestone
	local pillarColor = Color3.fromRGB(65, 62, 58)
	local lintelColor = Color3.fromRGB(60, 57, 53)

	-- Columns overlap the lintel by 1 stud so the top corners don't show sky
	local columnH = openingHeight + 1
	GeometryCore.newPart({
		Name = "ColumnL", Size = Vector3.new(pillarW, columnH, gateDepth),
		CFrame = CFrame.new(centerX - openingWidth/2 - pillarW/2, yBase + columnH/2, gateZ),
		Material = pillarMat, Color = pillarColor, Parent = gateVisual
	}, "visual")

	GeometryCore.newPart({
		Name = "ColumnR", Size = Vector3.new(pillarW, columnH, gateDepth),
		CFrame = CFrame.new(centerX + openingWidth/2 + pillarW/2, yBase + columnH/2, gateZ),
		Material = pillarMat, Color = pillarColor, Parent = gateVisual
	}, "visual")

	GeometryCore.newPart({
		Name = "ArchLintel", Size = Vector3.new(openingWidth + pillarW * 2 + 2, lintelH, gateDepth + 1),
		CFrame = CFrame.new(centerX, yBase + openingHeight + lintelH/2, gateZ),
		Material = pillarMat, Color = lintelColor, Parent = gateVisual
	}, "visual")

	GeometryCore.newPart({
		Name = "Threshold", Size = Vector3.new(openingWidth, thresholdH, gateDepth),
		CFrame = CFrame.new(centerX, yBase - thresholdH/2, gateZ),
		Material = pillarMat, Color = lintelColor, Parent = gateVisual
	}, "visual")

	-- Door leaf structure
	local panelWidth = (openingWidth / 2) - 0.15
	local panelHeight = openingHeight - 1.5
	local panelDepth = gateDepth - 0.6

	local panelColor = Color3.fromRGB(55, 52, 48)
	local bandColor = Color3.fromRGB(40, 38, 35)
	local handleColor = Color3.fromRGB(35, 33, 30)

	local function buildDoorLeaf(sideName, isLeft)
		local leafFolder = Instance.new("Model")
		leafFolder.Name = "DoorLeaf_" .. sideName
		leafFolder.Parent = gateVisual
		local leafDir = isLeft and -1 or 1
		local panelX = centerX + leafDir * (openingWidth/2 - panelWidth/2)

		-- Main Panel (Anchored, used as Root)
		local panel = GeometryCore.newPart({
			Name = "StonePanel", Size = Vector3.new(panelWidth, panelHeight, panelDepth),
			CFrame = CFrame.new(panelX, yBase + openingHeight/2, gateZ),
			Material = Enum.Material.Cobblestone, Color = panelColor, Parent = leafFolder
		}, "visual")
		leafFolder.PrimaryPart = panel

		local function weldToPanel(part)
			part.Anchored = false
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = panel
			weld.Part1 = part
			weld.Parent = part
		end

		-- 3 Horizontal Bands (Slate)
		local bandH = 1
		local bandD = panelDepth + 0.2
		for _, pct in ipairs({0.25, 0.5, 0.75}) do
			local bY = yBase + (openingHeight/2 - panelHeight/2) + panelHeight * pct
			local band = GeometryCore.newPart({
				Name = "StoneBand", Size = Vector3.new(panelWidth + 0.1, bandH, bandD),
				CFrame = CFrame.new(panelX, bY, gateZ),
				Material = Enum.Material.Slate, Color = bandColor, Parent = leafFolder
			}, "visual")
			weldToPanel(band)
		end

		-- Handle/Boss
		local handleX = panelX - leafDir * (panelWidth/2 - 0.6)
		local boss = GeometryCore.newPart({
			Name = "BossHandle", Size = Vector3.new(0.6, 1.5, panelDepth + 0.4),
			CFrame = CFrame.new(handleX, yBase + openingHeight/2, gateZ),
			Material = Enum.Material.Slate, Color = handleColor, Parent = leafFolder
		}, "visual")
		weldToPanel(boss)

		-- Hinge/Pivot
		local hingeX = centerX + leafDir * (openingWidth/2 - 0.4)
		local hinge = GeometryCore.newPart({
			Name = "Hinge", Size = Vector3.new(0.8, panelHeight, 0.8),
			CFrame = CFrame.new(hingeX, yBase + openingHeight/2, gateZ),
			Material = Enum.Material.Metal, Color = Color3.fromRGB(20, 22, 25), Parent = leafFolder
		}, "visual")
		weldToPanel(hinge)
	end

	buildDoorLeaf("L", true)
	buildDoorLeaf("R", false)

	return gateVisual
end

local RoomB = {}

function RoomB.build(parent)
	local folder = GeometryCore.newFolder(parent, "RoomB")
	local pos = MapManager.rooms.RoomB.position
	local R = MapManager.rooms.RoomB.radius
	local t = 4
	local height = 24

	Masonry.buildGrounding(folder, pos, R*2, R*2, 60)
	local floorFolder = GeometryCore.newFolder(folder, "StructuralFloor")
	local ap = R * math.cos(math.pi / 8)
	local sl = 2 * R * math.sin(math.pi / 8)

	-- Full mossy/algae floor covering the entire room
	GeometryCore.newPart({
		Name = "Floor_Main", Size = Vector3.new(2 * ap, 2, 2 * ap),
		CFrame = CFrame.new(pos + Vector3.new(0, -1, 0)),
		Material = Enum.Material.Grass, Color = Color3.fromRGB(55, 75, 45), Parent = floorFolder
	}, "structural")

	-- Water stream running along ALL 8 sides (wider, more visible)
	for i = 0, 7 do
		local angle = i * (math.pi / 4)
		local dirX = math.sin(angle)
		local dirZ = math.cos(angle)
		local edgeCenter = pos + Vector3.new(dirX * (ap - 4), 0, dirZ * (ap - 4))
		local fwd = Vector3.new(-dirX, 0, -dirZ)
		local right = GeometryCore.getRight(fwd)
		GeometryCore.newPart({
			Name = "WaterEdge_" .. i, Size = Vector3.new(sl + 4, 0.5, 8),
			CFrame = CFrame.fromMatrix(edgeCenter + Vector3.new(0, -0.1, 0), right, Vector3.yAxis),
			Material = Enum.Material.Foil, Color = Color3.fromRGB(15, 65, 80),
			Transparency = 0.5, Reflectance = 0.2, CanCollide = false, Parent = floorFolder
		}, "decorative")
	end

	-- Walkways (North & South) - slightly raised cobblestone paths
	GeometryCore.newPart({
		Name = "Walkway_North", Size = Vector3.new(16, 0.4, ap),
		CFrame = CFrame.new(pos + Vector3.new(0, 0.2, -ap/2)),
		Material = Enum.Material.Cobblestone, Color = COLOR.floor, Parent = floorFolder
	}, "structural")
	GeometryCore.newPart({
		Name = "Walkway_South", Size = Vector3.new(16, 0.4, ap),
		CFrame = CFrame.new(pos + Vector3.new(0, 0.2, ap/2)),
		Material = Enum.Material.Cobblestone, Color = COLOR.floor, Parent = floorFolder
	}, "structural")

	-- Gate Thresholds (Covers the grass at the entrances)
	GeometryCore.newPart({
		Name = "Threshold_North", Size = Vector3.new(16, 2.4, 8),
		CFrame = CFrame.new(pos + Vector3.new(0, -0.8, -(ap - 2))),
		Material = Enum.Material.Cobblestone, Color = COLOR.floor, Parent = floorFolder
	}, "structural")
	GeometryCore.newPart({
		Name = "Threshold_South", Size = Vector3.new(16, 2.4, 8),
		CFrame = CFrame.new(pos + Vector3.new(0, -0.8, ap - 2)),
		Material = Enum.Material.Cobblestone, Color = COLOR.floor, Parent = floorFolder
	}, "structural")

	local decorFolder = GeometryCore.newFolder(folder, "Decorations")
	local trapsFolder = GeometryCore.newFolder(folder, "Traps")
	local wallFolder = GeometryCore.newFolder(folder, "OctagonWalls")

	-- 8 Spike Traps in perfect circular symmetry (every 45 degrees)
	local trapPositions = {}
	local numTraps = 8
	for i = 0, numTraps - 1 do
		table.insert(trapPositions, {angle = i * (math.pi * 2 / numTraps), dist = 22})
	end
	for i, tp in ipairs(trapPositions) do
		local dx = math.sin(tp.angle)
		local dz = math.cos(tp.angle)
		local fwd = Vector3.new(-dx, 0, -dz)
		local trapPos = pos + Vector3.new(dx * tp.dist, 0, dz * tp.dist)
		buildSpikeTrap(trapsFolder, "SpikeTrap_"..i, trapPos, fwd, true)
	end

	-- 5 Wooden Stakes placed naturally around the arena edges
	local stakeData = {
		{x = -32, z = -20},
		{x = 35, z = 15},
		{x = 28, z = -28},
		{x = -38, z = 18},
	}
	for i, sd in ipairs(stakeData) do
		buildStake(decorFolder, "Stake_"..i, pos + Vector3.new(sd.x, 0, sd.z))
	end

	-- Rubble stones - more concentrated near the edges/sides
	local rng = Random.new(12345)
	-- Edge rubble (near walls)
	for i = 1, 30 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(ap - 14, ap - 5)
		local dx = math.sin(angle) * r
		local dz = math.cos(angle) * r
		local s = rng:NextNumber(0.8, 3.0)
		GeometryCore.newPart({
			Name = "EdgeRubble_" .. i, Size = Vector3.new(s, s * 0.5, s * 0.9),
			CFrame = CFrame.new(pos + Vector3.new(dx, s * 0.25, dz)) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0),
			Material = Enum.Material.Cobblestone, Color = Color3.fromRGB(65 + rng:NextInteger(-10, 10), 63 + rng:NextInteger(-10, 10), 58 + rng:NextInteger(-10, 10)),
			Parent = decorFolder
		}, "decorative")
	end
	-- Scattered interior rubble (fewer, smaller)
	for i = 1, 40 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(5, ap - 16)
		local dx = math.sin(angle) * r
		local dz = math.cos(angle) * r
		local s = rng:NextNumber(0.8, 2.5)
		GeometryCore.newPart({
			Name = "InnerRubble_" .. i, Size = Vector3.new(s, s * 0.4, s * 0.7),
			CFrame = CFrame.new(pos + Vector3.new(dx, s * 0.2, dz)) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0),
			Material = Enum.Material.Cobblestone, Color = Color3.fromRGB(70 + rng:NextInteger(-8, 8), 68 + rng:NextInteger(-8, 8), 62 + rng:NextInteger(-8, 8)),
			Parent = decorFolder
		}, "decorative")
	end

	-- Braziers at the south entrance (flanking the gate, like the reference)
	buildBrazier(decorFolder, "Brazier_SouthL", pos + Vector3.new(-10, 0, ap - 8))
	buildBrazier(decorFolder, "Brazier_SouthR", pos + Vector3.new(10, 0, ap - 8))
	-- Braziers at the north entrance
	buildBrazier(decorFolder, "Brazier_NorthL", pos + Vector3.new(-10, 0, -(ap - 8)))
	buildBrazier(decorFolder, "Brazier_NorthR", pos + Vector3.new(10, 0, -(ap - 8)))

	-- Standing Banners flanking the SOUTH entrance (like the reference image)
	buildBanner(decorFolder, "StandingBanner_SL", pos + Vector3.new(-14, 0, ap - 6), Vector3.new(0, 0, -1), true)
	buildBanner(decorFolder, "StandingBanner_SR", pos + Vector3.new(14, 0, ap - 6), Vector3.new(0, 0, -1), true)

	-- Build Outer Walls
	for i = 0, 7 do
		local angle = i * (math.pi / 4)
		local dirX = math.sin(angle)
		local dirZ = math.cos(angle)

		local wallCenter = pos + Vector3.new(dirX * ap, 0, dirZ * ap)
		local fwd = Vector3.new(-dirX, 0, -dirZ)
		local right = GeometryCore.getRight(fwd)

		local p1 = wallCenter - right * (sl / 2)
		local p2 = wallCenter + right * (sl / 2)

		local isNorthWall = (i == 0)
		local isSouthWall = (i == 4)

		if isNorthWall then
			Masonry.buildIntegratedArch(wallFolder, "WallSegment_North_GateBC_Hole", p1, p2, height, t, 14, 19, MAT.wall, COLOR.wall)
		elseif isSouthWall then
			Masonry.buildIntegratedArch(wallFolder, "WallSegment_South_GateAB_Hole", p1, p2, height, t, 14, 19, MAT.wall, COLOR.wall)
		else
			Masonry.buildWallCourse(wallFolder, "WallSegment_" .. i, p1, p2, height, t, MAT.wall, COLOR.wall)
		end
		Masonry.buildPilaster(wallFolder, "Pilaster_" .. i, p1, fwd, 4, height, 2)

		if i ~= 0 and i ~= 4 then
			-- Moss along wall base
			GeometryCore.newPart({
				Name = "WallMoss_" .. i, Size = Vector3.new(sl - 4, 1.5, 4),
				CFrame = CFrame.fromMatrix(wallCenter + Vector3.new(0, -0.5, 0) + fwd * 2, right, Vector3.yAxis),
				Material = Enum.Material.Grass, Color = Color3.fromRGB(40, 90, 35), Parent = decorFolder
			}, "decorative")

			-- Hanging vines draped from high up
			local numVines = 5 + rng:NextInteger(-1, 2)
			for v = 1, numVines do
				local vineX = (rng:NextNumber() - 0.5) * (sl - 4)
				local vineLength = 8 + rng:NextNumber() * 10
				local vineY = height - 2 - vineLength/2 + rng:NextNumber() * 4
				GeometryCore.newPart({
					Name = "HangingVine_" .. i .. "_" .. v, Size = Vector3.new(0.8, vineLength, 0.8),
					CFrame = CFrame.fromMatrix(wallCenter + Vector3.new(0, vineY, 0) + fwd * (t/2 + 0.4) + right * vineX, right, Vector3.yAxis),
					Material = Enum.Material.LeafyGrass, Color = Color3.fromRGB(35, 85, 30), Parent = decorFolder
				}, "decorative")
			end
			-- Fungus/lichen spots (small, scattered on walls)
			for f = 1, 3 do
				local fHeight = 2 + f * 5
				local fOffset = (f - 2) * (sl * 0.15)
				GeometryCore.newPart({
					Name = "WallFungus_" .. i .. "_" .. f, Size = Vector3.new(2.5, 2, 0.4),
					CFrame = CFrame.fromMatrix(wallCenter + Vector3.new(0, fHeight, 0) + fwd * (t/2 + 0.2) + right * fOffset, right, Vector3.yAxis),
					Material = Enum.Material.Grass, Color = Color3.fromRGB(50, 85, 45), Parent = decorFolder
				}, "decorative")
			end
		end
	end

	-- Wall-hung banners on side walls only (not gates)
	for i = 1, 7 do
		if i ~= 4 and i ~= 0 then -- skip south and north gate walls
			local angle = i * (math.pi / 4)
			local dirX = math.sin(angle)
			local dirZ = math.cos(angle)
			local wallCenter = pos + Vector3.new(dirX * ap, 0, dirZ * ap)
			local fwd = Vector3.new(-dirX, 0, -dirZ)
			buildBanner(decorFolder, "WallBanner_" .. i, wallCenter + Vector3.new(0, 16, 0), fwd, false)
		end
	end

	-- Heavy Cobblestone Double Gates
	local gateAB_Z = MapManager.rooms.GateAB.z
	local gateBC_Z = pos.Z + ap
	buildCobblestoneGate(decorFolder, "Gate_AB", 0, gateAB_Z, 5, 14, 19, 4)
	buildCobblestoneGate(decorFolder, "Gate_BC", 0, gateBC_Z, 10, 14, 19, 4)

	-- ================================================================
	-- GOLEM SPAWN POINTS
	-- ================================================================
	local spawnFolder = GeometryCore.newFolder(folder, "GolemSpawnPoints")
	local function createSpawnPoint(name, x, z)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = Vector3.new(4, 1, 4)
		p.CFrame = CFrame.new(pos + Vector3.new(x, 1, z))
		p.Anchored = true
		p.CanCollide = false
		p.Transparency = 1
		p.Parent = spawnFolder
	end

	-- Place them in intentional locations in Room B (12 studs south of Gate BC)
	createSpawnPoint("GreenGuardSpawn", -6, ap - 12)
	createSpawnPoint("SkeliGuardSpawn", 6, ap - 12)

	return folder
end

------------------------------------------------------------------------
-- ROOM C CAVE-IN CAMERA SHAKE SYSTEM
-- Humanoid.CameraOffset alone is subtle and depends on the camera
-- script actually reading it, so it can end up looking like "nothing is
-- happening". This sets up a RemoteEvent + a LocalScript that hooks
-- directly into RunService:BindToRenderStep to shake the camera's
-- CFrame itself (position AND rotation) right after the default camera
-- update, which works regardless of camera rig and reads as a real,
-- chaotic quake instead of a faint nudge.
------------------------------------------------------------------------
local function ensureRoomCCameraShakeSystem()
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local StarterPlayer = game:GetService("StarterPlayer")
	local Players = game:GetService("Players")

	local remote = ReplicatedStorage:FindFirstChild("RoomC_CameraShakeEvent")
	if not remote then
		remote = Instance.new("RemoteEvent")
		remote.Name = "RoomC_CameraShakeEvent"
		remote.Parent = ReplicatedStorage
	end

	local controllerSource = [[
		local RunService = game:GetService("RunService")
		local ReplicatedStorage = game:GetService("ReplicatedStorage")

		local camera = workspace.CurrentCamera
		local remote = ReplicatedStorage:WaitForChild("RoomC_CameraShakeEvent")

		local active = false
		local trauma = 0 -- 0..1, ramps up while active, decays back to 0 when not

		local MAX_POS_OFFSET = 5.5        -- studs, at full trauma (violent)
		local MAX_ROT_OFFSET = math.rad(22) -- radians, at full trauma (violent)
		local RAMP_UP_SPEED = 8            -- trauma gained per second while active (near-instant onset)
		local DECAY_SPEED = 1.6            -- trauma lost per second once stopped
		local JOLT_CHANCE_PER_SEC = 4      -- random full-intensity "impact" jolts

		remote.OnClientEvent:Connect(function(isActive)
			active = isActive and true or false
			print("[RoomC_CameraShakeController] Shake event received -> active =", active)
		end)

		workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
			camera = workspace.CurrentCamera
		end)

		-- Defensive: if an older copy of this controller left a render-step
		-- binding behind (e.g. from re-running the generator while testing),
		-- unbind it first so this fresh copy never silently fails to bind.
		pcall(function() RunService:UnbindFromRenderStep("RoomC_CameraShake") end)

		print("[RoomC_CameraShakeController] Loaded - listening for shake events.")

		RunService:BindToRenderStep("RoomC_CameraShake", Enum.RenderPriority.Camera.Value + 1, function(dt)
			if active then
				trauma = math.min(trauma + RAMP_UP_SPEED * dt, 1)
				if math.random() < JOLT_CHANCE_PER_SEC * dt then
					trauma = 1
				end
			else
				trauma = math.max(trauma - DECAY_SPEED * dt, 0)
			end

			if trauma <= 0.001 then
				return
			end

			if not camera then
				camera = workspace.CurrentCamera
				if not camera then return end
			end

			-- Squaring the trauma makes small shakes gentle and big
			-- shakes violent, instead of a flat linear wobble.
			local shake = trauma * trauma
			local t = os.clock()

			local posOffset = Vector3.new(
				MAX_POS_OFFSET * shake * (math.noise(t * 18, 0, 0) * 2),
				MAX_POS_OFFSET * shake * (math.noise(0, t * 18, 11) * 2),
				MAX_POS_OFFSET * shake * (math.noise(t * 18, t * 18, 23) * 2)
			)

			local rotOffset = Vector3.new(
				MAX_ROT_OFFSET * shake * (math.noise(t * 22, 5, 0) * 2),
				MAX_ROT_OFFSET * shake * (math.noise(0, t * 22, 17) * 2),
				MAX_ROT_OFFSET * shake * (math.noise(t * 22, t * 22, 29) * 2)
			)

			camera.CFrame = camera.CFrame * CFrame.new(posOffset) * CFrame.Angles(rotOffset.X, rotOffset.Y, rotOffset.Z)
		end)
	]]

	local function install(container)
		if not container then return end
		-- Always tear down and rebuild so a stale/broken copy left behind by a
		-- prior run of this generator (which only ever destroys the workspace
		-- model, never these injected scripts) can never block the fresh one.
		local existing = container:FindFirstChild("RoomC_CameraShakeController")
		if existing then
			existing:Destroy()
		end
		local ls = Instance.new("LocalScript")
		ls.Name = "RoomC_CameraShakeController"
		local ok, err = pcall(function() ls.Source = controllerSource end)
		if not ok then
			warn("[RoomC] Could not write camera shake controller source: " .. tostring(err))
		end
		ls.Parent = container
	end

	-- Future players who join get it automatically...
	local starterPlayerScripts = StarterPlayer:FindFirstChild("StarterPlayerScripts")
	if starterPlayerScripts then
		install(starterPlayerScripts)
	end

	-- ...and anyone already in the game gets it right now.
	for _, plr in ipairs(Players:GetPlayers()) do
		local playerScripts = plr:FindFirstChild("PlayerScripts")
		if playerScripts then
			install(playerScripts)
		end
	end

	return remote
end

local RoomC = {}

function RoomC.build(parent)
	local folder = GeometryCore.newFolder(parent, "RoomC")
	local pos = MapManager.rooms.RoomC.position
	local R = MapManager.rooms.RoomC.radius
	local t = 4
	local height = 30

	-- Deep foundation
	Masonry.buildGrounding(folder, pos, R * 2.2, R * 2.2, 70)
	local floorFolder = GeometryCore.newFolder(folder, "StructuralFloor")

	-- 16-sided polygon math
	local numSides = 16
	local angleStep = (math.pi * 2) / numSides
	local ap = R * math.cos(math.pi / numSides)
	local sl = 2 * R * math.sin(math.pi / numSides)

	------------------------------------------------------------------------
	-- FLOOR: Oversized square base + polygon wedge fills = zero gaps
	------------------------------------------------------------------------
	-- 1. Large square base slab that guarantees full coverage under the polygon
	GeometryCore.newPart({
		Name = "Floor_SquareBase",
		Size = Vector3.new(ap * 2 + 4, 2, ap * 2 + 4),
		CFrame = CFrame.new(pos + Vector3.new(0, -1, 0)),
		Material = Enum.Material.Cobblestone, Color = COLOR.floor, Parent = floorFolder
	}, "structural")

	-- 2. Per-segment floor wedges that fill every corner of the polygon
	for i = 0, numSides - 1 do
		local a1 = i * angleStep
		local a2 = (i + 1) * angleStep
		local mid = (a1 + a2) / 2
		local dirX = math.sin(mid)
		local dirZ = math.cos(mid)
		local segCenter = pos + Vector3.new(dirX * (ap - 2), -0.9, dirZ * (ap - 2))
		local fwd = Vector3.new(-dirX, 0, -dirZ)
		local right = GeometryCore.getRight(fwd)
		GeometryCore.newPart({
			Name = "FloorWedge_" .. i,
			Size = Vector3.new(sl + 6, 2.2, 8),
			CFrame = CFrame.fromMatrix(segCenter, right, Vector3.yAxis),
			Material = Enum.Material.Cobblestone, Color = COLOR.floor, Parent = floorFolder
		}, "structural")
	end

	-- 3. Thin decorative stone-tile overlay on top of the base (visual richness)
	GeometryCore.newPart({
		Name = "Floor_TileOverlay",
		Size = Vector3.new(ap * 1.9, 0.15, ap * 1.9), Shape = Enum.PartType.Cylinder,
		CFrame = CFrame.new(pos + Vector3.new(0, 0.08, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		Material = Enum.Material.Slate, Color = Color3.fromRGB(55, 55, 60), Parent = floorFolder
	}, "structural")

	------------------------------------------------------------------------
	-- WATER POOL
	------------------------------------------------------------------------
	local poolRadius = R * 0.65
	GeometryCore.newPart({
		Name = "WaterPool",
		Size = Vector3.new(poolRadius * 2, 0.6, poolRadius * 2), Shape = Enum.PartType.Cylinder,
		CFrame = CFrame.new(pos + Vector3.new(0, 0.15, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		Material = Enum.Material.Foil, Color = Color3.fromRGB(15, 80, 100),
		Transparency = 0.45, Reflectance = 0.25, CanCollide = false, Parent = floorFolder
	}, "decorative")

	-- Pool stone rim (raised edge around the water)
	local rimThickness = 1.5
	local rimHeight = 0.6
	local rimSegments = 32
	for i = 0, rimSegments - 1 do
		local a = i * (math.pi * 2) / rimSegments
		local dx = math.sin(a) * poolRadius
		local dz = math.cos(a) * poolRadius
		GeometryCore.newPart({
			Name = "PoolRim_" .. i,
			Size = Vector3.new(poolRadius * 2 * math.pi / rimSegments + 0.4, rimHeight, rimThickness),
			CFrame = CFrame.fromMatrix(
				pos + Vector3.new(dx, rimHeight / 2, dz),
				GeometryCore.getRight(Vector3.new(-math.sin(a), 0, -math.cos(a))),
				Vector3.yAxis
			),
			Material = Enum.Material.Slate, Color = Color3.fromRGB(65, 63, 68), Parent = floorFolder
		}, "structural")
	end

	------------------------------------------------------------------------
	-- WALKWAYS (South entry & North exit)
	------------------------------------------------------------------------
	local walkwayLen = ap - poolRadius + 6
	GeometryCore.newPart({
		Name = "Walkway_South", Size = Vector3.new(16, 0.8, walkwayLen),
		CFrame = CFrame.new(pos + Vector3.new(0, 0.4, ap - walkwayLen / 2 + 1)),
		Material = Enum.Material.Cobblestone, Color = COLOR.floor, Parent = floorFolder
	}, "structural")
	GeometryCore.newPart({
		Name = "Walkway_North", Size = Vector3.new(16, 0.8, walkwayLen),
		CFrame = CFrame.new(pos + Vector3.new(0, 0.4, -(ap - walkwayLen / 2 + 1))),
		Material = Enum.Material.Cobblestone, Color = COLOR.floor, Parent = floorFolder
	}, "structural")

	local decorFolder = GeometryCore.newFolder(folder, "Decorations")
	local wallFolder = GeometryCore.newFolder(folder, "Walls")

	------------------------------------------------------------------------
	-- THE SACRED DAIS (3-Tiered Platform)
	------------------------------------------------------------------------
	local daisFolder = GeometryCore.newFolder(folder, "SacredDais")
	local tiers = {
		{ r = 16, h = 1.2, col = Color3.fromRGB(60, 58, 63) },
		{ r = 12, h = 2.2, col = Color3.fromRGB(70, 68, 73) },
		{ r = 8, h = 3.2, col = Color3.fromRGB(80, 78, 83) },
	}
	for i, tier in ipairs(tiers) do
		GeometryCore.newPart({
			Name = "DaisTier_" .. i,
			Size = Vector3.new(tier.r * 2, tier.h, tier.r * 2), Shape = Enum.PartType.Cylinder,
			CFrame = CFrame.new(pos + Vector3.new(0, tier.h / 2, 0)) * CFrame.Angles(0, 0, math.pi / 2),
			Material = Enum.Material.Slate, Color = tier.col, Parent = daisFolder
		}, "structural")
	end

	-- Decorative rune ring on the top tier
	GeometryCore.newPart({
		Name = "RuneRing",
		Size = Vector3.new(13, 0.1, 13), Shape = Enum.PartType.Cylinder,
		CFrame = CFrame.new(pos + Vector3.new(0, 3.26, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		Material = Enum.Material.Neon, Color = Color3.fromRGB(200, 160, 40),
		Transparency = 0.6, CanCollide = false, Parent = daisFolder
	}, "decorative")

	------------------------------------------------------------------------
	-- THE HEART CRYSTAL (Fixed: clean diamond shape, no rod artifact)
	------------------------------------------------------------------------
	local heartCenter = pos + Vector3.new(0, 8, 0)
	local heart = GeometryCore.newPart({
		Name = "TheHeartCrystal",
		Size = Vector3.new(4, 8, 4),
		-- Single 45-degree tilt on Z axis creates a clean diamond silhouette
		CFrame = CFrame.new(heartCenter) * CFrame.Angles(0, 0, math.rad(45)),
		Material = Enum.Material.Neon, Color = Color3.fromRGB(255, 180, 40),
		Parent = daisFolder
	}, "decorative")

	local highlight = Instance.new("Highlight")
	highlight.FillColor = Color3.fromRGB(255, 200, 50)
	highlight.OutlineColor = Color3.fromRGB(255, 255, 100)
	highlight.FillTransparency = 0.5
	highlight.Parent = heart

	-- Primary golden light from the crystal
	local crystalLight = Instance.new("PointLight")
	crystalLight.Color = Color3.fromRGB(255, 190, 60)
	crystalLight.Range = 70
	crystalLight.Brightness = 4
	crystalLight.Shadows = true
	crystalLight.Parent = heart

	-- ProximityPrompt on a separate invisible part (avoids Script-on-Part rod artifact)
	local promptAnchor = GeometryCore.newPart({
		Name = "HeartPromptAnchor",
		Size = Vector3.new(6, 6, 6),
		CFrame = CFrame.new(heartCenter),
		Transparency = 1, CanCollide = false,
		Parent = daisFolder
	}, "decorative")
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Take the Heart"
	prompt.ObjectText = "Heart Crystal"
	prompt.HoldDuration = 1.5
	prompt.RequiresLineOfSight = false
	prompt.MaxActivationDistance = 12
	prompt.Parent = promptAnchor

	------------------------------------------------------------------------
	-- FLOATING ARCANE ORBS (6 motes orbiting the crystal)
	------------------------------------------------------------------------
	local orbFolder = GeometryCore.newFolder(daisFolder, "ArcaneOrbs")
	local numOrbs = 6
	for i = 0, numOrbs - 1 do
		local orbAngle = i * (math.pi * 2) / numOrbs
		local orbDist = 12
		local orbX = math.sin(orbAngle) * orbDist
		local orbZ = math.cos(orbAngle) * orbDist
		local orbY = heartCenter.Y + math.sin(orbAngle * 2) * 1.5

		local orb = GeometryCore.newPart({
			Name = "ArcaneOrb_" .. i,
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(2.5, 2.5, 2.5),
			CFrame = CFrame.new(heartCenter.X + orbX, orbY, heartCenter.Z + orbZ),
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(50, 150, 255), -- Blue
			Transparency = 0.15,
			CanCollide = false,
			Parent = orbFolder
		}, "decorative")

		local orbLight = Instance.new("PointLight")
		orbLight.Color = Color3.fromRGB(80, 180, 255) -- Blue light
		orbLight.Range = 16
		orbLight.Brightness = 2
		orbLight.Shadows = false
		orbLight.Parent = orb
	end

	-- Collapse trigger script (placed on the folder, NOT on the crystal part)
	local roomCCameraShakeRemote = ensureRoomCCameraShakeSystem()

	local function startRoomCCaveIn(dais, player)
		local Players = game:GetService("Players")
		local RunService = game:GetService("RunService")
		local TweenService = game:GetService("TweenService")
		local Debris = game:GetService("Debris")

		local roomC = dais.Parent
		local rootModel = dais:FindFirstAncestorWhichIsA("Model")
		local transCD = rootModel and rootModel:FindFirstChild("TransitionCD")
		local gate = (transCD and transCD:FindFirstChild("AncientGate"))
			or (rootModel and rootModel:FindFirstChild("AncientGate", true))
		local leafL = gate and gate:FindFirstChild("DoorLeaf_L")
		local leafR = gate and gate:FindFirstChild("DoorLeaf_R")
		local threshold = gate and gate:FindFirstChild("Threshold")

		local closedL = leafL and leafL:GetPivot()
		local closedR = leafR and leafR:GetPivot()



		local function tweenLeaves(targetL, targetR)
			local tweenInfo = TweenInfo.new(2.5, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out)
			local cframeValL = Instance.new("CFrameValue")
			cframeValL.Value = leafL:GetPivot()
			cframeValL.Parent = leafL
			cframeValL.Changed:Connect(function() leafL:PivotTo(cframeValL.Value) end)
			local cframeValR = Instance.new("CFrameValue")
			cframeValR.Value = leafR:GetPivot()
			cframeValR.Parent = leafR
			cframeValR.Changed:Connect(function() leafR:PivotTo(cframeValR.Value) end)
			TweenService:Create(cframeValL, tweenInfo, {Value = targetL}):Play()
			TweenService:Create(cframeValR, tweenInfo, {Value = targetR}):Play()
			Debris:AddItem(cframeValL, 3)
			Debris:AddItem(cframeValR, 3)
		end

		local function openDoorToD()
			if not (leafL and leafR) then
				warn("[RoomC] AncientGate to Room D not found")
				return
			end

			local startL = leafL:GetPivot()
			local startR = leafR:GetPivot()
			local distL = leafL:GetExtentsSize().X + 1
			local distR = leafR:GetExtentsSize().X + 1
			tweenLeaves(startL * CFrame.new(-distL, 0, 0), startR * CFrame.new(distR, 0, 0))
		end

		local function closeDoorToD()
			if not (leafL and leafR and closedL and closedR) then return end

			tweenLeaves(closedL, closedR)
		end

		local function spawnCeilingDust()
			local dustFolder = Instance.new("Folder")
			dustFolder.Name = "CaveInDust"
			dustFolder.Parent = roomC

			local floor = roomC:FindFirstChild("StructuralFloor") and roomC.StructuralFloor:FindFirstChild("Floor_SquareBase")
			local origin = floor and floor.Position or dais:FindFirstChild("TheHeartCrystal").Position
			local roofY = origin.Y + 31

			local function makeEmitter(name, worldPos, rate)
				local part = Instance.new("Part")
				part.Name = name
				part.Size = Vector3.new(4, 1, 4)
				part.CFrame = CFrame.new(worldPos)
				part.Transparency = 1
				part.Anchored = true
				part.CanCollide = false
				part.CastShadow = false
				part.Parent = dustFolder

				local dust = Instance.new("ParticleEmitter")
				dust.Name = "Dust"
				dust.Texture = "rbxasset://textures/particles/smoke_main.dds"
				dust.Color = ColorSequence.new(Color3.fromRGB(150, 130, 100), Color3.fromRGB(90, 80, 65))
				dust.Size = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.56),
					NumberSequenceKeypoint.new(0.4, 2.1),
					NumberSequenceKeypoint.new(1, 3.5)
				})
				dust.Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.35),
					NumberSequenceKeypoint.new(0.7, 0.55),
					NumberSequenceKeypoint.new(1, 1)
				})
				dust.Lifetime = NumberRange.new(2.2, 4.5)
				dust.Rate = rate
				dust.Speed = NumberRange.new(3, 7)
				dust.SpreadAngle = Vector2.new(25, 25)
				dust.EmissionDirection = Enum.NormalId.Bottom
				dust.Acceleration = Vector3.new(0, -30, 0)
				dust.Drag = 0.4
				dust.Rotation = NumberRange.new(0, 360)
				dust.RotSpeed = NumberRange.new(-50, 50)
				dust.Enabled = true
				dust.Parent = part

				local grit = Instance.new("ParticleEmitter")
				grit.Name = "Grit"
				grit.Texture = "rbxasset://textures/particles/smoke_main.dds"
				grit.Color = ColorSequence.new(Color3.fromRGB(80, 70, 55))
				grit.Size = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.5),
					NumberSequenceKeypoint.new(1, 1.5)
				})
				grit.Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0),
					NumberSequenceKeypoint.new(1, 1)
				})
				grit.Lifetime = NumberRange.new(1.2, 2.4)
				grit.Rate = rate * 0.8
				grit.Speed = NumberRange.new(6, 12)
				grit.SpreadAngle = Vector2.new(12, 12)
				grit.EmissionDirection = Enum.NormalId.Bottom
				grit.Acceleration = Vector3.new(0, -50, 0)
				grit.Enabled = true
				grit.Parent = part
			end

			-- Rates bumped 70% (28 -> 47.6, 11.2 -> 19.04), then +20% again (238 -> 285.6, 95.2 -> 114.24) for a denser cave-in dust effect
			makeEmitter("Dust_Center", Vector3.new(origin.X, roofY, origin.Z), 285.6)
			for i = 1, 16 do
				local a = (i / 16) * math.pi * 2
				local r = (i % 2 == 0) and 15 or 32
				makeEmitter("Dust_" .. i, Vector3.new(origin.X + math.sin(a) * r, roofY, origin.Z + math.cos(a) * r), 114.24)
			end
			return dustFolder, origin, roofY
		end

		local function clearCameraShake()
			if roomCCameraShakeRemote then
				roomCCameraShakeRemote:FireAllClients(false)
			end
		end

		local dustFolder, origin, roofY = spawnCeilingDust()

		-- Fallen rocks live in their own persistent folder (a sibling of the
		-- dust folder, parented directly to the room) so they stick around
		-- and pile up even after the dust/cave-in cleanup runs.
		local accumulatedRockFolder = roomC:FindFirstChild("FallenRockDebris")
		if not accumulatedRockFolder then
			accumulatedRockFolder = Instance.new("Folder")
			accumulatedRockFolder.Name = "FallenRockDebris"
			accumulatedRockFolder.Parent = roomC
		end

		local function playerFullyInRoomD(rootPart)
			-- Fires as soon as the player's root part crosses the gate
			-- threshold, so the door shuts the moment they leave Room C.
			if threshold then
				return rootPart.Position.Z > threshold.Position.Z
			end
			return rootPart.Position.Z > (origin.Z + 50)
		end

		local function spawnFallingRock()
			local rockModel = Instance.new("Model")
			rockModel.Name = "FallingRock"
			rockModel.Parent = accumulatedRockFolder

