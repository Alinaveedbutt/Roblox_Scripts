local function setupGateABAnimation(root)
	print("[RoomA] Position-based exit detection initialized")

	local roomB = root:FindFirstChild("RoomB")
	if not roomB then print("[RoomA ERROR] RoomB not found!") return end

	local gateAB = roomB:FindFirstChild("Decorations") and roomB.Decorations:FindFirstChild("Gate_AB")
	if not gateAB then print("[RoomA ERROR] Gate_AB not found!") return end

	local leafL = gateAB:FindFirstChild("DoorLeaf_L")
	local leafR = gateAB:FindFirstChild("DoorLeaf_R")
	if not leafL or not leafR then print("[RoomA ERROR] Room B door assembly not found") return end

	local TweenService = game:GetService("TweenService")
	local portcullis = root:FindFirstChild("ExitPortcullis", true)
	if not portcullis then print("[RoomA ERROR] ExitPortcullis not found!") return end

	local gateOpened = false
	local gateClosing = false
	local gateClosed = false

	local closedCFrameL = nil
	local closedCFrameR = nil

	local function OpenGateAB()
		if gateOpened then return end
		gateOpened = true

		closedCFrameL = leafL:GetPivot()
		closedCFrameR = leafR:GetPivot()

		print("[RoomA] BARS CLEARED STATE CONFIRMED")
		print("[RoomA] OPENING ROOM B COBBLESTONE DOORS")

		-- Spawn the dormant golems at runtime!
		local golemControllerModule = game:GetService("ServerScriptService"):FindFirstChild("TrialChamberGolemController") or game:GetService("ServerScriptService"):FindFirstChild("GolemController")
		local golemController = nil
		if golemControllerModule and golemControllerModule:IsA("ModuleScript") then
			golemController = require(golemControllerModule)
		end

		if golemController and golemController.StartEncounter then
			golemController.StartEncounter()
		elseif _G.TrialChamberGolemController and _G.TrialChamberGolemController.StartEncounter then
			_G.TrialChamberGolemController.StartEncounter()
		elseif _G.GolemController and _G.GolemController.StartEncounter then
			_G.GolemController.StartEncounter()
		else
			warn("[RoomA] Could not find TrialChamberGolemController to start encounter!")
		end


		local startL = leafL:GetPivot()
		local startR = leafR:GetPivot()

		-- Determine travel distance based on leaf width so it clears completely
		local sizeL = leafL:GetExtentsSize()
		local sizeR = leafR:GetExtentsSize()
		local distL = sizeL.X + 1
		local distR = sizeR.X + 1

		local targetL = startL * CFrame.new(-distL, 0, 0)
		local targetR = startR * CFrame.new(distR, 0, 0)

		print("[RoomA] LEFT DOOR -> LEFT")
		print("[RoomA] RIGHT DOOR -> RIGHT")

		local tweenInfo = TweenInfo.new(2.5, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out)

		local cframeValL = Instance.new("CFrameValue")
		cframeValL.Value = startL
		cframeValL.Changed:Connect(function() leafL:PivotTo(cframeValL.Value) end)

		local cframeValR = Instance.new("CFrameValue")
		cframeValR.Value = startR
		cframeValR.Changed:Connect(function() leafR:PivotTo(cframeValR.Value) end)

		local tweenL = TweenService:Create(cframeValL, tweenInfo, {Value = targetL})
		local tweenR = TweenService:Create(cframeValR, tweenInfo, {Value = targetR})


		tweenL:Play()
		tweenR:Play()
	end

	local function CloseGateAB()
		if gateClosing or gateClosed then return end
		gateClosing = true

		print("[RoomB] PLAYER ENTERED - CLOSING GATE_AB")


		local tweenInfo = TweenInfo.new(2.5, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out)

		local cframeValL = Instance.new("CFrameValue")
		cframeValL.Value = leafL:GetPivot()
		cframeValL.Changed:Connect(function() leafL:PivotTo(cframeValL.Value) end)

		local cframeValR = Instance.new("CFrameValue")
		cframeValR.Value = leafR:GetPivot()
		cframeValR.Changed:Connect(function() leafR:PivotTo(cframeValR.Value) end)

		local tweenL = TweenService:Create(cframeValL, tweenInfo, {Value = closedCFrameL})
		local tweenR = TweenService:Create(cframeValR, tweenInfo, {Value = closedCFrameR})

		tweenL.Completed:Connect(function()
			gateClosed = true

			-- Activate Phase 1 of the Golem Encounter now that the gate is shut!
			local golemControllerModule = game:GetService("ServerScriptService"):FindFirstChild("TrialChamberGolemController") or game:GetService("ServerScriptService"):FindFirstChild("GolemController")
			local golemController = nil
			if golemControllerModule and golemControllerModule:IsA("ModuleScript") then
				golemController = require(golemControllerModule)
			end

			if golemController and golemController.ActivateEncounter then
				golemController.ActivateEncounter()
			elseif _G.TrialChamberGolemController and _G.TrialChamberGolemController.ActivateEncounter then
				_G.TrialChamberGolemController.ActivateEncounter()
			elseif _G.GolemController and _G.GolemController.ActivateEncounter then
				_G.GolemController.ActivateEncounter()
			else
				warn("[RoomB] Could not find TrialChamberGolemController to activate encounter!")
			end
		end)

		tweenL:Play()
		tweenR:Play()
	end

	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")

	local connection
	connection = RunService.Heartbeat:Connect(function()
		if gateClosed then
			if connection then
				connection:Disconnect()
				connection = nil
			end
			return
		end

		for _, player in ipairs(Players:GetPlayers()) do
			local character = player.Character
			local rootPart = character and character:FindFirstChild("HumanoidRootPart")

			if rootPart then
				local gateZ = leafL:GetPivot().Position.Z

				if not gateOpened then
					-- Phase 1: Wait for player to clear the bars (36 studs before GateAB)
					local CLEARANCE_Z = gateZ - 36
					if rootPart.Position.Z > CLEARANCE_Z then
						print("[RoomA] PLAYER CLEARED PORTCULLIS")
						print("[RoomA] CLEARANCE DETECTED")
						OpenGateAB()
						break
					end
				elseif not gateClosing then
					-- Phase 2: Wait for player to safely enter Room B
					-- Since the gate is at gateZ, and the doors are 4 studs thick, GateZ + 12 ensures they are completely inside.
					local ROOM_B_ENTRY_Z = gateZ + 12
					if rootPart.Position.Z > ROOM_B_ENTRY_Z then
						CloseGateAB()
						local progressionModule = game:GetService("ServerScriptService"):FindFirstChild("Progression")
							or game:GetService("ServerScriptService"):FindFirstChild("Progression_TrialChamber")
						if not progressionModule then
							progressionModule = game:GetService("Workspace"):FindFirstChild("Progression")
								or game:GetService("Workspace"):FindFirstChild("Progression_TrialChamber")
						end
						if not progressionModule then
							progressionModule = game:GetService("ReplicatedStorage"):FindFirstChild("Progression")
								or game:GetService("ReplicatedStorage"):FindFirstChild("Progression_TrialChamber")
						end

						if progressionModule and progressionModule:IsA("ModuleScript") then
							print("[ROOM B COMBAT] Progression system resolved via ModuleScript")
							require(progressionModule).rewardSword(player)
						elseif _G.Progression and type(_G.Progression.rewardSword) == "function" then
							print("[ROOM B COMBAT] Progression system resolved via _G.Progression")
							_G.Progression.rewardSword(player)
						else
							warn("[RoomB ERROR] Progression module not found!")
							warn("==================================================")
							warn("CRITICAL ARCHITECTURE REQUIREMENT:")
							warn("Because RevampV10 cannot create script source code at runtime (PluginSecurity),")
							warn("you MUST manually create a ModuleScript or Script named 'Progression' in ServerScriptService")
							warn("and paste the contents of Progression.lua into it!")
							warn("==================================================")
						end
						break
					end
				end
			end
		end
	end)
end

local function setupGateBCAnimation(root)
	print("[RoomB] Golem-based exit door logic initialized")

	local roomB = root:FindFirstChild("RoomB")
	if not roomB then print("[RoomB ERROR] RoomB not found!") return end

	local gateBC = roomB:FindFirstChild("Decorations") and roomB.Decorations:FindFirstChild("Gate_BC")
	if not gateBC then print("[RoomB ERROR] Gate_BC not found!") return end

	local leafL = gateBC:FindFirstChild("DoorLeaf_L")
	local leafR = gateBC:FindFirstChild("DoorLeaf_R")
	if not leafL or not leafR then print("[RoomB ERROR] Room C door assembly not found") return end

	-- Gate BC opens after Skeli + Green are defeated.
	-- Do NOT write Script.Source at runtime (PluginSecurity).
	-- Do NOT wait for Humanoid.Died — custom golem rigs have no Humanoid.
	-- TrialChamberGolemController owns the primary open call; this is a backup poller.
	_G.SkeliDefeated = false
	_G.GreenDefeated = false
	_G.GateBCOpened = false
	local doorOpened = false

	local function openDoor()
		if doorOpened or _G.GateBCOpened then return end
		doorOpened = true
		_G.GateBCOpened = true
		print("[RoomB] ALL GOLEMS DEFEATED. OPENING GATE BC.")

		local startL = leafL:GetPivot()
		local startR = leafR:GetPivot()
		local targetL = CFrame.new(startL.Position + Vector3.new(-14, 0, 0)) * startL.Rotation
		local targetR = CFrame.new(startR.Position + Vector3.new(14, 0, 0)) * startR.Rotation
		local tweenInfo = TweenInfo.new(2.5, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out)

		local cframeValL = Instance.new("CFrameValue")
		cframeValL.Value = startL
		cframeValL.Changed:Connect(function()
			leafL:PivotTo(cframeValL.Value)
		end)

		local cframeValR = Instance.new("CFrameValue")
		cframeValR.Value = startR
		cframeValR.Changed:Connect(function()
			leafR:PivotTo(cframeValR.Value)
		end)

		local TweenService = game:GetService("TweenService")
		TweenService:Create(cframeValL, tweenInfo, { Value = targetL }):Play()
		TweenService:Create(cframeValR, tweenInfo, { Value = targetR }):Play()
	end

	task.spawn(function()
		while gateBC.Parent and not doorOpened do
			if _G.SkeliDefeated and _G.GreenDefeated then
				openDoor()
				break
			end
			task.wait(0.5)
		end
	end)
end

local function runTrapDamageLogic()
	local spikeDebounce = {}
	local bladeDebounce = {}

	local function onSpikeTouch(hit)
		local char = hit:FindFirstAncestorOfClass("Model")
		if not char then return end
		local humanoid = char:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then return end

		local playerId = char.Name
		if spikeDebounce[playerId] and os.clock() - spikeDebounce[playerId] < 1.0 then return end
		spikeDebounce[playerId] = os.clock()

		-- Deal exactly 50% max health damage (two hits = death)
		humanoid:TakeDamage(humanoid.MaxHealth * 0.5)
	end

	local function onBladeTouch(hit)
		local char = hit:FindFirstAncestorOfClass("Model")
		if not char then return end
		local humanoid = char:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then return end

		local playerId = char.Name
		if bladeDebounce[playerId] and os.clock() - bladeDebounce[playerId] < 0.5 then return end
		bladeDebounce[playerId] = os.clock()

		-- Instant death
		humanoid.Health = 0
	end

	-- Connect spike traps
	for _, trap in ipairs(CollectionService:GetTagged("SpikeTrap")) do
		local spikeBed = trap:FindFirstChild("SpikeBed")
		if spikeBed then
			for _, part in ipairs(spikeBed:GetDescendants()) do
				if part:IsA("BasePart") and string.sub(part.Name, 1, 6) == "Spike_" then
					part.Touched:Connect(onSpikeTouch)
				end
			end
		end
	end

	-- Connect swinging blades
	for _, blade in ipairs(CollectionService:GetTagged("SwingingBlade")) do
		local pivot = blade:FindFirstChild("Pivot")
		if pivot then
			for _, part in ipairs(pivot:GetDescendants()) do
				if part:IsA("BasePart") and (part.Name == "BladeDisc" or string.sub(part.Name, 1, 11) == "BladeTooth_") then
					part.Touched:Connect(onBladeTouch)
				end
			end
		end
	end

	print("[TrapDamageController] All spike and blade damage hooks connected.")
end

local function setupTrapDamage(root)
	print("Setting up Trap Damage Controller...")

	-- Embedded script source for Studio play-testing (runs as a proper server Script)
	local sourceCode = [[
		local CollectionService = game:GetService("CollectionService")

		local spikeDebounce = {}
		local bladeDebounce = {}

		local function onSpikeTouch(hit)
