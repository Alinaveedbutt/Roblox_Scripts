local MountainEnclosure = {}

function MountainEnclosure.build(parent)
	local folder = GeometryCore.newFolder(parent, "ExteriorAdditions")
	local rng = Random.new(770055)
	local terrain = workspace.Terrain

	-- ================================================================
	-- A. Room D Instant Death Kill Volume (preserved from prior system)
	-- ================================================================
	local rDef = MapManager.rooms.RoomD
	local killVol = Instance.new("Part")
	killVol.Name = "RoomD_InstantDeath"
	killVol.Size = Vector3.new(rDef.chasmWidth + 300, 20, rDef.chasmLength + 300)
	killVol.CFrame = CFrame.new(rDef.position.X, rDef.position.Y - rDef.depthBelow + 15, rDef.position.Z)
	killVol.Anchored = true
	killVol.CanCollide = false
	killVol.CanTouch = true
	killVol.Transparency = 1
	killVol.Parent = folder

	killVol.Touched:Connect(function(hit)
		local character = hit:FindFirstAncestorOfClass("Model")
		if not character then return end
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.Health = 0
		end
	end)

	-- ================================================================
	-- B. Clear terrain (Removing mountains for Phase 2 focus)
	-- ================================================================
	print("Clearing terrain for Room D focus... (SKIPPED to preserve user world)")
	-- terrain:Clear()

	-- ================================================================
	-- F. Room B Partially Collapsed Roof (~40% remaining)
	-- Create irregular ancient stone roof pieces over Room B.
	-- Approximately 40% coverage with weathered, broken edges.
	-- ================================================================
	local roomBPos = MapManager.rooms.RoomB.position
	local roomBR = MapManager.rooms.RoomB.radius
	local roomBAp = roomBR * math.cos(math.pi / 8)
	local roofY_B = roomBPos.Y + 24 -- Room B wall height
	local roofRng = Random.new(55443)
	local roofFolder_B = GeometryCore.newFolder(folder, "RoomB_PartialRoof")

	-- Withered Stone-Brick Roof
	local roofGridSize = 6
	local roofThickness = 3
	for rx = -roomBAp, roomBAp - 1, roofGridSize do
		for rz = roomBPos.Z - roomBAp, roomBPos.Z + roomBAp - 1, roofGridSize do
			local localX = math.abs(rx)
			local localZ = math.abs(rz - roomBPos.Z)

			-- Check if within octagonal footprint
			if (localX + localZ) < (roomBAp * 1.35) and localX < roomBAp and localZ < roomBAp then

				-- Calculate distance from center to form a natural collapsed hole
				local distFromCenter = math.sqrt(rx^2 + (rz - roomBPos.Z)^2)
				local normalizedDist = distFromCenter / roomBAp

				-- Higher survival chance near the edges, almost 0 in the center
				local survivalChance = math.clamp(normalizedDist^3 * 1.5, 0, 1)

				if roofRng:NextNumber() < survivalChance then
					-- Place 1 to 3 overlapping jagged stone blocks to look like broken masonry
					local numBlocks = roofRng:NextInteger(1, 3)
					for b = 1, numBlocks do
						local bW = roofGridSize * roofRng:NextNumber(0.8, 1.4)
						local bD = roofGridSize * roofRng:NextNumber(0.8, 1.4)
						local bH = roofThickness * roofRng:NextNumber(0.7, 1.2)

						local offsetX = roofRng:NextNumber(-2, 2)
						local offsetZ = roofRng:NextNumber(-2, 2)
						local offsetY = roofRng:NextNumber(-0.5, 0.5)

						local tiltX = math.rad(roofRng:NextNumber(-5, 5))
						local tiltZ = math.rad(roofRng:NextNumber(-5, 5))
						local tiltY = math.rad(roofRng:NextNumber(-15, 15))

						GeometryCore.newPart({
							Name = "RoomB_Roof_Brick",
							Size = Vector3.new(bW, bH, bD),
							CFrame = CFrame.new(rx + roofGridSize/2 + offsetX, roofY_B + bH/2 + offsetY, rz + roofGridSize/2 + offsetZ) * CFrame.Angles(tiltX, tiltY, tiltZ),
							Material = Enum.Material.Cobblestone,
							Color = Color3.fromRGB(80, 82, 85), -- Stone brick color
							Parent = roofFolder_B
						}, "structural")
					end

					-- Occasional hanging rubble / broken support beams
					if roofRng:NextNumber() > 0.7 then
						local isBeam = roofRng:NextNumber() > 0.5
						if isBeam then
							-- Broken wooden/stone support beam sticking out
							GeometryCore.newPart({
								Name = "RoomB_Roof_Beam",
								Size = Vector3.new(1.5, 8, 1.5),
								CFrame = CFrame.new(rx + roofGridSize/2, roofY_B - 2, rz + roofGridSize/2) * CFrame.Angles(math.rad(roofRng:NextNumber(20, 70)), math.rad(roofRng:NextNumber(0, 360)), 0),
								Material = Enum.Material.Wood,
								Color = Color3.fromRGB(55, 45, 35),
								Parent = roofFolder_B
							}, "visual")
						else
							-- Hanging rubble piece
							local rubbleSize = roofRng:NextNumber(2, 4)
							GeometryCore.newPart({
								Name = "RoomB_Roof_Rubble",
								Size = Vector3.new(rubbleSize, rubbleSize * 0.8, rubbleSize * 1.2),
								CFrame = CFrame.new(rx + roofGridSize/2 + roofRng:NextNumber(-2, 2), roofY_B - rubbleSize, rz + roofGridSize/2 + roofRng:NextNumber(-2, 2)) * CFrame.Angles(math.rad(roofRng:NextNumber(-30, 30)), math.rad(roofRng:NextNumber(0, 360)), math.rad(roofRng:NextNumber(-30, 30))),
								Material = Enum.Material.Cobblestone,
								Color = Color3.fromRGB(75, 75, 78),
								Parent = roofFolder_B
							}, "visual")
						end
					end
				end
			end
		end
	end

	print("Mountain Valley Terrain generation complete.")
	return folder
end

