			spikeDebounce[playerId] = os.clock()

			humanoid:TakeDamage(humanoid.MaxHealth * 0.5)
		end

		local function onBladeTouch(hit)
			local char = hit:FindFirstAncestorOfClass("Model")
			if not char then return end
			local humanoid = char:FindFirstChildOfClass("Humanoid")
			if not humanoid or humanoid.Health <= 0 then return end

			local playerId = char.Name
			if bladeDebounce[playerId] and os.clock() - bladeDebounce[playerId] < 0.5 then return end
			bladeDebounce[playerId] = os.clock()

			humanoid.Health = 0
		end

		for _, trap in ipairs(CollectionService:GetTagged("SpikeTrap")) do
			local spikeBed = trap:FindFirstChild("SpikeBed")
			if spikeBed then
				for _, part in ipairs(spikeBed:GetDescendants()) do
					if part:IsA("BasePart") and string.sub(part.Name, 1, 6) == "Spike_" then
						part.Touched:Connect(onSpikeTouch)
					end
				end
			end
		end

		for _, blade in ipairs(CollectionService:GetTagged("SwingingBlade")) do
			local pivot = blade:FindFirstChild("Pivot")
			if pivot then
				for _, part in ipairs(pivot:GetDescendants()) do
					if part:IsA("BasePart") and (part.Name == "BladeDisc" or string.sub(part.Name, 1, 11) == "BladeTooth_") then
						part.Touched:Connect(onBladeTouch)
					end
				end
			end
		end

		print("[TrapDamageController] All spike and blade damage hooks connected.")
	]]

	local trapScript = Instance.new("Script")
	trapScript.Name = "TrapDamageController"

	local canSetSource = pcall(function()
		trapScript.Source = sourceCode
	end)

	-- Fallback: if Script.Source can't be set (Command Bar execution),
	-- run the damage logic directly in this thread instead.
	if not canSetSource then
		task.spawn(runTrapDamageLogic)
	end

	trapScript.Parent = root
end

local function generateTrialChamberV5()

	print("TrialChamberV5 Generator (Stage 1A, 1B, 1C) starting...")

	local targetName = "TrialChamberGeneratedV5_Sky"
	local targetCFrame = CFrame.new(3284.401, 86.342, 154.123)

	local existingModel = workspace:FindFirstChild(targetName)
	if existingModel then
		-- Preserve the exact manual positioning (and rotation) the user set
		targetCFrame = existingModel:GetPivot()
		existingModel:Destroy()
	end

	MapManager.init()

	local root = Instance.new("Model")
	root.Name = targetName
	root.Parent = workspace

	print("Building Forecourt & Phase 1A Structural Shells...")
	EntryForecourt.build(root)
	RoomA.build(root)

	print("Building Clearance Chamber & Transitions...")
	ClearanceChamber.build(root)
	Collapse.buildAll(root)

	print("Building Room B...")
	RoomB.build(root)

	print("Building Room C (The Heart Chamber)...")
	RoomC.build(root)

	print("Building Room C -> D Transition (The Gate)...")
	TransitionCD.build(root)

	print("Building Room D (The Ancient Chasm)...")
	RoomD.build(root)

	print("Building Room A Visuals & 5-Zone Hazards...")
	RoomA_VisualPass.build(root)

	print("Building Mountain Enclosure...")
	MountainEnclosure.build(root)

	print("--- Navigation Validation ---")
	Validation.run()
	print("--- Validation Complete ---")

	print("Starting blade animations...")
	animateSwingingBlades()

	print("Setting up Gate animations...")
	setupGateABAnimation(root)
	setupGateBCAnimation(root)

	setupTrapDamage(root)

	-- Move the entire generated structure to its permanent world location (preserving rotation if any)
	-- The original pivot of the generated model is implicitly near (0,0,0), so this smoothly places it at the targetCFrame.
	root:PivotTo(targetCFrame)
	print(targetName .. " Generation complete!")
	print("Total BaseParts:", GeometryCore.partCount.total)
	print("Structural Parts:", GeometryCore.partCount.structural)
	print("Grounding Parts:", GeometryCore.partCount.grounding)
	print("Visual Parts:", GeometryCore.partCount.visual)
end

local function setupLighting()
	local lighting = game:GetService("Lighting")

	-- Increased ambient illumination (~20-30%) to lift deep shadows 
	-- while preserving the cool, ancient stone atmosphere.
	lighting.Ambient = Color3.fromRGB(45, 50, 60)
	lighting.OutdoorAmbient = Color3.fromRGB(35, 40, 50)
	lighting.Brightness = 1.2
	lighting.GlobalShadows = true

	-- Removed negative exposure compensation that was artificially darkening the entire scene.
	lighting.ExposureCompensation = 0.0

	local cc = lighting:FindFirstChild("TrialColorCorrection")
	if not cc then
		cc = Instance.new("ColorCorrectionEffect")
		cc.Name = "TrialColorCorrection"
		cc.Parent = lighting
	end
	cc.Contrast = 0.12 -- Slightly reduced contrast so shadows don't crush
	cc.Brightness = 0.0 -- Removed artificial darkening
	cc.Saturation = -0.1
	cc.TintColor = Color3.fromRGB(250, 250, 245) 
end

