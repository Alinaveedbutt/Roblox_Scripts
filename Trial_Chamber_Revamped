			Material = Enum.Material.Metal, Color = Color3.fromRGB(25, 25, 30), Parent = decorFolder
		}, "structural")
		GeometryCore.newPart({
			Name = "CapR_" .. i, Size = Vector3.new(3.2, 1.5, 3.2),
			CFrame = CFrame.new(aPos + right * 4.5 + Vector3.new(0, pillarH + 0.75, 0)),
			Material = Enum.Material.Metal, Color = Color3.fromRGB(25, 25, 30), Parent = decorFolder
		}, "structural")

		-- Arch lintel
		GeometryCore.newPart({
			Name = "ContainArch_" .. i, Size = Vector3.new(11, 3, 2.5),
			CFrame = CFrame.fromMatrix(aPos + Vector3.new(0, pillarH + 2, 0), right, Vector3.yAxis),
			Material = pMat, Color = pCol, Parent = decorFolder
		}, "structural")

		-- Central Arch Eye / Jewel
		GeometryCore.newPart({
			Name = "ArchEye_" .. i, Size = Vector3.new(1.8, 1.8, 1.8),
			CFrame = CFrame.new(aPos + Vector3.new(0, pillarH + 2, 0) + fwd * 1.25) * CFrame.Angles(math.pi/4, 0, math.pi/4),
			Material = Enum.Material.Neon, Color = Color3.fromRGB(255, 40, 40), Parent = decorFolder
		}, "decorative")
	end

	-- Chain building helper for realistic 3D interlocking links with sag
	local function buildRealisticChain(parentName, p1, p2, sag, isRed)
		local linkFolder = GeometryCore.newFolder(decorFolder, parentName)
		-- Tagged so the heart-pickup sequence can find and drop every
		-- containment chain later without needing a direct reference.
		CollectionService:AddTag(linkFolder, "RoomC_ContainmentChain")
		local dist = (p2 - p1).Magnitude
		local linkLength = 1.6
		local linkWidth = 0.8
		local thick = 0.25
		local numLinks = math.max(2, math.floor(dist / (linkLength * 0.75)))

		local mat = isRed and Enum.Material.Neon or Enum.Material.Metal
		local col = isRed and Color3.fromRGB(220, 20, 20) or Color3.fromRGB(20, 20, 25)

		for L = 0, numLinks - 1 do
			local t0 = L / numLinks
			local t1 = (L + 1) / numLinks
			local tMid = (L + 0.5) / numLinks

			local function getPos(t)
				local lerpP = p1:Lerp(p2, t)
				local sagOff = sag * 4 * t * (1 - t)
				return lerpP - Vector3.new(0, sagOff, 0)
			end

			local pos0 = getPos(t0)
			local pos1 = getPos(t1)
			local posMid = getPos(tMid)

			local cframe = CFrame.new(posMid, pos1) * CFrame.Angles(0, 0, (L % 2 == 0) and math.pi/2 or 0)

			local sideDist = (linkWidth - thick)/2
			local endDist = (linkLength - thick)/2
			local actualLen = (pos1 - pos0).Magnitude + thick

			-- 4 Parts per link, welded together into one rigid body so the
			-- link falls as a single chunk instead of exploding into slivers.
			local sideA = GeometryCore.newPart({Name="SideA", Size=Vector3.new(thick, thick, actualLen - thick), CFrame=cframe * CFrame.new(sideDist, 0, 0), Material=mat, Color=col, Parent=linkFolder}, "decorative")
			local sideB = GeometryCore.newPart({Name="SideB", Size=Vector3.new(thick, thick, actualLen - thick), CFrame=cframe * CFrame.new(-sideDist, 0, 0), Material=mat, Color=col, Parent=linkFolder}, "decorative")
			local endA = GeometryCore.newPart({Name="EndA", Size=Vector3.new(linkWidth, thick, thick), CFrame=cframe * CFrame.new(0, 0, endDist), Material=mat, Color=col, Parent=linkFolder}, "decorative")
			local endB = GeometryCore.newPart({Name="EndB", Size=Vector3.new(linkWidth, thick, thick), CFrame=cframe * CFrame.new(0, 0, -endDist), Material=mat, Color=col, Parent=linkFolder}, "decorative")

			for _, otherPart in ipairs({sideB, endA, endB}) do
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = sideA
				weld.Part1 = otherPart
				weld.Parent = sideA
			end
		end
	end

	-- Chains & Tethers connecting the array and restraining the Heart
	for i = 1, numArches do
		local curr = archPositions[i]
		local nxt = archPositions[(i % numArches) + 1]

		-- Chain connecting adjacent arches
		local p1 = curr.pos + curr.right * 4.5 + Vector3.new(0, 16, 0)
		local p2 = nxt.pos - nxt.right * 4.5 + Vector3.new(0, 16, 0)
		buildRealisticChain("HeavyChain_" .. i, p1, p2, 2.5, false)

		-- Heavy iron chain aiming at the Heart Crystal (with deeper sag)
		local tetherStart = curr.pos + Vector3.new(0, 19, 0)
		buildRealisticChain("RestrainingChain_" .. i, tetherStart, heartCenter, 5.0, false)
	end

	------------------------------------------------------------------------
	-- 16-SIDED OUTER WALLS (With Gap Fillers)
	------------------------------------------------------------------------
	for i = 0, numSides - 1 do
		local angle = i * angleStep
		local dirX = math.sin(angle)
		local dirZ = math.cos(angle)

		local wallCenter = pos + Vector3.new(dirX * ap, 0, dirZ * ap)
		local fwd = Vector3.new(-dirX, 0, -dirZ)
		local right = GeometryCore.getRight(fwd)

		local p1 = wallCenter - right * (sl / 2)
		local p2 = wallCenter + right * (sl / 2)

		if i == 0 then
			Masonry.buildIntegratedArch(wallFolder, "WallSegment_North_Exit", p1, p2, height, t, 14, 19, MAT.wall, COLOR.wall)
		elseif i == 8 then
			Masonry.buildIntegratedArch(wallFolder, "WallSegment_South_Entry", p1, p2, height, t, 14, 19, MAT.wall, COLOR.wall)
		else
			Masonry.buildWallCourse(wallFolder, "WallSegment_" .. i, p1, p2, height, t, MAT.wall, COLOR.wall)
		end
		Masonry.buildPilaster(wallFolder, "Pilaster_" .. i, p1, fwd, 4, height, 2)

		-- Gap Filler: A column exactly at the vertex connecting to the next wall segment
		GeometryCore.newPart({
			Name = "WallSeamFiller_" .. i,
			Size = Vector3.new(t * 1.05, height, t * 1.05), Shape = Enum.PartType.Cylinder,
			CFrame = CFrame.new(p2 + Vector3.new(0, height/2, 0)) * CFrame.Angles(0, 0, math.pi/2),
			Material = MAT.wall, Color = COLOR.wall, Parent = wallFolder
		}, "structural")
	end

	------------------------------------------------------------------------
	-- WALL DECORATIONS (vines, moss, torches, banners, scary writings)
	------------------------------------------------------------------------
	local rng = Random.new(99887)
	for i = 0, numSides - 1 do
		local angle = i * angleStep
		local dirX = math.sin(angle)
		local dirZ = math.cos(angle)
		local wallCenter = pos + Vector3.new(dirX * ap, 0, dirZ * ap)
		local fwd = Vector3.new(-dirX, 0, -dirZ)
		local right = GeometryCore.getRight(fwd)

		-- Torches on alternating walls
		if i % 2 ~= 0 then
			local torchPos = pos + Vector3.new(dirX * (ap - t / 2 - 0.5), 14, dirZ * (ap - t / 2 - 0.5))
			local tf = GeometryCore.newFolder(decorFolder, "Torch_" .. i)
			GeometryCore.newPart({ Name = "Sconce", Size = Vector3.new(1, 2, 1), CFrame = CFrame.new(torchPos), Material = Enum.Material.Wood, Color = Color3.fromRGB(60, 40, 20), Parent = tf })
			GeometryCore.newPart({ Name = "SconceBase", Size = Vector3.new(1.5, 0.5, 1.5), CFrame = CFrame.new(torchPos - Vector3.new(0, 1, 0)), Material = Enum.Material.Metal, Color = Color3.fromRGB(30, 30, 30), Parent = tf })
			local flame = GeometryCore.newPart({ Name = "Flame", Size = Vector3.new(0.5, 0.5, 0.5), CFrame = CFrame.new(torchPos + Vector3.new(0, 1.5, 0)), Material = Enum.Material.Neon, Color = Color3.fromRGB(255, 150, 50), Parent = tf })
			local tl = Instance.new("PointLight")
			tl.Color = Color3.fromRGB(255, 160, 80); tl.Range = 25; tl.Brightness = 2; tl.Shadows = false; tl.Parent = flame
		end

		-- Skip gate walls for moss/vines
		if i ~= 0 and i ~= 8 then
			-- Moss at wall base
			GeometryCore.newPart({
				Name = "WallMoss_" .. i, Size = Vector3.new(sl - 2, 1.5, 3),
				CFrame = CFrame.fromMatrix(wallCenter + Vector3.new(0, -0.2, 0) + fwd * 2, right, Vector3.yAxis),
				Material = Enum.Material.Grass, Color = Color3.fromRGB(40, 80, 35),
				CanCollide = false, Parent = decorFolder
			}, "decorative")

			-- Hanging vines
			local numVines = 3 + rng:NextInteger(0, 2)
			for v = 1, numVines do
				local vineX = (rng:NextNumber() - 0.5) * (sl - 4)
				local vineLen = 6 + rng:NextNumber() * 10
				local vineY = height - 2 - vineLen / 2 + rng:NextNumber() * 3
				GeometryCore.newPart({
					Name = "Vine_" .. i .. "_" .. v,
					Size = Vector3.new(0.7, vineLen, 0.7),
					CFrame = CFrame.fromMatrix(
						wallCenter + Vector3.new(0, vineY, 0) + fwd * (t / 2 + 0.3) + right * vineX,
						right, Vector3.yAxis
					),
					Material = Enum.Material.LeafyGrass, Color = Color3.fromRGB(35, 80, 30),
					CanCollide = false, Parent = decorFolder
				}, "decorative")
			end
		end
	end

	------------------------------------------------------------------------
	-- ROOF: Black stone dome with circular oculus above the Heart
	------------------------------------------------------------------------
	local roofFolder = GeometryCore.newFolder(folder, "Roof")
	local roofY = pos.Y + height
	local roofColor = Color3.fromRGB(18, 18, 22) -- Very dark, almost black
	local roofMat = Enum.Material.Basalt

	-- Build the roof as radial slabs with a hole in the center
	local oculusRadius = 10 -- The circular opening
	local roofSegments = 24
	local roofInnerR = oculusRadius
	local roofOuterR = ap + 6 -- Extend past walls to prevent light leaks

	for i = 0, roofSegments - 1 do
		local a1 = i * (math.pi * 2) / roofSegments
		local a2 = (i + 1) * (math.pi * 2) / roofSegments
		local aMid = (a1 + a2) / 2

		local midDirX = math.sin(aMid)
		local midDirZ = math.cos(aMid)
		local segFwd = Vector3.new(-midDirX, 0, -midDirZ)
		local segRight = GeometryCore.getRight(segFwd)

		-- Each slab spans from oculusRadius to roofOuterR
		local slabDepth = roofOuterR - roofInnerR
		local slabCenter = pos + Vector3.new(
			midDirX * (roofInnerR + slabDepth / 2),
			height + 1,
			midDirZ * (roofInnerR + slabDepth / 2)
		)
		-- Width of the slab at the outer edge (arc length)
		local slabWidth = 2 * roofOuterR * math.sin(math.pi / roofSegments) + 1.5

		GeometryCore.newPart({
			Name = "RoofSlab_" .. i,
			Size = Vector3.new(slabWidth, 3, slabDepth),
			CFrame = CFrame.fromMatrix(slabCenter, segRight, Vector3.yAxis),
			Material = roofMat, Color = roofColor, Parent = roofFolder
		}, "structural")
	end

	-- Oculus rim (decorative stone ring around the opening)
	local rimParts = 24
	for i = 0, rimParts - 1 do
		local a = i * (math.pi * 2) / rimParts
		local dx = math.sin(a) * oculusRadius
		local dz = math.cos(a) * oculusRadius
		local segFwd = Vector3.new(-math.sin(a), 0, -math.cos(a))
		local segRight = GeometryCore.getRight(segFwd)
		local arcLen = 2 * oculusRadius * math.pi / rimParts + 0.5

		GeometryCore.newPart({
			Name = "OculusRim_" .. i,
			Size = Vector3.new(arcLen, 4, 2.5),
			CFrame = CFrame.fromMatrix(
				pos + Vector3.new(dx, height + 1, dz),
				segRight, Vector3.yAxis
			),
			Material = Enum.Material.Slate, Color = Color3.fromRGB(30, 30, 35), Parent = roofFolder
		}, "structural")
	end

	-- Golden light beam pouring down through the oculus onto the crystal
	local beam = GeometryCore.newPart({
		Name = "OculusLightBeam",
		Size = Vector3.new(oculusRadius * 1.6, height + 2, oculusRadius * 1.6),
		Shape = Enum.PartType.Cylinder,
		CFrame = CFrame.new(pos + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(255, 220, 120),
		Transparency = 0.92,
		CanCollide = false,
		Parent = roofFolder
	}, "decorative")

	-- SpotLight shining down through the oculus
	local oculusLight = Instance.new("SpotLight")
	oculusLight.Color = Color3.fromRGB(255, 230, 160)
	oculusLight.Range = 80
	oculusLight.Brightness = 8
	oculusLight.Angle = 55
	oculusLight.Face = Enum.NormalId.Bottom
	oculusLight.Shadows = true

	local oculusLightAnchor = GeometryCore.newPart({
		Name = "OculusLightAnchor",
		Size = Vector3.new(2, 1, 2),
		CFrame = CFrame.new(pos + Vector3.new(0, height + 3, 0)),
		Transparency = 1, CanCollide = false,
		Parent = roofFolder
	}, "decorative")
	oculusLight.Parent = oculusLightAnchor

	-- Sky visible through the oculus (bright neon disc above the opening)
	GeometryCore.newPart({
		Name = "SkyDisc",
		Size = Vector3.new(oculusRadius * 2 - 2, 0.5, oculusRadius * 2 - 2),
		Shape = Enum.PartType.Cylinder,
		CFrame = CFrame.new(pos + Vector3.new(0, height + 4, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		Material = Enum.Material.Neon, Color = Color3.fromRGB(200, 220, 255),
		Transparency = 0.3, CanCollide = false, Parent = roofFolder
	}, "decorative")

	-- Starfield on the underside of the roof
	local numStars = 180
	local starRng = Random.new(4242)
	for i = 1, numStars do
		local angle = starRng:NextNumber(0, math.pi * 2)
		local dist = starRng:NextNumber(oculusRadius + 1, roofOuterR - 2)
		local sx = math.sin(angle) * dist
		local sz = math.cos(angle) * dist
		local sSize = starRng:NextNumber(0.2, 0.8)

		local isBright = starRng:NextNumber() > 0.85
		local starColor = isBright and Color3.fromRGB(200, 230, 255) or Color3.fromRGB(255, 255, 255)

		GeometryCore.newPart({
			Name = "RoofStar_" .. i,
			Size = Vector3.new(sSize, 0.2, sSize),
			CFrame = CFrame.new(pos + Vector3.new(sx, height - 0.45, sz)) * CFrame.Angles(0, starRng:NextNumber(0, math.pi), 0),
			Material = Enum.Material.Neon, 
			Color = starColor,
			Transparency = isBright and 0.1 or 0.4,
			CanCollide = false, Parent = roofFolder
		}, "decorative")
	end

	------------------------------------------------------------------------
	-- DYNAMIC ROOM LIGHTING CONTROLLER
	------------------------------------------------------------------------
	local function runLightingController(roomCenter, radius)
		local runService = game:GetService("RunService")
		local lighting = game:GetService("Lighting")
		local tweenService = game:GetService("TweenService")

		local inRoom = false
		local defaultAmbient = lighting.Ambient
		local defaultOutdoor = lighting.OutdoorAmbient
		local dimAmbient = Color3.fromRGB(10, 10, 15)
		local dimOutdoor = Color3.fromRGB(15, 15, 20)

		runService.Heartbeat:Connect(function()
			local isSomeoneInRoom = false
			for _, player in ipairs(game.Players:GetPlayers()) do
				if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
					local dist = (player.Character.HumanoidRootPart.Position - roomCenter).Magnitude
					if dist < radius then
						isSomeoneInRoom = true
						break
					end
				end
			end

			if isSomeoneInRoom and not inRoom then
				inRoom = true
				tweenService:Create(lighting, TweenInfo.new(1.5), {
					Ambient = dimAmbient,
					OutdoorAmbient = dimOutdoor
				}):Play()
			elseif not isSomeoneInRoom and inRoom then
				inRoom = false
				tweenService:Create(lighting, TweenInfo.new(1.5), {
					Ambient = defaultAmbient,
					OutdoorAmbient = defaultOutdoor
				}):Play()
			end
		end)
	end

	local lightingScript = Instance.new("Script")
	lightingScript.Name = "RoomCLightingController"
	local lightingSource = [[
		local roomCenter = script.Parent.StructuralFloor.Floor_SquareBase.Position
		local radius = ]] .. tostring(R + 25) .. [[
		
		local runService = game:GetService("RunService")
		local lighting = game:GetService("Lighting")
		local tweenService = game:GetService("TweenService")
		
		local inRoom = false
		local defaultAmbient = lighting.Ambient
		local defaultOutdoor = lighting.OutdoorAmbient
		local dimAmbient = Color3.fromRGB(10, 10, 15)
		local dimOutdoor = Color3.fromRGB(15, 15, 20)
		
		runService.Heartbeat:Connect(function()
			local isSomeoneInRoom = false
			for _, player in ipairs(game.Players:GetPlayers()) do
				if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
					local dist = (player.Character.HumanoidRootPart.Position - roomCenter).Magnitude
					if dist < radius then
						isSomeoneInRoom = true
						break
					end
				end
			end
			
			if isSomeoneInRoom and not inRoom then
				inRoom = true
				tweenService:Create(lighting, TweenInfo.new(1.5), {
					Ambient = dimAmbient,
					OutdoorAmbient = dimOutdoor
				}):Play()
			elseif not isSomeoneInRoom and inRoom then
				inRoom = false
				tweenService:Create(lighting, TweenInfo.new(1.5), {
					Ambient = defaultAmbient,
					OutdoorAmbient = defaultOutdoor
				}):Play()
			end
		end)
	]]

	local canSetLightingSource = pcall(function()
		lightingScript.Source = lightingSource
	end)

	if not canSetLightingSource then
		task.spawn(function()
			runLightingController(folder.StructuralFloor.Floor_SquareBase.Position, R + 25)
		end)
	end

	lightingScript.Parent = folder

	return folder
end

local Collapse = {}

function Collapse.buildCorridor(parent, name, zStart, yStart, zEnd, yEnd, widthStart, widthEnd)
	local folder = GeometryCore.newFolder(parent, name)
	local t = 4
	local length = zEnd - zStart
	local zCenter = (zStart + zEnd) / 2
	local yCenter = (yStart + yEnd) / 2
	local pos = Vector3.new(0, yCenter, zCenter)
	local floorWidth = (widthStart + widthEnd) / 2

	local numSteps = 5
	local stepHeight = (yEnd - yStart) / numSteps
	local stepLength = 2  -- 2 studs per step

	for i = 1, numSteps do
		local curY = yStart + i * stepHeight
		local curZStart = zStart + (i-1) * stepLength
		GeometryCore.newPart({
			Name = "StairStep_" .. i,
			Size = Vector3.new(floorWidth, curY - yStart, stepLength),
			CFrame = CFrame.new(0, yStart + (curY - yStart)/2, curZStart + stepLength/2),
			Material = MAT.floor, Color = COLOR.floor, Parent = folder
		}, "structural")
	end

	local landingZStart = zStart + numSteps * stepLength
	local landingLength = zEnd - landingZStart
	if landingLength > 0 then
		GeometryCore.newPart({
			Name = "StairLanding",
			Size = Vector3.new(floorWidth, yEnd - yStart, landingLength),
			CFrame = CFrame.new(0, yStart + (yEnd - yStart)/2, landingZStart + landingLength/2),
			Material = MAT.floor, Color = COLOR.floor, Parent = folder
		}, "structural")
	end

	local height = 24

	GeometryCore.newPart({
		Name = "WallL", Size = Vector3.new(t, height, length),
		CFrame = CFrame.new(pos + Vector3.new(-floorWidth/2 - t/2, height/2, 0)),
		Material = MAT.wall, Color = COLOR.wall, Parent = folder
	}, "structural")

	GeometryCore.newPart({
		Name = "WallR", Size = Vector3.new(t, height, length),
		CFrame = CFrame.new(pos + Vector3.new(floorWidth/2 + t/2, height/2, 0)),
		Material = MAT.wall, Color = COLOR.wall, Parent = folder
	}, "structural")

	return folder
end

function Collapse.buildAll(parent)
	local folder = GeometryCore.newFolder(parent, "Transitions")

	-- Transition from Room A to B
	local tAB = MapManager.rooms.TransAB
	Collapse.buildCorridor(folder, "TransAB", tAB.zStart, tAB.yStart, tAB.zEnd, tAB.yEnd, tAB.width, tAB.width)

	-- Transition from Room B to C
	local tBC = MapManager.rooms.TransBC
	local bcFolder = Collapse.buildCorridor(folder, "TransBC", tBC.zStart, tBC.yStart, tBC.zEnd, tBC.yEnd, tBC.width, tBC.width)

	-- Withered/Irregular Ceiling for TransBC
	local ceilY = tBC.yStart + 24
	local ceilLength = tBC.zEnd - tBC.zStart
	local ceilW = tBC.width + 6 -- Overlap the walls
	local rng = Random.new(9988)

	-- Create heavy stone ceiling slabs spanning the corridor with varying deterioration
	for z = tBC.zStart + 2, tBC.zEnd - 2, 5 do
		local gap = rng:NextNumber() < 0.2 -- Occasional 20% chance for a gap/broken slab
		if not gap then
			-- Main slab
			local slabW = ceilW * rng:NextNumber(0.9, 1.1)
			local slabL = rng:NextNumber(4, 7)
			local tiltX = math.rad(rng:NextNumber(-2, 2))
			local tiltZ = math.rad(rng:NextNumber(-1, 1))

			GeometryCore.newPart({
				Name = "TransBCCeiling",
				Size = Vector3.new(slabW, rng:NextNumber(2, 4), slabL),
				CFrame = CFrame.new(0, ceilY + rng:NextNumber(-0.5, 0.5), z) * CFrame.Angles(tiltX, 0, tiltZ),
				Material = Enum.Material.Cobblestone,
				Color = Color3.fromRGB(80, 85, 90),
				Parent = bcFolder
			}, "structural")

			-- Adding dangling stone blocks/rubble beneath it for age
			if rng:NextNumber() > 0.5 then
				local rw = rng:NextNumber(1.5, 3)
				local rx = rng:NextNumber(-tBC.width/2 + 2, tBC.width/2 - 2)
				GeometryCore.newPart({
					Name = "TransBCCeilingRubble",
					Size = Vector3.new(rw, rw*0.8, rw*1.2),
					CFrame = CFrame.new(rx, ceilY - rw/2 - 0.5, z + rng:NextNumber(-1, 1)) * CFrame.Angles(math.rad(rng:NextNumber(0, 360)), 0, math.rad(rng:NextNumber(0, 360))),
					Material = Enum.Material.Cobblestone,
					Color = Color3.fromRGB(75, 78, 82),
					Parent = bcFolder
				}, "visual")
			end
		end
	end

	return folder
end

------------------------------------------------------------------------
-- 8.4 ROOM C -> ROOM D TRANSITION (Architecturally Integrated)
-- Clearing + Ancient Gate connecting Room C north exit to Chasm D.
-- Single-layer floor, walls that extend from Room C's polygon,
-- gate pillars embedded into side walls, zero overlapping geometry.
------------------------------------------------------------------------
local TransitionCD = {}

function TransitionCD.build(parent)
	local folder = GeometryCore.newFolder(parent, "TransitionCD")

	-- Room C geometry reference
	local roomCPos = MapManager.rooms.RoomC.position  -- (0, 15, 480)
	local roomCR = MapManager.rooms.RoomC.radius       -- 50
	local roomCAp = roomCR * math.cos(math.pi / 16)    -- 16-sided apothem ~49.04

	-- Transition geometry constants
	local zStart = 530       -- Where Room C's north wall is
	local zGate = 552        -- Where the gate pillars begin
	local zGateEnd = 564     -- Where the gate ends (12 studs deep)
	local yFloor = 15        -- Match Room C floor exactly
	local clearingHalfW = 18 -- Half-width of the clearing (36 total)
	local wallHeight = 30    -- Match Room C wall height
	local wallT = 4          -- Match Room C wall thickness

	-- Materials (matching existing Trial Chamber palette)
	local matFloor = Enum.Material.Cobblestone
	local colFloor = Color3.fromRGB(80, 95, 75)
	local matWall = Enum.Material.Cobblestone
	local colWall = Color3.fromRGB(75, 80, 72)
	local matStone = Enum.Material.Slate
	local colStone = Color3.fromRGB(85, 80, 75)
	local matPillar = Enum.Material.Cobblestone
	local colPillar = Color3.fromRGB(70, 75, 65)

	-- ================================================================
	-- 1. CLEARING FLOOR (Single layer, no overlaps)
	-- Top surface at exactly Y=15, 2 studs thick, sits BELOW the
	-- walking surface so the top face is flush with Room C.
	-- ================================================================
	local floorThick = 2
	GeometryCore.newPart({
		Name = "ClearingFloor",
		Size = Vector3.new(clearingHalfW * 2, floorThick, zGateEnd - zStart),
		CFrame = CFrame.new(0, yFloor - floorThick/2, (zStart + zGateEnd)/2),
		Material = matFloor,
		Color = colFloor,
		Parent = folder
	}, "structural")

	-- ================================================================
	-- 2. SIDE WALLS (Extending from Room C's polygon into the clearing)
	-- These walls connect flush to Room C's north wall segments and
	-- continue forward to frame the gate. They are placed at the
	-- outer edge of the clearing, not floating.
	-- ================================================================
	local wallLen = zGateEnd - zStart
	local wallZCenter = (zStart + zGateEnd) / 2

	for side = -1, 1, 2 do
		local wallX = side * (clearingHalfW + wallT/2)

		-- Main continuous wall from Room C exit to gate end
		GeometryCore.newPart({
			Name = side == -1 and "WallL" or "WallR",
			Size = Vector3.new(wallT, wallHeight, wallLen),
			CFrame = CFrame.new(wallX, yFloor + wallHeight/2, wallZCenter),
			Material = matWall,
			Color = colWall,
			Parent = folder
		}, "structural")

		-- Corner pilaster where Room C wall meets the clearing wall
		-- (hides the seam and adds architectural detail)
		GeometryCore.newPart({
			Name = side == -1 and "PilasterL_Entry" or "PilasterR_Entry",
			Size = Vector3.new(wallT + 2, wallHeight, wallT + 2),
			CFrame = CFrame.new(wallX, yFloor + wallHeight/2, zStart),
			Material = matStone,
			Color = colStone,
			Parent = folder
		}, "structural")

		-- Short buttress halfway along the wall (structural detail)
		GeometryCore.newPart({
			Name = side == -1 and "ButtressL" or "ButtressR",
			Size = Vector3.new(3, wallHeight * 0.7, 3),
			CFrame = CFrame.new(wallX + side * 1.5, yFloor + wallHeight * 0.35, (zStart + zGate)/2),
			Material = matWall,
			Color = Color3.fromRGB(72, 77, 69),
			Parent = folder
		}, "structural")

		-- Stone trim strip along the wall base
		GeometryCore.newPart({
			Name = side == -1 and "BaseTrimL" or "BaseTrimR",
			Size = Vector3.new(wallT + 1, 1.5, wallLen),
			CFrame = CFrame.new(wallX, yFloor + 0.75, wallZCenter),
			Material = matStone,
			Color = Color3.fromRGB(68, 65, 60),
			Parent = folder
		}, "visual")
	end

	-- ================================================================
	-- 3. THE ANCIENT COBBLESTONE GATE (Embedded into walls)
	-- Pillars are flush with the inner face of the side walls.
	-- The lintel spans across the top, connecting the walls.
	-- ================================================================
	local gateOpeningW = 24   -- Clear opening the player walks through
	local gateH = 28          -- Gate opening height
	local gateThick = 6       -- Gate depth (front to back)

	-- 3. THE ANCIENT COBBLESTONE GATE
	buildCobblestoneGate(folder, "AncientGate", 0, zGate, yFloor, gateOpeningW, gateH, gateThick)

	-- ================================================================
	-- 3b. GATE FRAME GAP FILLERS (Room C > D only)
	-- buildCobblestoneGate's pillars are 3 studs wide, centered on the
	-- opening, so their outer face lands at +/-(gateOpeningW/2 + 3) =
	-- +/-15. The clearing walls above sit further out with an inner
	-- face at +/-clearingHalfW = +/-18. That leaves a 3-stud sliver
	-- on each side with nothing in it, which is the sky/terrain gap
	-- visible right next to the door frame. These two parts close it
	-- without touching buildCobblestoneGate (which Gate_AB/Gate_BC
	-- also use) or the wall parts above.
	-- ================================================================
	do
		local gatePillarW = 3 -- must match buildCobblestoneGate's internal pillarW
		local columnOuterHalf = gateOpeningW / 2 + gatePillarW -- 15
		local fillerW = clearingHalfW - columnOuterHalf -- 3
		if fillerW > 0.01 then
			for side = -1, 1, 2 do
				local fillerX = side * (columnOuterHalf + fillerW / 2)
				GeometryCore.newPart({
					Name = side == -1 and "GateFrameFillerL" or "GateFrameFillerR",
					Size = Vector3.new(fillerW, wallHeight, wallLen),
					CFrame = CFrame.new(fillerX, yFloor + wallHeight/2, wallZCenter),
					Material = matWall,
					Color = colWall,
					Parent = folder
				}, "structural")
			end
		end
	end

	-- ================================================================
	-- 4. CHASM DROP-OFF (Broken edge beyond the gate)
	-- ================================================================
	-- Rough broken ledge just past the gate
	GeometryCore.newPart({
		Name = "ChasmEdge",
		Size = Vector3.new(gateOpeningW, 3, 4),
		CFrame = CFrame.new(0, yFloor - 1.5, zGateEnd + 2) * CFrame.Angles(0.06, 0, 0),
		Material = matStone,
		Color = colStone,
		Parent = folder
	}, "structural")

	-- Broken stepping stones descending into the void
	GeometryCore.newPart({
		Name = "BrokenStep1",
		Size = Vector3.new(10, 2.5, 5),
		CFrame = CFrame.new(2, yFloor - 9, zGateEnd + 9) * CFrame.Angles(0.12, 0.08, 0.05),
		Material = matFloor, Color = colFloor, Parent = folder
	}, "structural")

	GeometryCore.newPart({
		Name = "BrokenStep2",
		Size = Vector3.new(7, 2, 4),
		CFrame = CFrame.new(-3, yFloor - 20, zGateEnd + 16) * CFrame.Angles(0.18, -0.15, -0.08),
		Material = matFloor, Color = colFloor, Parent = folder
	}, "structural")

	-- ================================================================
	-- 5. FOUNDATION (Below the floor, no overlap with floor surface)
	-- Top of foundation starts at Y = yFloor - floorThick (Y=13),
	-- extends downward 120 studs.
	-- ================================================================
	local foundDepth = 120
	local foundTopY = yFloor - floorThick
	GeometryCore.newPart({
		Name = "ClearingFoundation",
		Size = Vector3.new(clearingHalfW * 2 + wallT * 2 + 4, foundDepth, zGateEnd - zStart + 4),
		CFrame = CFrame.new(0, foundTopY - foundDepth/2, (zStart + zGateEnd)/2),
		Material = Enum.Material.Rock,
		Color = Color3.fromRGB(65, 60, 55),
		Parent = folder
	}, "grounding")

	return folder
end

------------------------------------------------------------------------
-- 8.5 ROOM D (THE ANCIENT CHASM)
------------------------------------------------------------------------
local RoomD = {}

function RoomD.build(parent)
	local rDef = MapManager.rooms.RoomD
	local folder = GeometryCore.newFolder(parent, "RoomD_Chasm")
	local pos = rDef.position

	-- Materials and Colors
	local rockMat = Enum.Material.Rock
	local rockCol = Color3.fromRGB(105, 100, 90)
	local mossCol = Color3.fromRGB(45, 65, 40)
	local floorMat = Enum.Material.Cobblestone
	local floorCol = Color3.fromRGB(80, 95, 75) -- Same as Rooms A,B,C
	local trimMat = Enum.Material.Slate
	local trimCol = Color3.fromRGB(85, 80, 75)
	local abyssCol = Color3.fromRGB(5, 5, 5)

	-- Chain building helper for realistic 3D interlocking links with sag
	local function buildRealisticChain(parentName, p1, p2, sag)
		local linkFolder = GeometryCore.newFolder(folder, parentName)
		local dist = (p2 - p1).Magnitude
		local linkLength = 3.2
		local linkWidth = 1.6
		local thick = 0.5
		local numLinks = math.max(2, math.floor(dist / (linkLength * 0.75)))

		local mat = Enum.Material.Metal
		local col = Color3.fromRGB(20, 20, 25)

		for L = 0, numLinks - 1 do
			local t0 = L / numLinks
			local t1 = (L + 1) / numLinks
			local tMid = (L + 0.5) / numLinks

			local function getPos(t)
				local lerpP = p1:Lerp(p2, t)
				local sagOff = sag * 4 * t * (1 - t)
				return lerpP - Vector3.new(0, sagOff, 0)
			end

			local pos0 = getPos(t0)
			local pos1 = getPos(t1)
			local posMid = getPos(tMid)

			local cframe = CFrame.new(posMid, pos1) * CFrame.Angles(0, 0, (L % 2 == 0) and math.pi/2 or 0)

			local sideDist = (linkWidth - thick)/2
			local endDist = (linkLength - thick)/2
			local actualLen = (pos1 - pos0).Magnitude + thick

			GeometryCore.newPart({Name="SideA", Size=Vector3.new(thick, thick, actualLen - thick), CFrame=cframe * CFrame.new(sideDist, 0, 0), Material=mat, Color=col, Parent=linkFolder}, "decorative")
			GeometryCore.newPart({Name="SideB", Size=Vector3.new(thick, thick, actualLen - thick), CFrame=cframe * CFrame.new(-sideDist, 0, 0), Material=mat, Color=col, Parent=linkFolder}, "decorative")
			GeometryCore.newPart({Name="EndA", Size=Vector3.new(linkWidth, thick, thick), CFrame=cframe * CFrame.new(0, 0, endDist), Material=mat, Color=col, Parent=linkFolder}, "decorative")
			GeometryCore.newPart({Name="EndB", Size=Vector3.new(linkWidth, thick, thick), CFrame=cframe * CFrame.new(0, 0, -endDist), Material=mat, Color=col, Parent=linkFolder}, "decorative")
		end
	end

	------------------------------------------------------------------------
	-- 1. CHASM WALLS & ABYSS (Mountain Look)
	------------------------------------------------------------------------
	local structFolder = GeometryCore.newFolder(folder, "Structural")

	-- The deep abyss floor
	GeometryCore.newPart({
		Name = "AbyssFloor",
		Size = Vector3.new(rDef.chasmWidth + 20, 10, rDef.chasmLength + 20),
		CFrame = CFrame.new(pos.X, pos.Y - rDef.depthBelow, pos.Z),
		Material = Enum.Material.Slate, Color = abyssCol, Parent = structFolder
	}, "structural")

	-- Solid backing walls so the sky doesn't show through
	GeometryCore.newPart({
		Name = "BackWallL", Size = Vector3.new(10, rDef.wallHeight + rDef.depthBelow + 50, rDef.chasmLength + 50),
		CFrame = CFrame.new(pos.X - rDef.chasmWidth/2 - 15, pos.Y + (rDef.wallHeight - rDef.depthBelow)/2, pos.Z),
		Material = rockMat, Color = rockCol, Parent = structFolder
	}, "structural")
	GeometryCore.newPart({
		Name = "BackWallR", Size = Vector3.new(10, rDef.wallHeight + rDef.depthBelow + 50, rDef.chasmLength + 50),
		CFrame = CFrame.new(pos.X + rDef.chasmWidth/2 + 15, pos.Y + (rDef.wallHeight - rDef.depthBelow)/2, pos.Z),
		Material = rockMat, Color = rockCol, Parent = structFolder
	}, "structural")

	-- High-density detailed rock strata
	local stepZ = 14
	local stepY = 14

	for side = -1, 1, 2 do
		for zOffset = 0, rDef.chasmLength, stepZ do
			local curZ = pos.Z - rDef.chasmLength/2 + zOffset
			for yOffset = 0, rDef.wallHeight + rDef.depthBelow, stepY do
				local curY = pos.Y - rDef.depthBelow + yOffset
				local rng = Random.new(math.floor(curZ * 100 + curY))

				-- Use multiple overlapping rocks per grid cell to create high density detail
				local numRocks = rng:NextInteger(2, 4)
				for rock = 1, numRocks do
					local rSize = Vector3.new(rng:NextNumber(15, 30), rng:NextNumber(10, 22), rng:NextNumber(20, 35))
					local depthVar = rng:NextNumber(-2, 10)
					local wX = pos.X + side * (rDef.chasmWidth/2 + depthVar)

					local pType = (rng:NextNumber() > 0.4) and "WedgePart" or "Part"
					local p = Instance.new(pType)
					p.Name = "MountainRock"
					p.Size = rSize
					p.CFrame = CFrame.new(
						wX + rng:NextNumber(-3, 3), 
						curY + rng:NextNumber(-4, 4), 
						curZ + rng:NextNumber(-4, 4)
					) * CFrame.Angles(rng:NextNumber(-0.5, 0.5), rng:NextNumber(0, math.pi), rng:NextNumber(-0.5, 0.5))
					p.Material = rockMat
					p.Color = rockCol
					p.Anchored = true
					p.Parent = structFolder
					GeometryCore.incrementCount("structural")
				end

				-- Massive amount of vines hanging down the walls
				-- Spawning a huge amount everywhere for a very overgrown look
				local numVines = rng:NextInteger(4, 8)
				for v = 1, numVines do
					local vLen = rng:NextNumber(20, 100)
					local vThick = rng:NextNumber(0.8, 3.5)
					GeometryCore.newPart({
						Name = "WallVine", Size = Vector3.new(vThick, vLen, vThick),
						CFrame = CFrame.new(pos.X + side * (rDef.chasmWidth/2 - rng:NextNumber(1, 12)), curY - vLen/2 + rng:NextNumber(-5, 5), curZ + rng:NextNumber(-8, 8)),
						Material = Enum.Material.LeafyGrass, Color = mossCol, CanCollide = false, Parent = structFolder
					}, "decorative")
				end
			end
		end
	end

	------------------------------------------------------------------------
	-- 2. PARKOUR PLATFORMS (Double Jump Spacing)
	------------------------------------------------------------------------
	local parkourFolder = GeometryCore.newFolder(folder, "Parkour")
	local numPlatforms = 16
	local startY = pos.Y
	local endY = pos.Y + 160 -- They climb up 160 studs
	local climbZStart = rDef.zStart + 20
	local climbZEnd = rDef.zEnd - 40

	local prevPos = Vector3.new(0, startY, climbZStart)

	for i = 1, numPlatforms do
		local prng = Random.new(4000 + i)
		local pY = startY + (endY - startY) * (i / numPlatforms)
		local pZ = climbZStart + (climbZEnd - climbZStart) * (i / numPlatforms)

		-- Alternate walls: even = left, odd = right
		local onLeft = (i % 2 == 0)
		-- Pulled platforms further out into the chasm so they are highly visible
		local pX = onLeft and (pos.X - 14) or (pos.X + 14)

		-- Only the first 2 steps are small jumps, the rest are huge double-jump gaps (12-15+ studs)
		if i > 2 then
			pY = prevPos.Y + prng:NextNumber(10, 18)
			pZ = prevPos.Z + prng:NextNumber(12, 18)
		else
			pY = prevPos.Y + 5
			pZ = prevPos.Z + 8
		end

		-- Massive thick platforms to stand out against the rocks
		local pSize = Vector3.new(prng:NextNumber(16, 24), 4, prng:NextNumber(16, 24))
		local platCFrame = CFrame.new(pX, pY, pZ)

		local plat = GeometryCore.newPart({
			Name = "Platform_"..i,
			Size = pSize,
			CFrame = platCFrame,
			Material = floorMat, Color = floorCol, Parent = parkourFolder
		}, "structural")

		-- Add the entrance guide rope at platform 1
		if i == 1 then
			local ropeStart = Vector3.new(pos.X, pos.Y + 20, rDef.zStart) -- Above entrance
			local ropeEnd = platCFrame.Position + Vector3.new(0, 5, 0)
			local ropeVec = ropeEnd - ropeStart
			local ropeDist = ropeVec.Magnitude

			GeometryCore.newPart({
				Name = "GuideRope",
				Size = Vector3.new(0.6, ropeDist, 0.6),
				CFrame = CFrame.new(ropeStart + ropeVec/2, ropeEnd) * CFrame.Angles(math.pi/2, 0, 0),
				Shape = Enum.PartType.Cylinder,
				Material = Enum.Material.Fabric,
				Color = Color3.fromRGB(150, 120, 80),
				Parent = parkourFolder
			}, "decorative")
		end

		-- Platform Edge Ruins (offset 0.15 above platform top to prevent z-fighting)
		GeometryCore.newPart({
			Name = "PlatEdge", Size = Vector3.new(pSize.X+1, 0.8, pSize.Z+1),
			CFrame = platCFrame * CFrame.new(0, 2.55, 0),
			Material = trimMat, Color = rockCol, Parent = parkourFolder
		}, "structural")

		-- Hanging vines under platform
		local numVines = prng:NextInteger(3, 6)
		for v = 1, numVines do
			local vLen = prng:NextNumber(15, 30)
			GeometryCore.newPart({
				Name = "Vine", Size = Vector3.new(1, vLen, 1),
				CFrame = platCFrame * CFrame.new(prng:NextNumber(-pSize.X/2, pSize.X/2), -1.5 - vLen/2, prng:NextNumber(-pSize.Z/2, pSize.Z/2)),
				Material = Enum.Material.LeafyGrass, Color = mossCol, CanCollide = false, Parent = parkourFolder
			}, "decorative")
		end

		prevPos = platCFrame.Position
	end

	------------------------------------------------------------------------
	-- 3. FINAL VIEWING PLATFORM
	------------------------------------------------------------------------
	local endPlatY = prevPos.Y + 12
	local endPlatZ = rDef.zEnd - 10
	local viewingPlat = GeometryCore.newPart({
		Name = "ViewingPlatform",
		Size = Vector3.new(rDef.chasmWidth - 10, 4, 30),
		CFrame = CFrame.new(pos.X, endPlatY, endPlatZ),
		Material = floorMat, Color = floorCol, Parent = parkourFolder
	}, "structural")

	for i = -1, 1 do
		if i ~= 0 then
			GeometryCore.newPart({
				Name = "Pillar",
				Size = Vector3.new(4, 12, 4),
				CFrame = CFrame.new(pos.X + i * 20, endPlatY + 6, endPlatZ + 12),
				Material = trimMat, Color = rockCol, Parent = parkourFolder
			}, "structural")
		end
	end

	------------------------------------------------------------------------
	-- 4. HANGING CHAINS
	------------------------------------------------------------------------
	local decorFolder = GeometryCore.newFolder(folder, "Decorations")
	local numChains = 6
	for i = 1, numChains do
		local cZ = rDef.zStart + 40 + i * 35
		local cY = pos.Y + 80 + (i%3)*30
		local p1 = Vector3.new(pos.X - rDef.chasmWidth/2, cY, cZ)
		local p2 = Vector3.new(pos.X + rDef.chasmWidth/2, cY, cZ)
		buildRealisticChain("Chain_"..i, p1, p2, 15) -- 15 stud sag
	end

	------------------------------------------------------------------------
	-- 5. PARTIALLY COLLAPSED ROOF & SUNLIGHT
	------------------------------------------------------------------------
	local roofFolder = GeometryCore.newFolder(folder, "CollapsedRoof")
	local rng = Random.new(89234)

	local roofY = pos.Y + rDef.wallHeight
	local slabLength = 20
	local numSlabs = math.floor((rDef.chasmLength) / slabLength)

	for i = 0, numSlabs - 1 do
		local sz = rDef.zStart + (i + 0.5) * slabLength

		-- Use seeded random to determine if this section is intact, partially broken, or a major opening
		local stateVal = rng:NextNumber()

		if stateVal > 0.65 and sz > rDef.zStart + 40 and sz < rDef.zEnd - 40 then
			-- MAJOR OPENING
			-- Small side jagged pieces only
			for side = -1, 1, 2 do
				local brokenW = rng:NextNumber(5, 15)
				local rx = pos.X + side * (rDef.chasmWidth/2 - brokenW/2)
				GeometryCore.newPart({
					Name = "JaggedRoof", Size = Vector3.new(brokenW, rng:NextNumber(2, 4), slabLength + rng:NextNumber(-2, 2)),
					CFrame = CFrame.new(rx, roofY, sz) * CFrame.Angles(rng:NextNumber(-0.1, 0.1), 0, rng:NextNumber(-0.1, 0.1)),
					Material = floorMat, Color = rockCol, Parent = roofFolder
				}, "structural")
			end

			-- Sunlight Shafts (Visual Beams)
			-- Soft, dusty golden rays
			local lightWidth = rng:NextNumber(20, 40)
			local shaftFolder = GeometryCore.newFolder(roofFolder, "SunlightShaft_"..i)

			-- Top attachment (in the sky opening)
			local topPart = Instance.new("Part")
			topPart.Name = "BeamTop"
			topPart.Size = Vector3.new(1,1,1)
			topPart.CFrame = CFrame.new(pos.X, roofY, sz)
			topPart.Transparency = 1
			topPart.Anchored = true
			topPart.CanCollide = false
			topPart.Parent = shaftFolder
			local aTop = Instance.new("Attachment", topPart)

			-- Bottom attachment (deep in the chasm)
			local bottomPart = Instance.new("Part")
			bottomPart.Name = "BeamBottom"
			bottomPart.Size = Vector3.new(1,1,1)
			-- slight angle to simulate directional sunlight
			local dirX = rng:NextNumber(-10, 10)
			local dirZ = rng:NextNumber(-10, 10)
			bottomPart.CFrame = CFrame.new(pos.X + dirX, pos.Y - 20, sz + dirZ)
			bottomPart.Transparency = 1
			bottomPart.Anchored = true
			bottomPart.CanCollide = false
			bottomPart.Parent = shaftFolder
			local aBot = Instance.new("Attachment", bottomPart)

			local beam = Instance.new("Beam")
			beam.Attachment0 = aTop
			beam.Attachment1 = aBot
			beam.FaceCamera = true
			beam.Width0 = lightWidth * 0.5
			beam.Width1 = lightWidth * 1.5
			beam.Color = ColorSequence.new(Color3.fromRGB(255, 245, 215)) -- warm golden/cream
			-- Soft transparency: invisible at very top/bottom, semi-transparent in middle
			beam.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.2, 0.85),
				NumberSequenceKeypoint.new(0.8, 0.95),
				NumberSequenceKeypoint.new(1, 1)
			})
			beam.LightEmission = 0.8
			beam.LightInfluence = 0
			beam.Parent = shaftFolder

			-- Cascading Localized Illumination
			-- Place lights every 45 studs vertically to cast light on the walls/platforms
			local numLights = math.floor((roofY - (pos.Y - 50)) / 45)
			for lIdx = 0, numLights do
				local ly = roofY - lIdx * 45
				-- Shift X/Z along the beam path
				local lx = pos.X + (dirX * (lIdx / numLights))
				local lz = sz + (dirZ * (lIdx / numLights))

				local lNode = Instance.new("Part")
				lNode.Name = "LightNode"
				lNode.Size = Vector3.new(1,1,1)
				lNode.CFrame = CFrame.new(lx, ly, lz)
				lNode.Transparency = 1
				lNode.Anchored = true
				lNode.CanCollide = false
				lNode.Parent = shaftFolder

				local pl = Instance.new("PointLight")
				pl.Color = Color3.fromRGB(255, 235, 190)
				-- Fade intensity as it gets deeper
				local depthFactor = 1 - (lIdx / numLights)
				pl.Brightness = 1.5 * depthFactor
				pl.Range = 50
				pl.Shadows = true
				pl.Parent = lNode
			end

		elseif stateVal > 0.35 then
			-- PARTIAL COLLAPSE / CRACKS
			-- Solid on one side, broken on the other, or center hole
			local holeW = rng:NextNumber(10, 25)
			GeometryCore.newPart({
				Name = "RoofSlabL", Size = Vector3.new((rDef.chasmWidth - holeW)/2, rng:NextNumber(3, 5), slabLength),
				CFrame = CFrame.new(pos.X - rDef.chasmWidth/2 + ((rDef.chasmWidth - holeW)/4), roofY, sz),
				Material = floorMat, Color = rockCol, Parent = roofFolder
			}, "structural")
			GeometryCore.newPart({
				Name = "RoofSlabR", Size = Vector3.new((rDef.chasmWidth - holeW)/2, rng:NextNumber(3, 5), slabLength),
				CFrame = CFrame.new(pos.X + rDef.chasmWidth/2 - ((rDef.chasmWidth - holeW)/4), roofY, sz),
				Material = floorMat, Color = rockCol, Parent = roofFolder
			}, "structural")

			-- Subtle light
			local lNode = Instance.new("Part")
			lNode.Size = Vector3.new(1,1,1); lNode.CFrame = CFrame.new(pos.X, roofY - 10, sz); lNode.Transparency = 1; lNode.Anchored = true; lNode.CanCollide = false; lNode.Parent = roofFolder
			local pl = Instance.new("PointLight"); pl.Color = Color3.fromRGB(240, 230, 200); pl.Brightness = 0.5; pl.Range = 40; pl.Parent = lNode
		else
			-- SOLID ROOF
			GeometryCore.newPart({
				Name = "SolidRoofSlab", Size = Vector3.new(rDef.chasmWidth + 10, rng:NextNumber(3, 5), slabLength),
				CFrame = CFrame.new(pos.X, roofY, sz),
				Material = floorMat, Color = rockCol, Parent = roofFolder
			}, "structural")
		end
	end

	------------------------------------------------------------------------
	-- 6. DEEP CHASM AMBIENT LIFT
	------------------------------------------------------------------------
	-- Prevent pitch black abyss without making it bright
	local deepFolder = GeometryCore.newFolder(folder, "DeepAmbient")
	for dz = rDef.zStart + 20, rDef.zEnd - 20, 60 do
		local ambientNode = Instance.new("Part")
		ambientNode.Name = "DeepAmbientNode"
		ambientNode.Size = Vector3.new(1,1,1)
		ambientNode.CFrame = CFrame.new(pos.X, pos.Y - rDef.depthBelow + 30, dz)
		ambientNode.Transparency = 1
		ambientNode.Anchored = true
		ambientNode.CanCollide = false
		ambientNode.Parent = deepFolder

		local pLight = Instance.new("PointLight")
		pLight.Color = Color3.fromRGB(160, 180, 210) -- Cool, moonlit/cave reflection color
		pLight.Brightness = 0.4
		pLight.Range = 60
		pLight.Shadows = false
		pLight.Parent = ambientNode
	end

	return folder
end

