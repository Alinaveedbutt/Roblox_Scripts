-- Prepare Encounter (Spawns all 3 dormant)
function TrialChamberGolemController.StartEncounter()
	print("[ROOM B DEBUG 06] StartEncounter() entered")
	if encounterActive then 
		warn("[ROOM B ERROR] Encounter already active, aborting spawn")
		return 
	end

	local templateFolder = ServerStorage:FindFirstChild("TrialChamberGolems")
	if not templateFolder then
		warn("[ROOM B ERROR] TrialChamberGolems folder NOT FOUND")
		return
	else
		print("[ROOM B DEBUG 07] TrialChamberGolems folder located")
	end

	-- Auto-fix hierarchy if the golems were accidentally placed as siblings in ServerStorage
	for _, name in ipairs({"GreenGolem", "SkeliGolem", "StoneGolem"}) do
		if not templateFolder:FindFirstChild(name) then
			local sibling = ServerStorage:FindFirstChild(name)
			if sibling then
				print("[ROOM B DEBUG] Auto-fixing hierarchy: Moving " .. name .. " into TrialChamberGolems folder.")
				sibling.Parent = templateFolder
			end
		end
	end

	if templateFolder:FindFirstChild("GreenGolem") then print("[ROOM B DEBUG 08] GreenGolem template located") else warn("[ROOM B ERROR] GreenGolem template NOT FOUND") end
	if templateFolder:FindFirstChild("SkeliGolem") then print("[ROOM B DEBUG 09] SkeliGolem template located") else warn("[ROOM B ERROR] SkeliGolem template NOT FOUND") end
	if templateFolder:FindFirstChild("StoneGolem") then print("[ROOM B DEBUG 10] StoneGolem template located") else warn("[ROOM B ERROR] StoneGolem template NOT FOUND") end

	local activeFolder = Workspace:FindFirstChild("TrialChamberActiveGolems")
	if not activeFolder then
		activeFolder = Instance.new("Folder")
		activeFolder.Name = "TrialChamberActiveGolems"
		activeFolder.Parent = Workspace
	end
	print("[ROOM B DEBUG 11] Active golem container created/found")

	encounterActive = true
	encounterPhase = 0
	TrialChamberGolemController.CleanupAllGolems()

	spawnedGolems.GreenGolem = spawnSingleGolem("GreenGolem", "GreenSpawn", "[ROOM B DEBUG 12] GreenGolem cloned", "[ROOM B DEBUG 13] GreenGolem parented", "[ROOM B DEBUG 14] GreenGolem positioned")
	spawnedGolems.SkeliGolem = spawnSingleGolem("SkeliGolem", "SkeliSpawn", "[ROOM B DEBUG 15] SkeliGolem cloned", "[ROOM B DEBUG 16] SkeliGolem parented", "[ROOM B DEBUG 17] SkeliGolem positioned")
	spawnedGolems.StoneGolem = spawnSingleGolem("StoneGolem", "StoneSpawn", "[ROOM B DEBUG 18] StoneGolem cloned", "[ROOM B DEBUG 19] StoneGolem parented", "[ROOM B DEBUG 20] StoneGolem positioned")

	if spawnedGolems.GreenGolem and spawnedGolems.SkeliGolem and spawnedGolems.StoneGolem then
		print("[ROOM B DEBUG 21] ALL THREE GOLEMS SUCCESSFULLY SPAWNED")

		-- Temporarily disable physical collision between the two Phase 1 golems to prevent them pushing each other
		local greenRoot = spawnedGolems.GreenGolem.PrimaryPart
		local skeliRoot = spawnedGolems.SkeliGolem.PrimaryPart
		if greenRoot and skeliRoot then
			local ncc = Instance.new("NoCollisionConstraint")
			ncc.Part0 = greenRoot
			ncc.Part1 = skeliRoot
			ncc.Parent = greenRoot
		end
	else
		warn("[ROOM B ERROR] One or more golems failed to spawn fully")
	end

	if spawnedGolems.GreenGolem then hookDeathDetection(spawnedGolems.GreenGolem, function() onPhase1GolemDefeated("GreenGolem") end) end
	if spawnedGolems.SkeliGolem then hookDeathDetection(spawnedGolems.SkeliGolem, function() onPhase1GolemDefeated("SkeliGolem") end) end
	if spawnedGolems.StoneGolem then hookDeathDetection(spawnedGolems.StoneGolem, function() onPhase2GolemDefeated() end) end
end

-- Activate Encounter (Phase 1)
function TrialChamberGolemController.ActivateEncounter()
	if encounterPhase >= 1 then return end
	encounterPhase = 1

	print("[ROOM B COMBAT] Phase 1 started")
	activateGolem(spawnedGolems.GreenGolem, "GreenGolem")
	activateGolem(spawnedGolems.SkeliGolem, "SkeliGolem")
	print("[ROOM B COMBAT] StoneGolem remains dormant")
end

-- Activate Phase 2
function TrialChamberGolemController.ActivatePhase2()
	if encounterPhase >= 2 then return end
	encounterPhase = 2

	print("[ROOM B COMBAT] StoneGolem activated")
	activateGolem(spawnedGolems.StoneGolem, "StoneGolem")
end

function TrialChamberGolemController.CompleteEncounter()
	print("[ROOM B COMBAT] Encounter Complete! All golems defeated.")
	encounterActive = false
	encounterPhase = 0
end

-- Expose globally for easy testing via Command Bar or other scripts
_G.TrialChamberGolemController = TrialChamberGolemController


-- =====================================================================
-- LIFECYCLE OBSERVER DIAGNOSTIC
-- =====================================================================
local CollectionService = game:GetService('CollectionService')
local golemLogs = {}
local currentGolemIndex = 0
local observerStarted = false

local function printFinalSummary()
	print('\n=== SEQUENTIAL GOLEM TIMELINE ===')
	for i = 1, 3 do
		local log = golemLogs[i]
		if log then
			print(log.name)
			print('  Spawned:       ' .. log.spawnTimeStr)
			print('  MovementStart: ' .. (log.moveStartTimeStr or 'N/A'))
			print('  WalkStart:     ' .. (log.animStartTimeStr or 'N/A'))
			print('  MovementEnd:   ' .. (log.moveEndTimeStr or 'N/A'))
			print('  WalkStop:      ' .. (log.animEndTimeStr or 'N/A'))
		end
	end

	print('\n=== SEQUENCE CONTROL ===')
	print('Green -> Skeli:')
	print('Trigger = UNKNOWN (No sequence code exists in TrialChamberGolemController or RevampV9. Likely an internal model script.)')
	print('\nSkeli -> Stone:')
	print('Trigger = UNKNOWN (No sequence code exists in TrialChamberGolemController or RevampV9. Likely an internal model script.)')
end

local function observeGolem(golem)
	currentGolemIndex = currentGolemIndex + 1
	local golemId = currentGolemIndex

	local log = {
		id = golemId,
		name = golem.Name,
		spawnTimeStr = string.format('%.3f', tick()),
		moveStartTimeStr = nil,
		animStartTimeStr = nil,
		moveEndTimeStr = nil,
		animEndTimeStr = nil,
		lastPos = nil,
		isMoving = false
	}
	table.insert(golemLogs, log)

	local root = golem:WaitForChild('char1', 5) or golem.PrimaryPart
	if not root then return end
	log.lastPos = root.Position

	local animController = golem:WaitForChild('AnimationController', 5) or golem:WaitForChild('Humanoid', 5)
	local animator = animController and animController:WaitForChild('Animator', 5)

	local function checkMovement()
		local currentPos = root.Position
		local dist = (currentPos - log.lastPos).Magnitude
		if dist > 0.05 then
			if not log.isMoving then
				log.isMoving = true
				log.moveStartTimeStr = string.format('%.3f', tick())
				print('\n=== GOLEM MOVEMENT INITIATED ===')
				print('Golem: ' .. golem.Name)
				print('Timestamp: ' .. log.moveStartTimeStr)
				print('Current Position: ' .. tostring(log.lastPos))
				print('Movement mechanism: EXTERNAL (Not driven by TrialChamberGolemController. Likely internal Script/Tween/Pathfinding)')
			end
		else
			if log.isMoving then
				log.isMoving = false
				log.moveEndTimeStr = string.format('%.3f', tick())
				print('\n=== GOLEM MOVEMENT COMPLETED ===')
				print('Golem: ' .. golem.Name)
				print('Timestamp: ' .. log.moveEndTimeStr)
				print('Final Position: ' .. tostring(currentPos))
				print('Mechanism: EXTERNAL')
			end
		end
		log.lastPos = currentPos
	end

	-- Monitor movement
	root:GetPropertyChangedSignal('Position'):Connect(checkMovement)
	root:GetPropertyChangedSignal('CFrame'):Connect(checkMovement)

	if animator then
		animator.AnimationPlayed:Connect(function(track)
			log.animStartTimeStr = string.format('%.3f', tick())
			print('\n=== ANIMATION PLAYED ===')
			print('Timestamp: ' .. log.animStartTimeStr)
			print('Golem: ' .. golem.Name)
			print('Track: ' .. tostring(track.Animation and track.Animation.AnimationId or 'Unknown'))
			print('Length: ' .. tostring(track.Length))
			print('Speed: ' .. tostring(track.Speed))
			print('TimePosition: ' .. tostring(track.TimePosition))

			track.Stopped:Connect(function()
				log.animEndTimeStr = string.format('%.3f', tick())
				print('\n=== ANIMATION STOPPED ===')
				print('Timestamp: ' .. log.animEndTimeStr)
				print('Golem: ' .. golem.Name)
				print('Track: ' .. tostring(track.Animation and track.Animation.AnimationId or 'Unknown'))
				print('Length: ' .. tostring(track.Length))
				print('Speed: ' .. tostring(track.Speed))
				print('TimePosition: ' .. tostring(track.TimePosition))

				if golemId >= 3 then
					task.spawn(function()
						task.wait(1)
						printFinalSummary()
					end)
				end
			end)
		end)
	end
end

if not observerStarted then
	observerStarted = true
	CollectionService:GetInstanceAddedSignal('Golem'):Connect(observeGolem)
	for _, g in ipairs(CollectionService:GetTagged('Golem')) do
		task.spawn(observeGolem, g)
	end
end
-- =====================================================================

return TrialChamberGolemController
