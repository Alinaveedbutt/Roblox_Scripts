-- Locate Room B and Spawn Points
local function getRoomB()
	local generatedChamber = Workspace:FindFirstChild("TrialChamberGeneratedV5_Sky")
	if not generatedChamber then return nil end
	return generatedChamber:FindFirstChild("RoomB")
end

local function getSpawnPoint(spawnName)
	local roomB = getRoomB()
	if not roomB then return nil end

	local spawnFolder = roomB:FindFirstChild("GolemSpawnPoints")
	if not spawnFolder then return nil end

	return spawnFolder:FindFirstChild(spawnName)
end

local function getGolemTemplate(golemName)
	local templateFolder = ServerStorage:FindFirstChild("TrialChamberGolems")
	if not templateFolder then 
		warn("[ROOM B ERROR] Could not find ServerStorage.TrialChamberGolems!")
		return nil 
	end
	return templateFolder:FindFirstChild(golemName)
end

-- Cleanup Active Golems
function TrialChamberGolemController.CleanupAllGolems()
	for key, golem in pairs(spawnedGolems) do
		if golem then
			golem:Destroy()
		end
		spawnedGolems[key] = nil
	end
	phase1Defeated = { GreenGolem = false, SkeliGolem = false }
end

-- Reset Encounter
function TrialChamberGolemController.ResetEncounter()
	print("[GolemController] Resetting Encounter...")
	encounterActive = false
	encounterPhase = 0
	TrialChamberGolemController.CleanupAllGolems()
end

