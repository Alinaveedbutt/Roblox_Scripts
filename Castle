               mat_wall=mat_stone_dark, collection=castle_col)

    for sign in (-1,1):
        build_tower(f"gate_tower_{'L' if sign<0 else 'R'}",
                    (sign*1.75, -1.95, 0), base_radius=0.6, wall_height=3.4,
                    roof_height=1.7, spire_height=0.6, sides=DEFAULT_SIDES,
